---
import '../styles/global.css';

const redirectParam = Astro.url.searchParams.get('redirect') || '/';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Acesso à Biblioteca | Cadernos de Estudo Acadêmico</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const savedTheme = localStorage.getItem('study_theme') || 'paper';
      const root = document.documentElement;
      root.classList.remove('theme-paper', 'theme-dark', 'theme-oled', 'dark');
      if (savedTheme === 'oled') {
        root.classList.add('dark', 'theme-oled');
      } else if (savedTheme === 'dark') {
        root.classList.add('dark', 'theme-dark');
      } else {
        root.classList.add('theme-paper');
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] transition-colors duration-200 flex flex-col justify-between py-8 px-4 sm:px-6">
    
    <!-- Topo sutil com selo acadêmico -->
    <header class="max-w-md mx-auto w-full text-center space-y-2">
      <span class="sans-ui text-[11px] font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
        Biblioteca Acadêmica Digital
      </span>
      <div class="h-0.5 w-12 bg-[var(--accent)] mx-auto rounded-full"></div>
    </header>

    <!-- Card Central de Login -->
    <main class="max-w-md mx-auto w-full my-auto">
      <div class="p-8 sm:p-10 rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-surface)] shadow-sm space-y-8">
        
        <div class="text-center space-y-2">
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[var(--text-primary)] tracking-tight">
            Autenticação
          </h1>
          <p class="font-serif text-sm text-[var(--text-secondary)] italic">
            Informe suas credenciais para acessar seus cadernos de estudo e materiais didáticos.
          </p>
        </div>

        <!-- Alerta de Erro -->
        <div
          id="error-banner"
          class="hidden p-3.5 rounded-lg border border-red-500/30 bg-red-500/10 text-red-600 dark:text-red-400 text-xs sans-ui text-center leading-relaxed"
          role="alert"
        >
        </div>

        <form id="login-form" class="space-y-5" method="POST" action="/api/login">
          <input type="hidden" name="redirect" id="redirect-input" value={redirectParam} />

          <div class="space-y-1.5">
            <label for="username" class="block sans-ui text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">
              Usuário
            </label>
            <input
              type="text"
              id="username"
              name="username"
              required
              autofocus
              autocomplete="username"
              placeholder="seu.usuario"
              class="sans-ui w-full px-3.5 py-2.5 text-sm rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] hover:border-[var(--border-strong)] focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20 focus:outline-none transition-all shadow-2xs"
            />
          </div>

          <div class="space-y-1.5">
            <label for="password" class="block sans-ui text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">
              Senha
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="sans-ui w-full px-3.5 py-2.5 text-sm rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] hover:border-[var(--border-strong)] focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20 focus:outline-none transition-all shadow-2xs"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="sans-ui w-full py-3 px-4 rounded-lg border border-[var(--accent)] bg-[var(--accent)] hover:opacity-90 text-white dark:text-black font-semibold text-sm transition-all cursor-pointer shadow-xs flex items-center justify-center gap-2 mt-2"
          >
            <span id="submit-text">Entrar na Biblioteca</span>
            <span id="submit-spinner" class="hidden animate-spin">&#9696;</span>
          </button>
        </form>

        <div class="pt-4 border-t border-[var(--border-subtle)] text-center">
          <p class="font-serif text-xs text-[var(--text-muted)] italic">
            Contas são criadas e administradas pelo responsável do sistema.
          </p>
        </div>

      </div>
    </main>

    <!-- Rodapé -->
    <footer class="max-w-md mx-auto w-full text-center sans-ui text-xs text-[var(--text-muted)]">
      Sessão protegida por criptografia com controle de acesso granular.
    </footer>

    <script is:inline>
      const form = document.getElementById('login-form');
      const errorBanner = document.getElementById('error-banner');
      const submitBtn = document.getElementById('submit-btn');
      const submitText = document.getElementById('submit-text');
      const submitSpinner = document.getElementById('submit-spinner');
      const redirectInput = document.getElementById('redirect-input');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        errorBanner?.classList.add('hidden');
        submitBtn?.setAttribute('disabled', 'true');
        submitText.textContent = 'Autenticando...';
        submitSpinner?.classList.remove('hidden');

        const username = form.username.value;
        const password = form.password.value;
        const redirect = redirectInput.value || '/';

        try {
          const res = await fetch('/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            submitText.textContent = 'Sucesso! Redirecionando...';
            window.location.href = redirect;
          } else {
            errorBanner.textContent = data.error || 'Falha na autenticação. Verifique os dados.';
            errorBanner.classList.remove('hidden');
            submitBtn.removeAttribute('disabled');
            submitText.textContent = 'Entrar na Biblioteca';
            submitSpinner.classList.add('hidden');
          }
        } catch (err) {
          errorBanner.textContent = 'Erro de rede ou servidor indisponível. Tente novamente.';
          errorBanner.classList.remove('hidden');
          submitBtn.removeAttribute('disabled');
          submitText.textContent = 'Entrar na Biblioteca';
          submitSpinner.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
