---
import '../styles/global.css';
import HeaderActions from '../components/HeaderActions.astro';
import { loadUserMaterias } from '../data/materias';

const user = Astro.locals.user!;
const userMaterias = loadUserMaterias(user.id);
const maxMb = user.role === 'admin'
  ? parseInt(process.env.MAX_UPLOAD_MB_ADMIN || '100', 10)
  : parseInt(process.env.MAX_UPLOAD_MB_NORMAL || '50', 10);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Gerenciamento de Arquivos e Archive | Biblioteca Acadêmica</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const savedTheme = localStorage.getItem('study_theme') || 'paper';
      const root = document.documentElement;
      root.classList.remove('theme-paper', 'theme-dark', 'theme-oled', 'dark');
      if (savedTheme === 'oled') {
        root.classList.add('dark', 'theme-oled');
      } else if (savedTheme === 'dark') {
        root.classList.add('dark', 'theme-dark');
      } else {
        root.classList.add('theme-paper');
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] transition-colors duration-200 py-10 px-4 sm:px-8">
    <div class="max-w-3xl mx-auto space-y-10">
      
      <!-- Topo de Navegação -->
      <header class="flex items-center justify-between pb-6 border-b border-[var(--border-subtle)]">
        <div class="space-y-1">
          <div class="sans-ui flex items-center gap-2 text-xs">
            <a href="/" class="text-[var(--accent)] hover:underline flex items-center gap-1 font-semibold">
              &larr; Voltar à Biblioteca
            </a>
            <span class="text-[var(--text-muted)]">•</span>
            <span class="text-[var(--text-secondary)] font-mono">Usuário: {user.displayName} ({user.username})</span>
          </div>
          <h1 class="font-serif text-3xl font-bold text-[var(--text-primary)]">
            Upload & Backup de Cadernos
          </h1>
        </div>
        <HeaderActions />
      </header>

      <!-- Mensagens de Feedback Global -->
      <div id="feedback-alert" class="hidden p-4 rounded-xl text-sm sans-ui transition-all" role="alert"></div>

      <!-- SEÇÃO 1: BACKUP E DOWNLOAD -->
      <section class="p-6 sm:p-8 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] space-y-6 shadow-2xs">
        <div class="space-y-1">
          <span class="sans-ui text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
            Exportação Local
          </span>
          <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)]">
            Baixar Archive em ZIP
          </h2>
          <p class="font-serif text-sm text-[var(--text-secondary)] italic">
            Exporte seus cadernos e resoluções para guardar cópia local ou migrar entre dispositivos.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <a
            href="/api/download?type=archive"
            class="sans-ui p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-page)] hover:border-[var(--accent)] hover:bg-[var(--bg-surface-hover)] transition-all flex flex-col justify-between group shadow-2xs"
          >
            <div class="space-y-1">
              <span class="font-bold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Archive Completo (.zip)
              </span>
              <p class="text-xs text-[var(--text-muted)]">
                Todas as disciplinas ({userMaterias.length}), capítulos e questões cadastradas.
              </p>
            </div>
            <span class="text-xs text-[var(--accent)] font-semibold mt-3 flex items-center gap-1">
              <span>Fazer Download</span>
              <span>&darr;</span>
            </span>
          </a>

          {userMaterias.length > 0 && (
            <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-page)] space-y-3 shadow-2xs">
              <span class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2 sans-ui">
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Matéria Individual (.zip)
              </span>
              <div class="flex gap-2">
                <select
                  id="download-materia-select"
                  class="sans-ui flex-1 px-3 py-1.5 text-xs rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
                >
                  {userMaterias.map((m) => (
                    <option value={m.slug}>{m.name} ({m.code})</option>
                  ))}
                </select>
                <button
                  type="button"
                  id="download-materia-btn"
                  class="sans-ui px-3 py-1.5 text-xs rounded-lg border border-[var(--accent)] bg-[var(--accent)] text-white dark:text-black font-semibold hover:opacity-90 transition-opacity cursor-pointer"
                >
                  Baixar
                </button>
              </div>
            </div>
          )}
        </div>
      </section>

      <!-- SEÇÃO 2: UPLOAD DO ARCHIVE COMPLETO -->
      <section class="p-6 sm:p-8 rounded-2xl border border-red-500/40 bg-[var(--bg-surface)] space-y-6 shadow-2xs">
        <div class="space-y-1">
          <span class="sans-ui text-xs font-mono uppercase tracking-widest text-red-500 font-semibold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            Substituição Total
          </span>
          <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)]">
            Upload do Archive Completo
          </h2>
          <p class="font-serif text-sm text-[var(--text-secondary)] italic">
            Substitui todo o seu diretório de estudos no servidor com o conteúdo do arquivo ZIP.
          </p>
        </div>

        <!-- Warning Chamativo em Vermelho -->
        <div class="p-4 rounded-xl border-2 border-red-500/60 bg-red-500/10 text-red-600 dark:text-red-400 space-y-2 sans-ui text-xs leading-relaxed" role="alert">
          <div class="flex items-center gap-2 font-bold text-sm">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>ATENÇÃO: AÇÃO DESTRUTIVA E IRREVERSÍVEL</span>
          </div>
          <p>
            O envio de um novo archive completo <strong>eliminará e substituirá permanentemente</strong> todas as suas matérias, resumos, questões e imagens existentes no servidor. Recomenda-se baixar um backup antes de prosseguir.
          </p>
          <p class="text-[11px] opacity-90">
            Limite de upload: <strong>{maxMb} MB</strong>. O arquivo ZIP será automaticamente descompactado e excluído do disco em seguida.
          </p>
        </div>

        <form id="full-archive-form" class="space-y-4">
          <input type="hidden" name="type" value="archive" />

          <div class="space-y-1.5">
            <label class="block sans-ui text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">
              Arquivo ZIP do Archive
            </label>
            <input
              type="file"
              name="file"
              accept=".zip"
              required
              class="sans-ui w-full text-xs text-[var(--text-secondary)] file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border file:border-[var(--border-subtle)] file:bg-[var(--bg-page)] file:text-[var(--text-primary)] file:font-semibold hover:file:bg-[var(--bg-surface-hover)] file:cursor-pointer"
            />
          </div>

          <!-- Confirmação com digitação de texto -->
          <div class="p-3.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] space-y-2">
            <label for="confirm-text-full" class="block sans-ui text-xs font-bold text-[var(--text-primary)]">
              Digite <span class="font-mono text-red-500 font-extrabold tracking-wider">CONFIRMAR</span> para liberar o envio:
            </label>
            <input
              type="text"
              id="confirm-text-full"
              placeholder="Digite CONFIRMAR"
              autocomplete="off"
              class="sans-ui w-full px-3 py-1.5 text-xs rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] focus:outline-none focus:border-red-500"
            />
          </div>

          <button
            type="submit"
            id="submit-full-btn"
            disabled
            class="sans-ui w-full py-2.5 px-4 rounded-lg border border-red-500 bg-red-600 text-white font-semibold text-xs hover:bg-red-700 transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-xs flex items-center justify-center gap-2"
          >
            <span>Substituir Archive Completo</span>
          </button>
        </form>
      </section>

      <!-- SEÇÃO 3: UPLOAD DE MATÉRIA ESPECÍFICA -->
      <section class="p-6 sm:p-8 rounded-2xl border border-amber-500/40 bg-[var(--bg-surface)] space-y-6 shadow-2xs">
        <div class="space-y-1">
          <span class="sans-ui text-xs font-mono uppercase tracking-widest text-amber-500 font-semibold">
            Substituição Modular
          </span>
          <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)]">
            Upload de Matéria Específica
          </h2>
          <p class="font-serif text-sm text-[var(--text-secondary)] italic">
            Atualiza ou adiciona apenas uma disciplina específica sem tocar nas outras matérias.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-amber-500/40 bg-amber-500/10 text-amber-700 dark:text-amber-300 space-y-1 sans-ui text-xs leading-relaxed" role="alert">
          <div class="font-bold flex items-center gap-1.5">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Aviso de Substituição Parcial</span>
          </div>
          <p>
            O envio atualizará exclusivamente o conteúdo da matéria indicada. Se a pasta já existir, ela será substituída pelos novos arquivos do ZIP.
          </p>
        </div>

        <form id="materia-form" class="space-y-4">
          <input type="hidden" name="type" value="materia" />

          <div class="space-y-1.5">
            <label for="materia_slug_input" class="block sans-ui text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">
              Identificador da Matéria (slug da pasta, ex: pds)
            </label>
            <input
              type="text"
              id="materia_slug_input"
              name="materia_slug"
              required
              placeholder="ex: pds"
              pattern="^[a-z0-9-_]+$"
              class="sans-ui w-full px-3 py-2 text-xs rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)] font-mono"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block sans-ui text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">
              Arquivo ZIP da Matéria
            </label>
            <input
              type="file"
              name="file"
              accept=".zip"
              required
              class="sans-ui w-full text-xs text-[var(--text-secondary)] file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border file:border-[var(--border-subtle)] file:bg-[var(--bg-page)] file:text-[var(--text-primary)] file:font-semibold hover:file:bg-[var(--bg-surface-hover)] file:cursor-pointer"
            />
          </div>

          <button
            type="submit"
            id="submit-materia-btn"
            class="sans-ui w-full py-2.5 px-4 rounded-lg border border-[var(--accent)] bg-[var(--accent)] text-white dark:text-black font-semibold text-xs hover:opacity-90 transition-all cursor-pointer shadow-xs flex items-center justify-center gap-2"
          >
            <span>Enviar Matéria</span>
          </button>
        </form>
      </section>

      <!-- SEÇÃO 4: ESPECIFICAÇÕES E BOAS PRÁTICAS -->
      <footer class="p-6 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)]/30 text-xs text-[var(--text-muted)] sans-ui space-y-2">
        <div class="font-bold text-[var(--text-secondary)]">Diretrizes de Formato e Segurança</div>
        <ul class="list-disc pl-5 space-y-1">
          <li>Extensões aceitas dentro do ZIP: <code>.md</code>, <code>.mdx</code>, <code>.json</code>, <code>.png</code>, <code>.jpg</code>, <code>.jpeg</code>, <code>.svg</code>, <code>.webp</code>, <code>.gif</code>.</li>
          <li>Cada pasta de disciplina deve conter um arquivo <code>materia.json</code> com os metadados (nome, código, tópicos).</li>
          <li>Após a extração, o arquivo compactado é permanentemente deletado do servidor para economia de espaço.</li>
        </ul>
      </footer>

    </div>

    <script is:inline>
      // 1. Download de Matéria Individual
      const downloadSelect = document.getElementById('download-materia-select');
      const downloadBtn = document.getElementById('download-materia-btn');
      downloadBtn?.addEventListener('click', () => {
        const slug = downloadSelect?.value;
        if (slug) {
          window.location.href = `/api/download?type=materia&materia=${encodeURIComponent(slug)}`;
        }
      });

      // 2. Trava de Confirmação para Upload Completo
      const confirmInput = document.getElementById('confirm-text-full');
      const submitFullBtn = document.getElementById('submit-full-btn');
      confirmInput?.addEventListener('input', (e) => {
        if (e.target.value.trim() === 'CONFIRMAR') {
          submitFullBtn?.removeAttribute('disabled');
        } else {
          submitFullBtn?.setAttribute('disabled', 'true');
        }
      });

      const feedbackAlert = document.getElementById('feedback-alert');

      function showFeedback(type, message) {
        if (!feedbackAlert) return;
        feedbackAlert.classList.remove('hidden', 'bg-red-500/10', 'text-red-600', 'border-red-500/30', 'bg-emerald-500/10', 'text-emerald-600', 'border-emerald-500/30');
        if (type === 'error') {
          feedbackAlert.classList.add('bg-red-500/10', 'text-red-600', 'dark:text-red-400', 'border', 'border-red-500/30');
        } else {
          feedbackAlert.classList.add('bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400', 'border', 'border-emerald-500/30');
        }
        feedbackAlert.textContent = message;
        feedbackAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // 3. Envio do Archive Completo
      const fullForm = document.getElementById('full-archive-form');
      fullForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!confirm('Deseja realmente substituir TODO o seu acervo de estudos?')) return;

        submitFullBtn?.setAttribute('disabled', 'true');
        const origText = submitFullBtn.innerHTML;
        submitFullBtn.innerHTML = 'Enviando e processando archive...';

        try {
          const formData = new FormData(fullForm);
          const res = await fetch('/api/upload', {
            method: 'POST',
            body: formData,
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showFeedback('success', data.message || 'Archive atualizado com sucesso!');
            fullForm.reset();
            confirmInput.value = '';
          } else {
            showFeedback('error', data.error || 'Erro ao processar upload.');
          }
        } catch (err) {
          showFeedback('error', 'Falha de conexão com o servidor.');
        } finally {
          submitFullBtn?.removeAttribute('disabled');
          submitFullBtn.innerHTML = origText;
        }
      });

      // 4. Envio de Matéria Específica
      const materiaForm = document.getElementById('materia-form');
      const submitMateriaBtn = document.getElementById('submit-materia-btn');
      materiaForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitMateriaBtn?.setAttribute('disabled', 'true');
        const origText = submitMateriaBtn.innerHTML;
        submitMateriaBtn.innerHTML = 'Enviando matéria...';

        try {
          const formData = new FormData(materiaForm);
          const res = await fetch('/api/upload', {
            method: 'POST',
            body: formData,
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showFeedback('success', data.message || 'Matéria atualizada com sucesso!');
            materiaForm.reset();
          } else {
            showFeedback('error', data.error || 'Erro ao processar matéria.');
          }
        } catch (err) {
          showFeedback('error', 'Falha de conexão com o servidor.');
        } finally {
          submitMateriaBtn?.removeAttribute('disabled');
          submitMateriaBtn.innerHTML = origText;
        }
      });
    </script>
  </body>
</html>
