---
import '../styles/global.css';
import HeaderActions from '../components/HeaderActions.astro';
import { loadAllAccessibleMaterias } from '../data/materias';

const user = Astro.locals.user!;
const { own, shared, all: MATERIAS } = loadAllAccessibleMaterias(user.id);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Cadernos de Estudo Acadêmico | Biblioteca</title>

    <!-- Fontes Acadêmicas Clássicas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const savedTheme = localStorage.getItem('study_theme') || 'paper';
      const root = document.documentElement;
      root.classList.remove('theme-paper', 'theme-dark', 'theme-oled', 'dark');
      if (savedTheme === 'oled') {
        root.classList.add('dark', 'theme-oled');
      } else if (savedTheme === 'dark') {
        root.classList.add('dark', 'theme-dark');
      } else {
        root.classList.add('theme-paper');
      }

      // Aplica preferências personalizadas salvas
      const font = localStorage.getItem('study_font_family');
      const size = localStorage.getItem('study_font_size');
      const width = localStorage.getItem('study_max_width');
      if (font) root.style.setProperty('--reader-font-family', font);
      if (size) root.style.setProperty('--reader-font-size', size);
      if (width) root.style.setProperty('--reader-max-width', width);

      // Preferências de código e matemática
      const codeTheme = localStorage.getItem('study_code_theme') || 'mocha';
      const codeFont = localStorage.getItem('study_code_font') || "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace";
      const codeSize = localStorage.getItem('study_code_size') || '13px';
      root.setAttribute('data-code-theme', codeTheme);
      root.style.setProperty('--code-font-family', codeFont);
      root.style.setProperty('--code-font-size', codeSize);

      const mathScriptScale = localStorage.getItem('study_math_script_scale') || '0.64';
      const mathMinSize = localStorage.getItem('study_math_min_size') || '10.5px';
      root.style.setProperty('--katex-script-scale', mathScriptScale);
      root.style.setProperty('--katex-min-font-size', mathMinSize);

      if (localStorage.getItem('study_sidebar_collapsed') === 'true') {
        root.classList.add('sidebar-collapsed');
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] transition-colors duration-200">
    
    <!-- CABEÇALHO MOBILE SIMPLIFICADO (SEM BOTÕES DUPLICADOS E FIXO NO TOPO) -->
    <header class="lg:hidden fixed top-0 left-0 right-0 z-30 h-14 flex items-center px-4 border-b border-[var(--border-subtle)] bg-[var(--bg-page)]/95 backdrop-blur-md shadow-xs">
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <button
          id="mobile-sidebar-toggle"
          type="button"
          aria-label="Abrir Menu de Matérias"
          class="sans-ui p-1.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
        </button>
        <span class="font-serif text-sm font-bold truncate text-[var(--text-primary)]">
          Biblioteca de Estudos
        </span>
      </div>
    </header>

    <!-- Espaçador para compensar cabeçalho fixo no mobile -->
    <div class="h-14 lg:hidden w-full shrink-0" aria-hidden="true"></div>

    <div class="flex w-full min-w-0">
      
      <!-- MENU LATERAL ESQUERDO NA PÁGINA HOME -->
      <aside
        id="home-sidebar"
        class="fixed inset-y-0 left-0 z-40 w-80 max-w-[85vw] -translate-x-full lg:translate-x-0 transition-transform duration-200 border-r border-[var(--border-subtle)] bg-[var(--bg-surface)] flex flex-col justify-between overflow-y-auto p-6 space-y-6"
      >
        <div class="space-y-6">
          
          <!-- Topo do Menu Lateral -->
          <div class="space-y-3 pb-5 border-b border-[var(--border-subtle)]">
            <div class="flex items-center justify-between gap-2">
              <span class="sans-ui text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
                Biblioteca Digital
              </span>
              <!-- Dois Botões Redondos (Tema + Engrenagem) -->
              <HeaderActions />
            </div>

            <h2 class="font-serif text-xl font-bold text-[var(--text-primary)] leading-snug">
              Cadernos de Estudo
            </h2>
            <p class="font-serif text-xs text-[var(--text-secondary)] italic">
              Selecione a disciplina desejada na lista abaixo para abrir o material.
            </p>
          </div>

          <!-- LISTA DE MATÉRIAS NO MENU LATERAL -->
          <div class="space-y-3">
            <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center justify-between">
              <span>Disciplinas</span>
              <span class="font-normal font-mono text-[11px]" id="sidebar-materias-count">{MATERIAS.length} cadastradas</span>
            </div>

            <!-- Barra de Busca de Disciplinas (Design Acadêmico Integrado) -->
            <div class="relative group">
              <div class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 flex items-center text-[var(--text-muted)] group-focus-within:text-[var(--accent)] transition-colors duration-200">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <input
                type="search"
                id="sidebar-materia-search"
                placeholder="Buscar disciplina..."
                class="sans-ui w-full pl-8 pr-7 py-1.5 text-xs sm:text-[13px] rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] hover:border-[var(--border-strong)] focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20 focus:outline-none transition-all duration-200 shadow-2xs"
                aria-label="Buscar disciplina no catálogo"
                autocomplete="off"
              />
              <button
                type="button"
                id="sidebar-materia-search-clear"
                class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-[var(--text-muted)] hover:text-[var(--text-primary)] p-0.5 rounded cursor-pointer transition-colors"
                aria-label="Limpar busca"
                title="Limpar busca"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Estado Vazio da Busca -->
            <div
              id="sidebar-materias-empty"
              class="hidden p-3 rounded-lg border border-dashed border-[var(--border-subtle)] bg-[var(--bg-subtle)]/50 text-xs text-[var(--text-muted)] text-center italic"
            >
              Nenhuma disciplina encontrada.
            </div>

            <!-- Navegação com Disciplinas (Ordenadas por Acesso Recente no Cliente) -->
            <nav class="space-y-1.5 sans-ui text-sm" id="sidebar-materias-nav">
              {MATERIAS.map((m, idx) => (
                <a
                  href={m.status === 'active' ? (m.isShared ? `/${m.slug}?owner=${m.ownerUserId}` : `/${m.slug}`) : '#'}
                  data-materia-slug={m.slug}
                  data-default-order={idx}
                  data-search-text={`${m.name} ${m.code} ${m.institution} ${m.description} ${(m.topics || []).join(' ')}`}
                  class={`sidebar-materia-item block p-3 rounded-lg border transition-all duration-150 ${
                    m.status === 'active'
                      ? 'border-[var(--border-subtle)] bg-[var(--bg-page)] hover:border-[var(--accent)] hover:bg-[var(--bg-surface-hover)] group shadow-2xs cursor-pointer'
                      : 'border-dashed border-[var(--border-subtle)] bg-transparent text-[var(--text-muted)] opacity-65 cursor-not-allowed'
                  }`}
                >
                  <div class="flex items-center justify-between text-xs mb-1">
                    <span class="font-mono font-bold text-[var(--accent)]">{m.code}</span>
                    {m.isShared ? (
                      <span class="text-[10px] font-mono text-[var(--accent)] font-semibold truncate max-w-[130px]" title={`Compartilhado por ${m.ownerDisplayName || m.ownerUsername}`}>
                        De: {m.ownerDisplayName || m.ownerUsername}
                      </span>
                    ) : m.status !== 'active' ? (
                      <span class="text-[10px] text-[var(--text-muted)] italic">Em breve</span>
                    ) : (
                      <span class="text-[10px] font-mono text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-colors">
                        {m.period || m.institution}
                      </span>
                    )}
                  </div>
                  <div class="font-serif font-bold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
                    {m.name}
                  </div>
                  {m.status === 'active' && (
                    <div class="text-[11px] text-[var(--text-muted)] mt-1.5 flex items-center justify-between">
                      <span>{m.chaptersCount} capítulos</span>
                      <span>{m.questionsCount} testes</span>
                    </div>
                  )}
                </a>
              ))}
            </nav>
          </div>

          <!-- Gestão do Usuário e Ferramentas -->
          <div class="pt-4 border-t border-[var(--border-subtle)] space-y-2 sans-ui text-xs">
            <div class="p-2.5 rounded-lg bg-[var(--bg-page)] border border-[var(--border-subtle)] flex items-center justify-between">
              <div class="truncate mr-2">
                <div class="font-bold text-[var(--text-primary)] truncate">{user.displayName}</div>
                <div class="text-[10px] text-[var(--text-muted)] font-mono truncate">@{user.username} • {user.role.toUpperCase()}</div>
              </div>
              <a
                href="/api/logout"
                class="px-2 py-1 rounded text-[11px] text-red-500 hover:bg-red-500/10 font-semibold transition-colors shrink-0"
                title="Sair da sessão"
              >
                Sair
              </a>
            </div>

            <a
              href="/upload"
              class="flex items-center gap-2 p-2 rounded hover:bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span>Upload & Backup de Cadernos</span>
            </a>

            {user.role === 'admin' && (
              <a
                href="/admin"
                class="flex items-center gap-2 p-2 rounded hover:bg-[var(--bg-subtle)] text-[var(--accent)] font-semibold transition-colors"
              >
                <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>Painel de Administração</span>
              </a>
            )}

            <a
              href="/configuracoes"
              class="flex items-center gap-2 p-2 rounded hover:bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
              <span>Personalizar Tipografia & Leitura</span>
            </a>
          </div>

        </div>

        <div class="p-4 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-muted)] sans-ui">
          Biblioteca Universitária
        </div>
      </aside>

      <!-- Overlay para Mobile quando o Menu estiver aberto -->
      <div
        id="home-sidebar-backdrop"
        class="fixed inset-0 z-30 bg-black/50 lg:hidden hidden"
      ></div>

      <!-- Botão Flutuante no Canto Superior Esquerdo para Reabrir Menu Lateral no Desktop (Clean e Transparente) -->
      <button
        id="desktop-sidebar-open-btn"
        type="button"
        class="desktop-sidebar-open-btn hidden fixed top-4 left-4 z-40 p-1 bg-transparent border-0 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-all cursor-pointer items-center justify-center focus:outline-none group"
        aria-label="Abrir menu lateral"
        title="Abrir menu lateral"
      >
        <svg class="w-6 h-6 sm:w-7 sm:h-7 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- ÁREA PRINCIPAL DA HOME -->
      <main id="main-content-area" class="flex-1 lg:pl-80 w-full min-w-0 transition-[padding] duration-200 overflow-x-clip">
        <div class="max-w-3xl mx-auto px-4 sm:px-8 lg:px-12 py-10 sm:py-16 space-y-10 w-full min-w-0">
          
          <!-- Cabeçalho Central -->
          <header class="pb-6 border-b border-[var(--border-strong)] space-y-2">
            <span class="sans-ui text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
              Portal Acadêmico
            </span>
            <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">
              Biblioteca de Cadernos de Estudo
            </h1>
            <p class="font-serif text-base text-[var(--text-secondary)] italic">
              Sínteses teóricas com rigor matemático, fluxo contínuo de leitura e banco de provas comentadas passo a passo.
            </p>
          </header>

          <!-- SEÇÃO: CONTINUAR ESTUDANDO (ÚLTIMA MATÉRIA ACESSADA / RECENTES) -->
          <section id="recent-section" class="p-6 rounded-lg border-2 border-[var(--accent)] bg-[var(--bg-surface)] space-y-3">
            <div class="sans-ui flex items-center justify-between text-xs text-[var(--text-muted)] border-b border-[var(--border-subtle)] pb-2">
              <span class="font-mono font-bold uppercase tracking-wider text-[var(--accent)] flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
                Continuar Estudando • Última Sessão de Estudo
              </span>
              <span id="recent-time-badge" class="italic">Caderno em andamento</span>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1">
              <div>
                <div id="recent-code" class="sans-ui text-xs font-mono text-[var(--text-secondary)] font-semibold">
                  PTC3361 • Escola Politécnica da USP
                </div>
                <h2 id="recent-title" class="font-serif text-xl sm:text-2xl font-bold text-[var(--text-primary)]">
                  Processamento Digital de Sinais
                </h2>
                <p id="recent-desc" class="font-serif text-sm text-[var(--text-secondary)] italic mt-0.5">
                  P1 • Amostragem, Nyquist, Aliasing, SLITs e Convolução
                </p>
              </div>

              <a
                id="recent-continue-btn"
                href="/pds"
                class="sans-ui shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded border border-[var(--accent)] bg-[var(--accent)] hover:opacity-90 text-white dark:text-black font-semibold text-xs transition-opacity cursor-pointer shadow-xs"
              >
                <span id="recent-continue-btn-text">Continuar Caderno</span>
                <span>&rarr;</span>
              </a>
            </div>
          </section>

          <!-- CATÁLOGO DETALHADO DE DISCIPLINAS -->
          <section class="space-y-6">
            <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center justify-between">
              <span>Disciplinas Disponíveis</span>
              <span>Selecione no catálogo ou pelo menu lateral</span>
            </div>

            <div class="space-y-6">
              {MATERIAS.map((m) => (
                <article class="p-6 sm:p-8 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] hover:border-[var(--accent)] transition-colors space-y-4">
                  <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-[var(--border-subtle)]">
                    <div class="sans-ui flex items-center gap-2 text-xs">
                      <span class="font-mono font-bold text-[var(--accent)] uppercase tracking-wider">
                        {m.code}
                      </span>
                      <span class="text-[var(--text-muted)]">•</span>
                      <span class="text-[var(--text-secondary)]">
                        {m.institution}
                      </span>
                      {m.isShared && (
                        <>
                          <span class="text-[var(--text-muted)]">•</span>
                          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[var(--accent)]/15 text-[var(--accent)]">
                            De: {m.ownerDisplayName || m.ownerUsername}
                          </span>
                        </>
                      )}
                    </div>
                    <span class="sans-ui text-xs px-2 py-0.5 rounded border border-[var(--border-subtle)] text-[var(--text-muted)]">
                      {m.period}
                    </span>
                  </div>

                  <div>
                    <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)] mb-1">
                      {m.status === 'active' ? (
                        <a href={m.isShared ? `/${m.slug}?owner=${m.ownerUserId}` : `/${m.slug}`} class="hover:text-[var(--accent)] transition-colors">
                          {m.name}
                        </a>
                      ) : (
                        <span>{m.name}</span>
                      )}
                    </h2>
                    <p class="font-serif text-base text-[var(--text-secondary)] leading-relaxed">
                      {m.description}
                    </p>
                  </div>

                  <!-- Tópicos -->
                  <div class="sans-ui flex flex-wrap gap-1.5 text-xs text-[var(--text-muted)]">
                    <span class="font-semibold text-[var(--text-secondary)] mr-1">Tópicos abordados:</span>
                    {m.topics.map((t, idx) => (
                      <span>
                        {t}{idx < m.topics.length - 1 ? ' • ' : ''}
                      </span>
                    ))}
                  </div>

                  <!-- Ação -->
                  <div class="sans-ui flex items-center justify-between pt-4 border-t border-[var(--border-subtle)] text-xs">
                    {m.status === 'active' ? (
                      <>
                        <span class="text-[var(--text-muted)] font-mono">
                          {m.chaptersCount} capítulos em fluxo contínuo • {m.questionsCount} questões resolvidas
                        </span>
                        <a
                          href={m.isShared ? `/${m.slug}?owner=${m.ownerUserId}` : `/${m.slug}`}
                          class="inline-flex items-center gap-1 font-bold text-[var(--accent)] hover:underline"
                        >
                          <span>Abrir Caderno Integral</span>
                          <span>&rarr;</span>
                        </a>
                      </>
                    ) : (
                      <span class="text-[var(--text-muted)] italic">
                        Disciplina cadastrada na estrutura (aguardando inserção de materiais via Skill Antigravity).
                      </span>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- Nota Editorial de Rodapé -->
          <footer class="pt-8 border-t border-[var(--border-subtle)] sans-ui text-xs text-[var(--text-muted)] flex flex-col sm:flex-row justify-between gap-4 text-center sm:text-left">
            <div>
              Renderização matemática completa com KaTeX • Rolagem horizontal independente em tabelas e equações
            </div>
            <div>
              Estilo clássico de livro acadêmico
            </div>
          </footer>

        </div>
      </main>

    </div>

    <!-- Script de Gestão da Seção Recente e Toggle Mobile na Home -->
    <script is:inline>
      // Função para registrar acesso recente à matéria
      function recordMateriaAccess(slug) {
        try {
          const now = new Date().toISOString();
          let recentList = [];
          try {
            recentList = JSON.parse(localStorage.getItem('study_recent_materias') || '[]');
          } catch (e) {}
          if (!Array.isArray(recentList)) recentList = [];
          recentList = recentList.filter((item) => item && item.slug !== slug);
          recentList.unshift({ slug, visitedAt: now });
          localStorage.setItem('study_recent_materias', JSON.stringify(recentList.slice(0, 30)));
        } catch (e) {}
      }

      // Ordenação por Acesso Recente e Busca no Menu Lateral
      function setupSidebarMaterias() {
        const nav = document.getElementById('sidebar-materias-nav');
        const searchInput = document.getElementById('sidebar-materia-search');
        const clearBtn = document.getElementById('sidebar-materia-search-clear');
        const emptyEl = document.getElementById('sidebar-materias-empty');
        const countEl = document.getElementById('sidebar-materias-count');
        const items = Array.from(document.querySelectorAll('.sidebar-materia-item'));

        if (!nav || items.length === 0) return;

        // 1. Ordenação por Acesso Recente
        try {
          let recentList = [];
          try {
            recentList = JSON.parse(localStorage.getItem('study_recent_materias') || '[]');
          } catch (e) {}

          const lastVisited = localStorage.getItem('last_visited_subject');
          if (lastVisited) {
            try {
              const parsed = JSON.parse(lastVisited);
              if (parsed && parsed.slug && !recentList.some((r) => r.slug === parsed.slug)) {
                recentList.unshift({ slug: parsed.slug, visitedAt: parsed.visitedAt || new Date().toISOString() });
              }
            } catch (e) {}
          }

          if (recentList.length > 0) {
            const priorityMap = {};
            recentList.forEach((r, idx) => {
              if (r && r.slug) {
                priorityMap[r.slug] = 100000 - idx;
              }
            });

            items.sort((a, b) => {
              const slugA = a.getAttribute('data-materia-slug') || '';
              const slugB = b.getAttribute('data-materia-slug') || '';
              const scoreA = priorityMap[slugA] || 0;
              const scoreB = priorityMap[slugB] || 0;

              if (scoreA !== scoreB) {
                return scoreB - scoreA;
              }

              const orderA = parseInt(a.getAttribute('data-default-order') || '0', 10);
              const orderB = parseInt(b.getAttribute('data-default-order') || '0', 10);
              return orderA - orderB;
            });

            items.forEach((item) => nav.appendChild(item));
          }
        } catch (e) {
          console.error(e);
        }

        // Salva acesso recente ao clicar em qualquer disciplina
        items.forEach((item) => {
          item.addEventListener('click', () => {
            const slug = item.getAttribute('data-materia-slug');
            if (slug) recordMateriaAccess(slug);
          });
        });

        // 2. Busca e Filtro de Disciplinas
        function normalizeText(str) {
          return (str || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .trim();
        }

        function handleSearch(term) {
          const q = normalizeText(term);
          let visibleCount = 0;

          if (clearBtn) {
            if (term && term.length > 0) {
              clearBtn.classList.remove('hidden');
            } else {
              clearBtn.classList.add('hidden');
            }
          }

          items.forEach((item) => {
            const text = normalizeText(item.getAttribute('data-search-text') || '');
            if (!q || text.includes(q)) {
              item.classList.remove('hidden');
              visibleCount++;
            } else {
              item.classList.add('hidden');
            }
          });

          if (countEl) {
            countEl.textContent = q
              ? `${visibleCount} encontrada${visibleCount === 1 ? '' : 's'}`
              : `${items.length} cadastradas`;
          }

          if (emptyEl) {
            if (visibleCount === 0) {
              emptyEl.classList.remove('hidden');
            } else {
              emptyEl.classList.add('hidden');
            }
          }
        }

        searchInput?.addEventListener('input', (e) => {
          handleSearch(e.target.value);
        });

        clearBtn?.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            searchInput.focus();
            handleSearch('');
          }
        });

        searchInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            searchInput.value = '';
            handleSearch('');
            searchInput.blur();
          }
        });
      }

      setupSidebarMaterias();

      try {
        const last = localStorage.getItem('last_visited_subject');
        if (last) {
          const parsed = JSON.parse(last);
          if (parsed && (parsed.slug || parsed.lastUrl)) {
            const titleEl = document.getElementById('recent-title');
            const codeEl = document.getElementById('recent-code');
            const descEl = document.getElementById('recent-desc');
            const btnEl = document.getElementById('recent-continue-btn');
            const btnTextEl = document.getElementById('recent-continue-btn-text');
            const timeBadge = document.getElementById('recent-time-badge');

            if (titleEl) titleEl.textContent = parsed.name;
            if (codeEl) codeEl.textContent = `${parsed.code} • ${parsed.institution || 'USP'}`;

            // Destino exato da última página da última sessão de estudo
            const targetUrl = parsed.lastUrl || parsed.url || `/${parsed.slug}`;
            if (btnEl) btnEl.href = targetUrl;

            // Ajusta o texto descritivo e do botão baseado na URL e seção
            if (targetUrl.includes('/questoes/')) {
              if (btnTextEl) btnTextEl.textContent = 'Continuar Questão';
              if (descEl) descEl.textContent = parsed.lastSectionTitle ? `Última questão: ${parsed.lastSectionTitle}` : `Questão Resolvida — ${parsed.name}`;
            } else if (targetUrl.includes('#')) {
              if (btnTextEl) btnTextEl.textContent = 'Continuar Leitura';
              if (descEl) descEl.textContent = parsed.lastSectionTitle ? `Continuar em: ${parsed.lastSectionTitle}` : `${parsed.period || ''} — Caderno Integral`;
            } else {
              if (btnTextEl) btnTextEl.textContent = 'Continuar Caderno';
              if (descEl) descEl.textContent = parsed.lastSectionTitle ? `Última seção: ${parsed.lastSectionTitle}` : `${parsed.period || ''} — Caderno Integral`;
            }

            if (timeBadge && parsed.visitedAt) {
              const dt = new Date(parsed.visitedAt);
              timeBadge.textContent = `Acessado recentemente (${dt.toLocaleDateString('pt-BR')} às ${dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })})`;
            }
          }
        }
      } catch (e) {
        console.error(e);
      }

      // Gerenciador de Sidebar (Desktop e Mobile) na Home
      const sidebarToggle = document.getElementById('mobile-sidebar-toggle');
      const sidebar = document.getElementById('home-sidebar');
      const backdrop = document.getElementById('home-sidebar-backdrop');
      const desktopOpenBtn = document.getElementById('desktop-sidebar-open-btn');
      const closeBtns = document.querySelectorAll('.sidebar-close-btn');

      function collapseDesktopSidebar() {
        document.documentElement.classList.add('sidebar-collapsed');
        localStorage.setItem('study_sidebar_collapsed', 'true');
      }

      function expandDesktopSidebar() {
        document.documentElement.classList.remove('sidebar-collapsed');
        localStorage.setItem('study_sidebar_collapsed', 'false');
      }

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        backdrop?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
      }

      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      }

      function handleCloseSidebar() {
        if (window.innerWidth >= 1024) {
          collapseDesktopSidebar();
        } else {
          closeSidebar();
        }
      }

      closeBtns.forEach((btn) => {
        btn.onclick = handleCloseSidebar;
      });

      if (desktopOpenBtn) {
        desktopOpenBtn.onclick = expandDesktopSidebar;
      }

      if (sidebarToggle) {
        sidebarToggle.onclick = openSidebar;
      }

      if (backdrop) {
        backdrop.onclick = closeSidebar;
      }

      sidebar?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 1024) closeSidebar();
        });
      });

      // Gestos Touch no Celular com validação estrita anti-toque acidental
      function isInsideScrollable(el) {
        if (!el || !(el instanceof Element)) return false;
        if (el.closest('.academic-table-wrapper, table, .katex-display, .katex, pre, code, [data-scrollable], .overflow-x-auto, .overflow-y-auto, [style*="overflow"]')) {
          return true;
        }
        let curr = el;
        while (curr && curr !== document.body && curr !== document.documentElement) {
          const style = window.getComputedStyle(curr);
          const ox = style.overflowX;
          const oy = style.overflowY;
          if (['auto', 'scroll'].includes(ox) && curr.scrollWidth > curr.clientWidth + 4) return true;
          if (['auto', 'scroll'].includes(oy) && curr.scrollHeight > curr.clientHeight + 4) return true;
          curr = curr.parentElement;
        }
        return false;
      }

      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartTime = 0;
      let touchStartInsideScrollable = false;

      window.addEventListener('touchstart', (e) => {
        if (window.innerWidth >= 1024) return;
        const t = e.touches[0];
        touchStartX = t.clientX;
        touchStartY = t.clientY;
        touchStartTime = Date.now();
        touchStartInsideScrollable = isInsideScrollable(e.target);
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        if (window.innerWidth >= 1024) return;
        const t = e.changedTouches[0];
        const deltaX = t.clientX - touchStartX;
        const deltaY = t.clientY - touchStartY;
        const elapsed = Date.now() - touchStartTime;

        if (touchStartInsideScrollable) return;
        if (Math.abs(deltaY) > 30 || Math.abs(deltaX) < Math.abs(deltaY) * 2.2 || elapsed > 450) return;

        const isClosed = sidebar?.classList.contains('-translate-x-full');
        const isEdgeSwipe = touchStartX <= Math.min(28, window.innerWidth * 0.08);

        if (isClosed && deltaX > 45 && isEdgeSwipe) {
          openSidebar();
        } else if (!isClosed && deltaX < -45) {
          closeSidebar();
        }
      }, { passive: true });
    </script>
  </body>
</html>
