---
import '../styles/global.css';
import HeaderActions from '../components/HeaderActions.astro';
import { MATERIAS } from '../data/materias';
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Cadernos de Estudo Acadêmico | Biblioteca</title>

    <!-- Fontes Acadêmicas Clássicas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const savedTheme = localStorage.getItem('study_theme') || 'paper';
      const root = document.documentElement;
      root.classList.remove('theme-paper', 'theme-dark', 'theme-oled', 'dark');
      if (savedTheme === 'oled') {
        root.classList.add('dark', 'theme-oled');
      } else if (savedTheme === 'dark') {
        root.classList.add('dark', 'theme-dark');
      } else {
        root.classList.add('theme-paper');
      }

      // Aplica preferências personalizadas salvas
      const font = localStorage.getItem('study_font_family');
      const size = localStorage.getItem('study_font_size');
      const width = localStorage.getItem('study_max_width');
      if (font) root.style.setProperty('--reader-font-family', font);
      if (size) root.style.setProperty('--reader-font-size', size);
      if (width) root.style.setProperty('--reader-max-width', width);
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] transition-colors duration-200 overflow-x-hidden">
    
    <!-- CABEÇALHO MOBILE SIMPLIFICADO (SEM BOTÕES DUPLICADOS) -->
    <header class="lg:hidden sticky top-0 z-30 flex items-center px-4 py-3 border-b border-[var(--border-subtle)] bg-[var(--bg-page)]/95 backdrop-blur-md shadow-xs w-full min-w-0">
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <button
          id="mobile-sidebar-toggle"
          type="button"
          aria-label="Abrir Menu de Matérias"
          class="sans-ui p-1.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
        </button>
        <span class="font-serif text-sm font-bold truncate text-[var(--text-primary)]">
          Biblioteca de Estudos
        </span>
      </div>
    </header>

    <div class="flex w-full min-w-0">
      
      <!-- MENU LATERAL ESQUERDO NA PÁGINA HOME -->
      <aside
        id="home-sidebar"
        class="fixed inset-y-0 left-0 z-40 w-80 max-w-[85vw] -translate-x-full lg:translate-x-0 transition-transform duration-200 border-r border-[var(--border-subtle)] bg-[var(--bg-surface)] flex flex-col justify-between overflow-y-auto p-6 space-y-6"
      >
        <div class="space-y-6">
          
          <!-- Topo do Menu Lateral -->
          <div class="space-y-3 pb-5 border-b border-[var(--border-subtle)]">
            <div class="flex items-center justify-between gap-2">
              <span class="sans-ui text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
                Biblioteca Digital
              </span>
              <!-- Dois Botões Redondos (Tema + Engrenagem) -->
              <HeaderActions />
            </div>

            <h2 class="font-serif text-xl font-bold text-[var(--text-primary)] leading-snug">
              Cadernos de Estudo
            </h2>
            <p class="font-serif text-xs text-[var(--text-secondary)] italic">
              Selecione a disciplina desejada na lista abaixo para abrir o material.
            </p>
          </div>

          <!-- LISTA DE MATÉRIAS NO MENU LATERAL -->
          <div class="space-y-3">
            <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center justify-between">
              <span>Disciplinas</span>
              <span class="font-normal font-mono">{MATERIAS.length} cadastradas</span>
            </div>

            <nav class="space-y-1 sans-ui text-sm">
              {MATERIAS.map((m) => (
                <a
                  href={m.status === 'active' ? `/${m.slug}` : '#'}
                  class={`block p-3 rounded-lg border transition-all ${
                    m.status === 'active'
                      ? 'border-[var(--border-subtle)] bg-[var(--bg-page)] hover:border-[var(--accent)] hover:bg-[var(--bg-subtle)] group'
                      : 'border-transparent text-[var(--text-muted)] opacity-65 cursor-not-allowed'
                  }`}
                >
                  <div class="flex items-center justify-between text-xs mb-1">
                    <span class="font-mono font-bold text-[var(--accent)]">{m.code}</span>
                    {m.status === 'active' ? (
                      <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold uppercase">Ativa</span>
                    ) : (
                      <span class="text-[10px] text-[var(--text-muted)] italic">Em breve</span>
                    )}
                  </div>
                  <div class="font-serif font-bold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
                    {m.name}
                  </div>
                  {m.status === 'active' && (
                    <div class="text-[11px] text-[var(--text-muted)] mt-1 flex items-center justify-between">
                      <span>{m.chaptersCount} capítulos</span>
                      <span>{m.questionsCount} testes</span>
                    </div>
                  )}
                </a>
              ))}
            </nav>
          </div>

          <!-- Atalho para Configurações no Menu -->
          <div class="pt-4 border-t border-[var(--border-subtle)] space-y-2 sans-ui text-xs">
            <a
              href="/configuracoes"
              class="flex items-center gap-2 p-2 rounded hover:bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
            >
              <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Personalizar Tipografia & Leitura</span>
            </a>
          </div>

        </div>

        <div class="p-4 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-muted)] sans-ui">
          Biblioteca Universitária
        </div>
      </aside>

      <!-- Overlay para Mobile quando o Menu estiver aberto -->
      <div
        id="home-sidebar-backdrop"
        class="fixed inset-0 z-30 bg-black/50 lg:hidden hidden"
      ></div>

      <!-- ÁREA PRINCIPAL DA HOME -->
      <main class="flex-1 lg:pl-80 w-full min-w-0 overflow-x-hidden">
        <div class="max-w-3xl mx-auto px-4 sm:px-8 lg:px-12 py-10 sm:py-16 space-y-10 w-full min-w-0">
          
          <!-- Cabeçalho Central -->
          <header class="pb-6 border-b border-[var(--border-strong)] space-y-2">
            <span class="sans-ui text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
              Portal Acadêmico
            </span>
            <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">
              Biblioteca de Cadernos de Estudo
            </h1>
            <p class="font-serif text-base text-[var(--text-secondary)] italic">
              Sínteses teóricas com rigor matemático, fluxo contínuo de leitura e banco de provas comentadas passo a passo.
            </p>
          </header>

          <!-- SEÇÃO: CONTINUAR ESTUDANDO (ÚLTIMA MATÉRIA ACESSADA / RECENTES) -->
          <section id="recent-section" class="p-6 rounded-lg border-2 border-[var(--accent)] bg-[var(--bg-surface)] space-y-3">
            <div class="sans-ui flex items-center justify-between text-xs text-[var(--text-muted)] border-b border-[var(--border-subtle)] pb-2">
              <span class="font-mono font-bold uppercase tracking-wider text-[var(--accent)] flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
                Continuar Estudando • Última Matéria Acessada
              </span>
              <span id="recent-time-badge" class="italic">Caderno em andamento</span>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1">
              <div>
                <div id="recent-code" class="sans-ui text-xs font-mono text-[var(--text-secondary)] font-semibold">
                  PTC3361 • Escola Politécnica da USP
                </div>
                <h2 id="recent-title" class="font-serif text-xl sm:text-2xl font-bold text-[var(--text-primary)]">
                  Processamento Digital de Sinais
                </h2>
                <p id="recent-desc" class="font-serif text-sm text-[var(--text-secondary)] italic mt-0.5">
                  P1 • Amostragem, Nyquist, Aliasing, SLITs e Convolução
                </p>
              </div>

              <a
                id="recent-continue-btn"
                href="/pds"
                class="sans-ui shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded border border-[var(--accent)] bg-[var(--accent)] hover:opacity-90 text-white dark:text-black font-semibold text-xs transition-opacity cursor-pointer shadow-xs"
              >
                <span>Continuar Caderno</span>
                <span>&rarr;</span>
              </a>
            </div>
          </section>

          <!-- CATÁLOGO DETALHADO DE DISCIPLINAS -->
          <section class="space-y-6">
            <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] flex items-center justify-between">
              <span>Disciplinas Disponíveis</span>
              <span>Selecione no catálogo ou pelo menu lateral</span>
            </div>

            <div class="space-y-6">
              {MATERIAS.map((m) => (
                <article class="p-6 sm:p-8 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] hover:border-[var(--accent)] transition-colors space-y-4">
                  <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-[var(--border-subtle)]">
                    <div class="sans-ui flex items-center gap-2 text-xs">
                      <span class="font-mono font-bold text-[var(--accent)] uppercase tracking-wider">
                        {m.code}
                      </span>
                      <span class="text-[var(--text-muted)]">•</span>
                      <span class="text-[var(--text-secondary)]">
                        {m.institution}
                      </span>
                    </div>
                    <span class="sans-ui text-xs px-2 py-0.5 rounded border border-[var(--border-subtle)] text-[var(--text-muted)]">
                      {m.period}
                    </span>
                  </div>

                  <div>
                    <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)] mb-1">
                      {m.status === 'active' ? (
                        <a href={`/${m.slug}`} class="hover:text-[var(--accent)] transition-colors">
                          {m.name}
                        </a>
                      ) : (
                        <span>{m.name}</span>
                      )}
                    </h2>
                    <p class="font-serif text-base text-[var(--text-secondary)] leading-relaxed">
                      {m.description}
                    </p>
                  </div>

                  <!-- Tópicos -->
                  <div class="sans-ui flex flex-wrap gap-1.5 text-xs text-[var(--text-muted)]">
                    <span class="font-semibold text-[var(--text-secondary)] mr-1">Tópicos abordados:</span>
                    {m.topics.map((t, idx) => (
                      <span>
                        {t}{idx < m.topics.length - 1 ? ' • ' : ''}
                      </span>
                    ))}
                  </div>

                  <!-- Ação -->
                  <div class="sans-ui flex items-center justify-between pt-4 border-t border-[var(--border-subtle)] text-xs">
                    {m.status === 'active' ? (
                      <>
                        <span class="text-[var(--text-muted)] font-mono">
                          {m.chaptersCount} capítulos em fluxo contínuo • {m.questionsCount} testes resolvidos
                        </span>
                        <a
                          href={`/${m.slug}`}
                          class="inline-flex items-center gap-1 font-bold text-[var(--accent)] hover:underline"
                        >
                          <span>Abrir Caderno Integral</span>
                          <span>&rarr;</span>
                        </a>
                      </>
                    ) : (
                      <span class="text-[var(--text-muted)] italic">
                        Disciplina cadastrada na estrutura (aguardando inserção de materiais via Skill Antigravity).
                      </span>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- Nota Editorial de Rodapé -->
          <footer class="pt-8 border-t border-[var(--border-subtle)] sans-ui text-xs text-[var(--text-muted)] flex flex-col sm:flex-row justify-between gap-4 text-center sm:text-left">
            <div>
              Renderização matemática completa com KaTeX • Rolagem horizontal independente em tabelas e equações
            </div>
            <div>
              Estilo clássico de livro acadêmico
            </div>
          </footer>

        </div>
      </main>

    </div>

    <!-- Script de Gestão da Seção Recente e Toggle Mobile na Home -->
    <script is:inline>
      try {
        const last = localStorage.getItem('last_visited_subject');
        if (last) {
          const parsed = JSON.parse(last);
          if (parsed && parsed.slug) {
            const titleEl = document.getElementById('recent-title');
            const codeEl = document.getElementById('recent-code');
            const descEl = document.getElementById('recent-desc');
            const btnEl = document.getElementById('recent-continue-btn');
            const timeBadge = document.getElementById('recent-time-badge');

            if (titleEl) titleEl.textContent = parsed.name;
            if (codeEl) codeEl.textContent = `${parsed.code} • ${parsed.institution || 'USP'}`;
            if (descEl) descEl.textContent = `${parsed.period || ''} — Caderno Integral`;
            if (btnEl) btnEl.href = `/${parsed.slug}`;
            if (timeBadge && parsed.visitedAt) {
              const dt = new Date(parsed.visitedAt);
              timeBadge.textContent = `Acessado recentemente (${dt.toLocaleDateString('pt-BR')})`;
            }
          }
        }
      } catch (e) {
        console.error(e);
      }

      // Drawer Mobile na Home
      const sidebarToggle = document.getElementById('mobile-sidebar-toggle');
      const sidebar = document.getElementById('home-sidebar');
      const backdrop = document.getElementById('home-sidebar-backdrop');

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        backdrop?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
      }

      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      }

      sidebarToggle?.addEventListener('click', openSidebar);
      backdrop?.addEventListener('click', closeSidebar);

      sidebar?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 1024) closeSidebar();
        });
      });

      // Gestos Touch no Celular: Deslizar para a direita abre o menu lateral
      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartTime = 0;

      window.addEventListener('touchstart', (e) => {
        if (window.innerWidth >= 1024) return;
        const t = e.touches[0];
        touchStartX = t.clientX;
        touchStartY = t.clientY;
        touchStartTime = Date.now();
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        if (window.innerWidth >= 1024) return;
        const t = e.changedTouches[0];
        const deltaX = t.clientX - touchStartX;
        const deltaY = t.clientY - touchStartY;
        const elapsed = Date.now() - touchStartTime;

        if (Math.abs(deltaY) > 80 || elapsed > 650) return;

        const isClosed = sidebar?.classList.contains('-translate-x-full');

        // Deslizar para a direita (deltaX > 50) a partir da área esquerda da tela
        if (isClosed && deltaX > 50 && touchStartX < window.innerWidth * 0.45) {
          openSidebar();
        }
        // Deslizar para a esquerda com o menu aberto fecha o menu lateral
        else if (!isClosed && deltaX < -50) {
          closeSidebar();
        }
      }, { passive: true });
    </script>
  </body>
</html>
