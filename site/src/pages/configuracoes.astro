                      </div>
                      <div class="code-block-card" id="preview-sample-code-card">
                        <div class="code-block-header">
                          <div class="code-block-lang flex items-center gap-1.5 font-mono text-xs font-bold">
                            <span>PYTHON</span>
                          </div>
                          <span class="text-[10px] font-mono opacity-60">Prévia</span>
                        </div>
                        <pre id="preview-sample-code" class="shiki"><code id="preview-sample-code-inner" class="shiki"><span style="--shiki-mocha:#f38ba8;--shiki-tokyo:#bb9af7;--shiki-dracula:#ff79c6;--shiki-onedark:#c678dd;--shiki-monokai:#f92672;">def</span> <span style="--shiki-mocha:#89b4fa;--shiki-tokyo:#7aa2f7;--shiki-dracula:#50fa7b;--shiki-onedark:#61afef;--shiki-monokai:#a6e22e;">filtro_fir</span>(<span style="--shiki-mocha:#fab387;--shiki-tokyo:#e0af68;--shiki-dracula:#ffb86c;--shiki-onedark:#e5c07b;--shiki-monokai:#fd971f;">x</span>, <span style="--shiki-mocha:#fab387;--shiki-tokyo:#e0af68;--shiki-dracula:#ffb86c;--shiki-onedark:#e5c07b;--shiki-monokai:#fd971f;">b</span>):
    <span style="--shiki-mocha:#6c7086;--shiki-tokyo:#565f89;--shiki-dracula:#6272a4;--shiki-onedark:#5c6370;--shiki-monokai:#75715e;font-style:italic;"># Convolução temporal discreta</span>
    <span style="--shiki-mocha:#f38ba8;--shiki-tokyo:#bb9af7;--shiki-dracula:#ff79c6;--shiki-onedark:#c678dd;--shiki-monokai:#f92672;">return</span> [<span style="--shiki-mocha:#89dceb;--shiki-tokyo:#7dcfff;--shiki-dracula:#8be9fd;--shiki-onedark:#56b6c2;--shiki-monokai:#66d9ef;">sum</span>(b[k] * x[n-k] <span style="--shiki-mocha:#f38ba8;--shiki-tokyo:#bb9af7;--shiki-dracula:#ff79c6;--shiki-onedark:#c678dd;--shiki-monokai:#f92672;">for</span> k <span style="--shiki-mocha:#f38ba8;--shiki-tokyo:#bb9af7;--shiki-dracula:#ff79c6;--shiki-onedark:#c678dd;--shiki-monokai:#f92672;">in</span> <span style="--shiki-mocha:#89dceb;--shiki-tokyo:#7dcfff;--shiki-dracula:#8be9fd;--shiki-onedark:#56b6c2;--shiki-monokai:#66d9ef;">range</span>(<span style="--shiki-mocha:#89dceb;--shiki-tokyo:#7dcfff;--shiki-dracula:#8be9fd;--shiki-onedark:#56b6c2;--shiki-monokai:#66d9ef;">len</span>(b)) <span style="--shiki-mocha:#f38ba8;--shiki-tokyo:#bb9af7;--shiki-dracula:#ff79c6;--shiki-onedark:#c678dd;--shiki-monokai:#f92672;">if</span> n-k &gt;= 0) <span style="--shiki-mocha:#f38ba8;--shiki-tokyo:#bb9af7;--shiki-dracula:#ff79c6;--shiki-onedark:#c678dd;--shiki-monokai:#f92672;">for</span> n <span style="--shiki-mocha:#f38ba8;--shiki-tokyo:#bb9af7;--shiki-dracula:#ff79c6;--shiki-onedark:#c678dd;--shiki-monokai:#f92672;">in</span> <span style="--shiki-mocha:#89dceb;--shiki-tokyo:#7dcfff;--shiki-dracula:#8be9fd;--shiki-onedark:#56b6c2;--shiki-monokai:#66d9ef;">range</span>(<span style="--shiki-mocha:#89dceb;--shiki-tokyo:#7dcfff;--shiki-dracula:#8be9fd;--shiki-onedark:#56b6c2;--shiki-monokai:#66d9ef;">len</span>(x))]</code></pre>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- 7. Gerenciamento de Armazenamento e Cache -->
            <div class="p-6 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] space-y-5">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <label class="font-bold text-[var(--text-primary)] text-base block">7. Armazenamento e Cache</label>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Gerencie o cache local do navegador e o cache compilado do servidor para forçar a atualização imediata do acervo.
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <span id="cache-status-badge" class="font-mono text-xs text-[var(--text-muted)] bg-[var(--bg-subtle)] px-2.5 py-1 rounded border border-[var(--border-subtle)] flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>Cache Ativo</span>
                  </span>
                </div>
              </div>

              <!-- Informações sobre os Caches -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div class="p-3.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] space-y-1.5">
                  <div class="flex items-center gap-2 font-bold text-[var(--text-primary)]">
                    <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>Cache do Navegador</span>
                  </div>
                  <p class="text-[var(--text-muted)] leading-relaxed">
                    Armazena localmente os cadernos renderizados e metadados no localStorage para navegação instantânea.
                  </p>
                  <div id="browser-cache-stats" class="font-mono text-[11px] text-[var(--text-secondary)] pt-1">
                    Calculando tamanho...
                  </div>
                </div>

                <div class="p-3.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] space-y-1.5">
                  <div class="flex items-center gap-2 font-bold text-[var(--text-primary)]">
                    <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                    </svg>
                    <span>Cache do Servidor</span>
                  </div>
                  <p class="text-[var(--text-muted)] leading-relaxed">
                    Cache persistente no SQLite de fórmulas KaTeX e nós de cadernos MDX processados no Node.
                  </p>
                  <div class="font-mono text-[11px] text-[var(--text-secondary)] pt-1">
                    SQLite + In-Memory Node
                  </div>
                </div>
              </div>

              <!-- Ação de Limpeza -->
              <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-[var(--border-subtle)]">
                <div class="text-xs text-[var(--text-muted)]">
                  Suas preferências de leitura (tema, fontes, tamanhos) serão preservadas intactas.
                </div>
                <div class="flex items-center gap-3">
                  <button
                    type="button"
                    id="clear-site-cache-btn"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-page)] hover:bg-[var(--bg-subtle)] text-[var(--text-primary)] hover:border-[var(--accent)] text-xs font-bold cursor-pointer transition-all shadow-xs group"
                  >
                    <svg class="w-4 h-4 text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    <span id="clear-site-cache-text">Limpar Cache do Site</span>
                  </button>
                </div>
              </div>

              <!-- Feedback inline -->
              <div id="cache-feedback-message" class="hidden text-xs py-2 px-3 rounded-md bg-[var(--bg-subtle)] border border-[var(--border-subtle)]"></div>
            </div>

            <!-- 8. Barra Inferior de Ações (Salvar e Restaurar) -->
            <div class="pt-6 border-t border-[var(--border-strong)] flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="flex items-center gap-2 w-full sm:w-auto">
                <button
                  type="button"
                  id="reset-defaults-btn"
                  class="w-full sm:w-auto px-4 py-2.5 rounded border border-[var(--border-strong)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-semibold cursor-pointer transition-colors"
                >
                  Restaurar Padrões de Fábrica
                </button>
                <button
                  type="button"
                  id="bottom-clear-cache-btn"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded border border-[var(--border-strong)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-semibold cursor-pointer transition-colors"
                  title="Limpar Cache do Site e do Navegador"
                >
                  <svg class="w-3.5 h-3.5 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  <span>Limpar Cache</span>
                </button>
              </div>

              <div class="flex items-center gap-3 w-full sm:w-auto">
                <a
                  href="/"
                  class="w-full sm:w-auto px-4 py-2.5 rounded border border-[var(--border-subtle)] hover:bg-[var(--bg-surface)] text-center text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
                >
                  Cancelar
                </a>
                <button
                  type="button"
                  id="bottom-save-btn"
                  class="w-full sm:w-auto px-6 py-2.5 rounded border border-[var(--accent)] bg-[var(--accent)] hover:opacity-90 text-white dark:text-black text-xs font-bold cursor-pointer transition-opacity shadow-xs"
                >
                  Salvar Alterações
                </button>
              </div>
            </div>

          </div>

        </div>
      </main>

    </div>

    <!-- Script de Gestão com Rascunho e Salvamento Explícito -->
    <script is:inline>
      const fontsMap = {
        garamond: "'Newsreader', 'EB Garamond', 'Lora', Charter, Georgia, serif",
        lora: "'Lora', Charter, 'Bitstream Charter', Georgia, serif",
        sans: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        mono: "'JetBrains Mono', 'Courier New', Courier, monospace"
      };

      const fontLabels = {
        garamond: 'Garamond',
        lora: 'Lora',
        sans: 'Inter / Sans',
        mono: 'JetBrains Mono'
      };

      const codeFontsMap = {
        jetbrains: "'JetBrains Mono', monospace",
        fira: "'Fira Code', monospace",
        system: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        courier: "'Courier New', Courier, monospace"
      };

      const codeFontLabels = {
        jetbrains: 'JetBrains Mono',
        fira: 'Fira Code',
        system: 'SF Mono',
        courier: 'Courier New'
      };

      const codeThemeLabels = {
        mocha: 'Catppuccin Mocha',
        tokyo: 'Tokyo Night',
        dracula: 'Dracula',
        onedark: 'Atom One Dark',
        monokai: 'Monokai'
      };

      const themeColors = {
        mocha: {
          name: 'Catppuccin Mocha',
          bg: '#1e1e2e',
          headerBg: '#181825',
          border: '#313244',
          text: '#cdd6f4',
          badge: '#cba6f7',
        },
        tokyo: {
          name: 'Tokyo Night',
          bg: '#1a1b26',
          headerBg: '#16161e',
          border: '#292e42',
          text: '#c0caf5',
          badge: '#7aa2f7',
        },
        dracula: {
          name: 'Dracula',
          bg: '#282a36',
          headerBg: '#21222c',
          border: '#44475a',
          text: '#f8f8f2',
          badge: '#bd93f9',
        },
        onedark: {
          name: 'Atom One Dark',
          bg: '#282c34',
          headerBg: '#21252b',
          border: '#3b4048',
          text: '#abb2bf',
          badge: '#61afef',
        },
        monokai: {
          name: 'Monokai',
          bg: '#272822',
          headerBg: '#1e1f1c',
          border: '#3e3d32',
          text: '#f8f8f2',
          badge: '#a6e22e',
        }
      };

      const defaultFontKey = 'garamond';
      const defaultSize = '18px';
      const defaultWidth = '768px';
      const defaultCodeTheme = 'mocha';
      const defaultCodeFontKey = 'jetbrains';
      const defaultCodeSize = '13px';
      const defaultMathScriptScale = '0.64';
      const defaultMathMinSize = '10.5px';

      // 1. Estado Salvo Atualmente no Sistema
      let savedState = {
        fontKey: localStorage.getItem('study_font_key') || defaultFontKey,
        fontFamily: localStorage.getItem('study_font_family') || fontsMap[defaultFontKey],
        fontSize: localStorage.getItem('study_font_size') || defaultSize,
        maxWidth: localStorage.getItem('study_max_width') || defaultWidth,
        codeTheme: localStorage.getItem('study_code_theme') || defaultCodeTheme,
        codeFontKey: localStorage.getItem('study_code_font_key') || defaultCodeFontKey,
        codeFont: localStorage.getItem('study_code_font') || codeFontsMap[defaultCodeFontKey],
        codeSize: localStorage.getItem('study_code_size') || defaultCodeSize,
        mathScriptScale: localStorage.getItem('study_math_script_scale') || defaultMathScriptScale,
        mathMinSize: localStorage.getItem('study_math_min_size') || defaultMathMinSize
      };

      // 2. Estado de Rascunho / Demonstração (Não salvo até clicar em Salvar)
      let draftState = { ...savedState };

      function normalizePx(val) {
        if (!val) return '18px';
        val = String(val).trim();
        if (val.endsWith('rem')) {
          const num = parseFloat(val);
          return Math.round(num * 16) + 'px';
        }
        if (!val.endsWith('px')) {
          return val + 'px';
        }
        return val;
      }

      savedState.fontSize = normalizePx(savedState.fontSize);
      savedState.maxWidth = normalizePx(savedState.maxWidth);
      savedState.codeSize = normalizePx(savedState.codeSize);
      savedState.mathMinSize = normalizePx(savedState.mathMinSize);
      draftState.fontSize = normalizePx(draftState.fontSize);
      draftState.maxWidth = normalizePx(draftState.maxWidth);
      draftState.codeSize = normalizePx(draftState.codeSize);
      draftState.mathMinSize = normalizePx(draftState.mathMinSize);

      // Elementos do DOM
      const previewWrapper = document.getElementById('preview-box-wrapper');
      const previewText = document.getElementById('preview-text-content');
      const previewMeta = document.getElementById('preview-meta-info');
      const customSizeInput = document.getElementById('custom-size-input');
      const customWidthInput = document.getElementById('custom-width-input');
      const customCodeSizeInput = document.getElementById('custom-code-size-input');
      const customMathScaleInput = document.getElementById('custom-math-scale-input');
      const customMathMinInput = document.getElementById('custom-math-min-input');
      const activeMathBadge = document.getElementById('active-math-badge');
      const statusDot = document.getElementById('status-dot');
      const statusMessage = document.getElementById('status-message');
      const previewCodeCard = document.getElementById('preview-sample-code-card');
      const previewCode = document.getElementById('preview-sample-code');
      const previewCodeInner = document.getElementById('preview-sample-code-inner');

      function updatePreview() {
        if (previewText) {
          previewText.style.fontFamily = draftState.fontFamily;
          previewText.style.fontSize = draftState.fontSize;
          previewText.style.setProperty('--reader-font-family', draftState.fontFamily);
          previewText.style.setProperty('--reader-font-size', draftState.fontSize);
        }
        if (previewWrapper) {
          previewWrapper.style.maxWidth = draftState.maxWidth;
          previewWrapper.style.setProperty('--reader-font-family', draftState.fontFamily);
          previewWrapper.style.setProperty('--reader-font-size', draftState.fontSize);
          previewWrapper.style.setProperty('--katex-script-scale', draftState.mathScriptScale);
          previewWrapper.style.setProperty('--katex-min-font-size', draftState.mathMinSize);
        }
        document.documentElement.style.setProperty('--katex-script-scale', draftState.mathScriptScale);
        document.documentElement.style.setProperty('--katex-min-font-size', draftState.mathMinSize);
        if (previewMeta) {
          const fName = fontLabels[draftState.fontKey] || draftState.fontKey;
          previewMeta.textContent = `${fName} • ${draftState.fontSize} • ${draftState.maxWidth}`;
        }
        if (previewCode) {
          previewCode.style.fontFamily = draftState.codeFont;
          previewCode.style.fontSize = draftState.codeSize;
          previewCode.style.setProperty('--code-font-family', draftState.codeFont);
          previewCode.style.setProperty('--code-font-size', draftState.codeSize);
        }
        if (previewCodeInner) {
          previewCodeInner.style.fontFamily = draftState.codeFont;
          previewCodeInner.style.fontSize = draftState.codeSize;
        }

        const activeTheme = draftState.codeTheme || 'mocha';
        const tc = themeColors[activeTheme] || themeColors.mocha;

        // Atualiza atributo no elemento raiz html para acionar as classes globais do tema
        document.documentElement.setAttribute('data-code-theme', activeTheme);

        if (previewCodeCard) {
          previewCodeCard.setAttribute('data-code-theme', activeTheme);
          previewCodeCard.style.setProperty('--code-card-bg', tc.bg);
          previewCodeCard.style.setProperty('--code-card-header-bg', tc.headerBg);
          previewCodeCard.style.setProperty('--code-card-border', tc.border);
          previewCodeCard.style.setProperty('--code-card-text', tc.text);
          previewCodeCard.style.setProperty('--code-badge-color', tc.badge);
          previewCodeCard.style.backgroundColor = tc.bg;
          previewCodeCard.style.borderColor = tc.border;

          const headerEl = previewCodeCard.querySelector('.code-block-header');
          if (headerEl) {
            headerEl.style.backgroundColor = tc.headerBg;
            headerEl.style.borderBottomColor = tc.border;
          }
          const badgeEl = previewCodeCard.querySelector('.code-block-lang');
          if (badgeEl) {
            badgeEl.style.color = tc.badge;
          }
        }

        if (previewCodeInner) {
          const varName = `--shiki-${activeTheme}`;
          previewCodeInner.querySelectorAll('span').forEach((sp) => {
            const tokenColor = sp.style.getPropertyValue(varName);
            if (tokenColor) {
              sp.style.color = tokenColor;
            }
          });
        }

        if (typeof window !== 'undefined' && typeof window.__reoptimizeAcademicTables === 'function') {
          window.__reoptimizeAcademicTables();
        }
      }

      function updateUI() {
        // 1. Atualiza seleção de Fonte de Leitura
        document.querySelectorAll('.font-opt-btn').forEach((btn) => {
          const k = btn.getAttribute('data-font');
          const isDraft = k === draftState.fontKey;
          const isSaved = k === savedState.fontKey;

          const tag = btn.querySelector('.font-status-tag');
          if (tag) tag.classList.toggle('hidden', !isSaved);

          if (isDraft) {
            btn.classList.add('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.remove('border-[var(--border-subtle)]');
          } else {
            btn.classList.remove('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.add('border-[var(--border-subtle)]');
          }
        });

        const activeFontBadge = document.getElementById('active-font-badge');
        if (activeFontBadge) {
          activeFontBadge.textContent = `${fontLabels[savedState.fontKey] || savedState.fontKey} (Salvo)`;
        }

        // 2. Atualiza seleção de Tamanho de Leitura
        const numericDraftSize = parseInt(draftState.fontSize, 10) || 18;
        if (customSizeInput && document.activeElement !== customSizeInput) {
          customSizeInput.value = numericDraftSize;
        }

        document.querySelectorAll('.size-opt-btn').forEach((btn) => {
          const btnSize = normalizePx(btn.getAttribute('data-size'));
          const isDraft = btnSize === draftState.fontSize;
          const isSaved = btnSize === savedState.fontSize;

          const tag = btn.querySelector('.size-status-tag');
          if (tag) tag.classList.toggle('hidden', !isSaved);

          if (isDraft) {
            btn.classList.add('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.remove('border-[var(--border-subtle)]');
          } else {
            btn.classList.remove('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.add('border-[var(--border-subtle)]');
          }
        });

        const activeSizeBadge = document.getElementById('active-size-badge');
        if (activeSizeBadge) {
          activeSizeBadge.textContent = `${savedState.fontSize} (Salvo)`;
        }

        // 3. Atualiza seleção de Largura da Página
        const numericDraftWidth = parseInt(draftState.maxWidth, 10) || 768;
        if (customWidthInput && document.activeElement !== customWidthInput) {
          customWidthInput.value = numericDraftWidth;
        }

        document.querySelectorAll('.width-opt-btn').forEach((btn) => {
          const btnWidth = normalizePx(btn.getAttribute('data-width'));
          const isDraft = btnWidth === draftState.maxWidth;
          const isSaved = btnWidth === savedState.maxWidth;

          const tag = btn.querySelector('.width-status-tag');
          if (tag) tag.classList.toggle('hidden', !isSaved);

          if (isDraft) {
            btn.classList.add('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.remove('border-[var(--border-subtle)]');
          } else {
            btn.classList.remove('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.add('border-[var(--border-subtle)]');
          }
        });

        const activeWidthBadge = document.getElementById('active-width-badge');
        if (activeWidthBadge) {
          activeWidthBadge.textContent = `${savedState.maxWidth} (Salvo)`;
        }

        // 4. Atualiza seleção de Tema do Código
        document.querySelectorAll('.code-theme-opt-btn').forEach((btn) => {
          const t = btn.getAttribute('data-code-theme-opt');
          const isDraft = t === draftState.codeTheme;
          const isSaved = t === savedState.codeTheme;

          const tag = btn.querySelector('.code-theme-status-tag');
          if (tag) tag.classList.toggle('hidden', !isSaved);

          if (isDraft) {
            btn.classList.add('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.remove('border-[var(--border-subtle)]');
          } else {
            btn.classList.remove('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.add('border-[var(--border-subtle)]');
          }
        });

        // 5. Atualiza seleção de Fonte do Código
        document.querySelectorAll('.code-font-opt-btn').forEach((btn) => {
          const f = btn.getAttribute('data-code-font-opt');
          const isDraft = f === draftState.codeFontKey;
          const isSaved = f === savedState.codeFontKey;

          const tag = btn.querySelector('.code-font-status-tag');
          if (tag) tag.classList.toggle('hidden', !isSaved);

          if (isDraft) {
            btn.classList.add('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.remove('border-[var(--border-subtle)]');
          } else {
            btn.classList.remove('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.add('border-[var(--border-subtle)]');
          }
        });

        // 6. Atualiza seleção de Tamanho do Código
        document.querySelectorAll('.code-size-opt-btn').forEach((btn) => {
          const s = btn.getAttribute('data-code-size-opt');
          const isDraft = s === draftState.codeSize;
          const isSaved = s === savedState.codeSize;

          const tag = btn.querySelector('.code-size-status-tag');
          if (tag) tag.classList.toggle('hidden', !isSaved);

          if (isDraft) {
            btn.classList.add('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.remove('border-[var(--border-subtle)]');
          } else {
            btn.classList.remove('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.add('border-[var(--border-subtle)]');
          }
        });

        const numericDraftCodeSize = parseInt(draftState.codeSize, 10) || 13;
        if (customCodeSizeInput && document.activeElement !== customCodeSizeInput) {
          customCodeSizeInput.value = numericDraftCodeSize;
        }

        const activeCodeBadge = document.getElementById('active-code-badge');
        if (activeCodeBadge) {
          const cThemeName = codeThemeLabels[savedState.codeTheme] || savedState.codeTheme;
          const cFontName = codeFontLabels[savedState.codeFontKey] || savedState.codeFontKey;
          activeCodeBadge.textContent = `${cThemeName} • ${cFontName} • ${savedState.codeSize} (Salvo)`;
        }

        // 7. Atualiza seleção de Proporção de Subscritos/Sobrescritos
        document.querySelectorAll('.math-scale-opt-btn').forEach((btn) => {
          const sc = btn.getAttribute('data-math-scale-opt');
          const isDraft = Math.abs(parseFloat(sc) - parseFloat(draftState.mathScriptScale)) < 0.015;
          const isSaved = Math.abs(parseFloat(sc) - parseFloat(savedState.mathScriptScale)) < 0.015;

          const tag = btn.querySelector('.math-scale-status-tag');
          if (tag) tag.classList.toggle('hidden', !isSaved);

          if (isDraft) {
            btn.classList.add('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.remove('border-[var(--border-subtle)]');
          } else {
            btn.classList.remove('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.add('border-[var(--border-subtle)]');
          }
        });

        if (customMathScaleInput && document.activeElement !== customMathScaleInput) {
          customMathScaleInput.value = Math.round((parseFloat(draftState.mathScriptScale) || 0.64) * 100);
        }

        // 8. Atualiza seleção de Limite Mínimo da Fonte
        document.querySelectorAll('.math-min-opt-btn').forEach((btn) => {
          const m = btn.getAttribute('data-math-min-opt');
          const isDraft = m === draftState.mathMinSize;
          const isSaved = m === savedState.mathMinSize;

          const tag = btn.querySelector('.math-min-status-tag');
          if (tag) tag.classList.toggle('hidden', !isSaved);

          if (isDraft) {
            btn.classList.add('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.remove('border-[var(--border-subtle)]');
          } else {
            btn.classList.remove('border-2', 'border-[var(--accent)]', 'bg-[var(--accent-subtle)]');
            btn.classList.add('border-[var(--border-subtle)]');
          }
        });

        if (customMathMinInput && document.activeElement !== customMathMinInput) {
          customMathMinInput.value = parseFloat(draftState.mathMinSize) || 0;
        }

        if (activeMathBadge) {
          const pct = Math.round((parseFloat(savedState.mathScriptScale) || 0.64) * 100);
          activeMathBadge.textContent = `${pct}% • Mín ${savedState.mathMinSize} (Salvo)`;
        }

        // 9. Verifica se há alterações pendentes de salvamento
        const hasUnsavedChanges =
          draftState.fontKey !== savedState.fontKey ||
          draftState.fontSize !== savedState.fontSize ||
          draftState.maxWidth !== savedState.maxWidth ||
          draftState.codeTheme !== savedState.codeTheme ||
          draftState.codeFontKey !== savedState.codeFontKey ||
          draftState.codeSize !== savedState.codeSize ||
          draftState.mathScriptScale !== savedState.mathScriptScale ||
          draftState.mathMinSize !== savedState.mathMinSize;

        if (statusDot) {
          statusDot.className = hasUnsavedChanges
            ? 'w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse shrink-0'
            : 'w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0';
        }

        if (statusMessage) {
          statusMessage.textContent = hasUnsavedChanges
            ? 'Você possui alterações na prévia que ainda não foram salvas no site.'
            : 'As configurações exibidas abaixo estão sincronizadas com todo o site.';
        }

        updatePreview();
      }

      // Eventos de clique nas opções de Fonte
      document.querySelectorAll('.font-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const k = btn.getAttribute('data-font');
          if (k && fontsMap[k]) {
            draftState.fontKey = k;
            draftState.fontFamily = fontsMap[k];
            updateUI();
          }
        });
      });

      // Eventos de clique nos presets de Tamanho
      document.querySelectorAll('.size-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const s = btn.getAttribute('data-size');
          if (s) {
            draftState.fontSize = normalizePx(s);
            updateUI();
          }
        });
      });

      // Evento do input numérico personalizado de Tamanho
      function handleCustomSize() {
        const val = parseInt(customSizeInput?.value, 10);
        if (val && val >= 10 && val <= 40) {
          draftState.fontSize = val + 'px';
          updateUI();
        }
      }
      customSizeInput?.addEventListener('input', handleCustomSize);
      document.getElementById('apply-custom-size-btn')?.addEventListener('click', handleCustomSize);

      // Eventos de clique nos presets de Largura
      document.querySelectorAll('.width-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const w = btn.getAttribute('data-width');
          if (w) {
            draftState.maxWidth = normalizePx(w);
            updateUI();
          }
        });
      });

      // Evento do input numérico personalizado de Largura
      function handleCustomWidth() {
        const val = parseInt(customWidthInput?.value, 10);
        if (val && val >= 400 && val <= 2500) {
          draftState.maxWidth = val + 'px';
          updateUI();
        }
      }
      customWidthInput?.addEventListener('input', handleCustomWidth);
      document.getElementById('apply-custom-width-btn')?.addEventListener('click', handleCustomWidth);

      // Eventos de clique nas opções de Código: Tema
      document.querySelectorAll('.code-theme-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const t = btn.getAttribute('data-code-theme-opt');
          if (t) {
            draftState.codeTheme = t;
            updateUI();
          }
        });
      });

      // Eventos de clique nas opções de Código: Fonte
      document.querySelectorAll('.code-font-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const f = btn.getAttribute('data-code-font-opt');
          if (f && codeFontsMap[f]) {
            draftState.codeFontKey = f;
            draftState.codeFont = codeFontsMap[f];
            updateUI();
          }
        });
      });

      // Eventos de clique nas opções de Código: Tamanho
      document.querySelectorAll('.code-size-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const s = btn.getAttribute('data-code-size-opt');
          if (s) {
            draftState.codeSize = s;
            updateUI();
          }
        });
      });

      // Evento do input numérico personalizado de Tamanho do Código
      function handleCustomCodeSize() {
        const val = parseInt(customCodeSizeInput?.value, 10);
        if (val && val >= 8 && val <= 36) {
          draftState.codeSize = val + 'px';
          updateUI();
        }
      }
      customCodeSizeInput?.addEventListener('input', handleCustomCodeSize);
      document.getElementById('apply-custom-code-size-btn')?.addEventListener('click', handleCustomCodeSize);

      // Eventos de clique nas opções de Escala de Matemática
      document.querySelectorAll('.math-scale-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sc = btn.getAttribute('data-math-scale-opt');
          if (sc) {
            draftState.mathScriptScale = sc;
            updateUI();
          }
        });
      });

      function handleCustomMathScale() {
        const val = parseFloat(customMathScaleInput?.value);
        if (!isNaN(val) && val >= 30 && val <= 100) {
          draftState.mathScriptScale = (val / 100).toFixed(2);
          updateUI();
        }
      }
      customMathScaleInput?.addEventListener('input', handleCustomMathScale);
      document.getElementById('apply-custom-math-scale-btn')?.addEventListener('click', handleCustomMathScale);

      // Eventos de clique nas opções de Limite Mínimo de Matemática
      document.querySelectorAll('.math-min-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const m = btn.getAttribute('data-math-min-opt');
          if (m) {
            draftState.mathMinSize = normalizePx(m);
            updateUI();
          }
        });
      });

      function handleCustomMathMin() {
        const val = parseFloat(customMathMinInput?.value);
        if (!isNaN(val) && val >= 0 && val <= 30) {
          draftState.mathMinSize = val + 'px';
          updateUI();
        }
      }
      customMathMinInput?.addEventListener('input', handleCustomMathMin);
      document.getElementById('apply-custom-math-min-btn')?.addEventListener('click', handleCustomMathMin);

      // Função de Salvamento Global
      function saveChanges() {
        savedState = { ...draftState };

        // Persiste no localStorage
        localStorage.setItem('study_font_key', savedState.fontKey);
        localStorage.setItem('study_font_family', savedState.fontFamily);
        localStorage.setItem('study_font_size', savedState.fontSize);
        localStorage.setItem('study_max_width', savedState.maxWidth);

        localStorage.setItem('study_code_theme', savedState.codeTheme);
        localStorage.setItem('study_code_font_key', savedState.codeFontKey);
        localStorage.setItem('study_code_font', savedState.codeFont);
        localStorage.setItem('study_code_size', savedState.codeSize);

        localStorage.setItem('study_math_script_scale', savedState.mathScriptScale);
        localStorage.setItem('study_math_min_size', savedState.mathMinSize);

        // Aplica imediatamente ao documento
        const root = document.documentElement;
        root.style.setProperty('--reader-font-family', savedState.fontFamily);
        root.style.setProperty('--reader-font-size', savedState.fontSize);
        root.style.setProperty('--reader-max-width', savedState.maxWidth);

        root.setAttribute('data-code-theme', savedState.codeTheme);
        root.style.setProperty('--code-font-family', savedState.codeFont);
        root.style.setProperty('--code-font-size', savedState.codeSize);

        root.style.setProperty('--katex-script-scale', savedState.mathScriptScale);
        root.style.setProperty('--katex-min-font-size', savedState.mathMinSize);

        window.dispatchEvent(new CustomEvent('study-code-theme-changed', { detail: { theme: savedState.codeTheme } }));

        updateUI();

        // Notificação de Sucesso
        if (statusMessage) {
          statusMessage.innerHTML = '<strong class="text-emerald-600 dark:text-emerald-400">✓ Alterações salvas com sucesso!</strong> Todo o site foi atualizado.';
        }
      }

      document.getElementById('top-save-btn')?.addEventListener('click', saveChanges);
      document.getElementById('bottom-save-btn')?.addEventListener('click', saveChanges);

      // Função de Restaurar Padrões de Fábrica
      document.getElementById('reset-defaults-btn')?.addEventListener('click', () => {
        draftState = {
          fontKey: defaultFontKey,
          fontFamily: fontsMap[defaultFontKey],
          fontSize: defaultSize,
          maxWidth: defaultWidth,
          codeTheme: defaultCodeTheme,
          codeFontKey: defaultCodeFontKey,
          codeFont: codeFontsMap[defaultCodeFontKey],
          codeSize: defaultCodeSize,
          mathScriptScale: defaultMathScriptScale,
          mathMinSize: defaultMathMinSize
        };

        saveChanges();

        if (statusMessage) {
          statusMessage.innerHTML = '<strong class="text-emerald-600 dark:text-emerald-400">✓ Padrões de fábrica restaurados!</strong>';
        }
      });

      // Estatísticas do Cache do Navegador
      function updateBrowserCacheStats() {
        const statsEl = document.getElementById('browser-cache-stats');
        if (!statsEl) return;
        try {
          let count = 0;
          let bytes = 0;
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && (k.startsWith('study_cache_') || k.startsWith('study_cache_v2:'))) {
              count++;
              const val = localStorage.getItem(k) || '';
              bytes += (k.length + val.length) * 2;
            }
          }
          const kb = (bytes / 1024).toFixed(1);
          if (count === 0) {
            statsEl.textContent = '0 itens em cache (0 KB)';
          } else {
            statsEl.textContent = `${count} ${count === 1 ? 'item' : 'itens'} em cache (~${kb} KB)`;
          }
        } catch (e) {
          statsEl.textContent = 'Cache do navegador ativo';
        }
      }

      // Função de Limpeza de Cache do Site (Cliente + Servidor)
      async function performClearSiteCache() {
        const clearBtn = document.getElementById('clear-site-cache-btn');
        const bottomClearBtn = document.getElementById('bottom-clear-cache-btn');
        const clearText = document.getElementById('clear-site-cache-text');
        const feedback = document.getElementById('cache-feedback-message');
        const badge = document.getElementById('cache-status-badge');

        const setButtonsLoading = (loading) => {
          if (clearBtn) clearBtn.disabled = loading;
          if (bottomClearBtn) bottomClearBtn.disabled = loading;
          if (clearText) clearText.textContent = loading ? 'Limpando cache...' : 'Limpar Cache do Site';
          if (loading) {
            if (clearBtn) clearBtn.classList.add('opacity-75', 'cursor-wait');
            if (bottomClearBtn) bottomClearBtn.classList.add('opacity-75', 'cursor-wait');
          } else {
            if (clearBtn) clearBtn.classList.remove('opacity-75', 'cursor-wait');
            if (bottomClearBtn) bottomClearBtn.classList.remove('opacity-75', 'cursor-wait');
          }
        };

        setButtonsLoading(true);

        // 1. Limpa o cache do servidor via endpoint API
        try {
          await fetch('/api/cache/clear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
        } catch (err) {
          console.warn('[Cache Clear] Erro ao comunicar com API de cache do servidor:', err);
        }

        // 2. Limpa o cache do cliente (localStorage e sessionStorage)
        try {
          if (window.clientStudyCache && typeof window.clientStudyCache.clearAll === 'function') {
            window.clientStudyCache.clearAll();
          }
        } catch (e) {}

        try {
          const keysToRemove = [];
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (
              k &&
              (k.startsWith('study_cache_') ||
                k.startsWith('study_cache_v2:') ||
                k.startsWith('study_recent_questions_') ||
                k.startsWith('study_toc_') ||
                k.startsWith('study_manifest_'))
            ) {
              keysToRemove.push(k);
            }
          }
          keysToRemove.forEach((k) => localStorage.removeItem(k));
          localStorage.setItem('study_last_cache_bust', String(Date.now()));
        } catch (e) {}

        try {
          sessionStorage.clear();
        } catch (e) {}

        try {
          if ('caches' in window) {
            const cacheNames = await window.caches.keys();
            await Promise.all(cacheNames.map((c) => window.caches.delete(c)));
          }
        } catch (e) {}

        // 3. Atualiza UI e feedback
        if (badge) {
          badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Cache Limpo</span>';
        }

        if (feedback) {
          feedback.classList.remove('hidden');
          feedback.innerHTML = `
            <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-semibold">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Cache do site e do navegador limpos com sucesso!</span>
            </div>
            <p class="text-[var(--text-muted)] mt-1 text-[11px]">
              O armazenamento temporário foi esvaziado. A página será recarregada em instantes...
            </p>
          `;
        }

        if (statusMessage) {
          statusMessage.innerHTML = '<strong class="text-emerald-600 dark:text-emerald-400">✓ Cache do site limpo com sucesso!</strong>';
        }

        updateBrowserCacheStats();

        // 4. Recarrega a página para aplicar o estado limpo
        setTimeout(() => {
          window.location.reload();
        }, 900);
      }

      document.getElementById('clear-site-cache-btn')?.addEventListener('click', performClearSiteCache);
      document.getElementById('bottom-clear-cache-btn')?.addEventListener('click', performClearSiteCache);

      // Atualiza o contador de cache ao carregar
      updateBrowserCacheStats();

      // Inicializa a interface
      updateUI();

      // Gerenciador de Sidebar (Desktop e Mobile) nas Configurações
      const sidebarToggle = document.getElementById('mobile-sidebar-toggle');
      const sidebar = document.getElementById('settings-sidebar');
      const backdrop = document.getElementById('settings-sidebar-backdrop');
      const desktopOpenBtn = document.getElementById('desktop-sidebar-open-btn');
      const closeBtns = document.querySelectorAll('.sidebar-close-btn');

      function collapseDesktopSidebar() {
        document.documentElement.classList.add('sidebar-collapsed');
        localStorage.setItem('study_sidebar_collapsed', 'true');
      }

      function expandDesktopSidebar() {
        document.documentElement.classList.remove('sidebar-collapsed');
        localStorage.setItem('study_sidebar_collapsed', 'false');
      }

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        backdrop?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
      }

      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      }

      function handleCloseSidebar() {
        if (window.innerWidth >= 1024) {
          collapseDesktopSidebar();
        } else {
          closeSidebar();
        }
      }

      closeBtns.forEach((btn) => {
        btn.onclick = handleCloseSidebar;
      });

      if (desktopOpenBtn) {
        desktopOpenBtn.onclick = expandDesktopSidebar;
      }

      if (sidebarToggle) {
        sidebarToggle.onclick = openSidebar;
      }

      if (backdrop) {
        backdrop.onclick = closeSidebar;
      }

      sidebar?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 1024) closeSidebar();
        });
      });

      // Gestos Touch no Celular com validação estrita anti-toque acidental
      function isInsideScrollable(el) {
        if (!el || !(el instanceof Element)) return false;
        if (el.closest('.academic-table-wrapper, table, .katex-display, .katex, pre, code, [data-scrollable], .overflow-x-auto, .overflow-y-auto, [style*="overflow"]')) {
          return true;
        }
        let curr = el;
        while (curr && curr !== document.body && curr !== document.documentElement) {
          const style = window.getComputedStyle(curr);
          const ox = style.overflowX;
          const oy = style.overflowY;
          if (['auto', 'scroll'].includes(ox) && curr.scrollWidth > curr.clientWidth + 4) return true;
          if (['auto', 'scroll'].includes(oy) && curr.scrollHeight > curr.clientHeight + 4) return true;
          curr = curr.parentElement;
        }
        return false;
      }

      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartTime = 0;
      let touchStartInsideScrollable = false;

      window.addEventListener('touchstart', (e) => {
        if (window.innerWidth >= 1024) return;
        const t = e.touches[0];
        touchStartX = t.clientX;
        touchStartY = t.clientY;
        touchStartTime = Date.now();
        touchStartInsideScrollable = isInsideScrollable(e.target);
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        if (window.innerWidth >= 1024) return;
        const t = e.changedTouches[0];
        const deltaX = t.clientX - touchStartX;
        const deltaY = t.clientY - touchStartY;
        const elapsed = Date.now() - touchStartTime;

        if (touchStartInsideScrollable) return;
        if (Math.abs(deltaY) > 30 || Math.abs(deltaX) < Math.abs(deltaY) * 2.2 || elapsed > 450) return;

        const isClosed = sidebar?.classList.contains('-translate-x-full');
        const isEdgeSwipe = touchStartX <= Math.min(28, window.innerWidth * 0.08);

        if (isClosed && deltaX > 45 && isEdgeSwipe) {
          openSidebar();
        } else if (!isClosed && deltaX < -45) {
          closeSidebar();
        }
      }, { passive: true });

      // Fechar as Configurações e voltar para a página de onde veio
      function closeSettingsAndReturn() {
        // Se houver página anterior no histórico do mesmo domínio (e que não seja configurações)
        if (document.referrer && document.referrer.includes(window.location.host) && !document.referrer.includes('/configuracoes')) {
          window.location.href = document.referrer;
          return;
        }

        // Tenta voltar para a última matéria estudada
        try {
          const last = localStorage.getItem('last_visited_subject');
          if (last) {
            const parsed = JSON.parse(last);
            if (parsed && (parsed.lastUrl || parsed.url || parsed.slug)) {
              window.location.href = parsed.lastUrl || parsed.url || `/${parsed.slug}`;
              return;
            }
          }
        } catch (e) {}

        // Fallback se não houver histórico conhecido: vai para o início
        window.location.href = '/';
      }

      document.querySelectorAll('.close-settings-action').forEach((btn) => {
        btn.addEventListener('click', closeSettingsAndReturn);
      });
    </script>

    <!-- Algoritmo de Otimização Ergonômica de Tabelas Acadêmicas -->
    <script>
      import { initTableOptimizer } from '../scripts/tableOptimizer';
      initTableOptimizer();
    </script>
  </body>
