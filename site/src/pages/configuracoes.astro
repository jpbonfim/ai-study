---
import '../styles/global.css';
import HeaderActions from '../components/HeaderActions.astro';
import { MATERIAS } from '../data/materias';
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Configurações de Leitura | Cadernos de Estudo</title>

    <!-- Fontes Acadêmicas Clássicas Carregadas com Todos os Pesos -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <!-- Script inline para inicialização de tema e preferências -->
    <script is:inline>
      const savedTheme = localStorage.getItem('study_theme') || 'paper';
      const root = document.documentElement;
      root.classList.remove('theme-paper', 'theme-dark', 'theme-oled', 'dark');
      if (savedTheme === 'oled') {
        root.classList.add('dark', 'theme-oled');
      } else if (savedTheme === 'dark') {
        root.classList.add('dark', 'theme-dark');
      } else {
        root.classList.add('theme-paper');
      }

      // Aplica preferências personalizadas salvas
      const font = localStorage.getItem('study_font_family');
      const size = localStorage.getItem('study_font_size');
      const width = localStorage.getItem('study_max_width');
      if (font) root.style.setProperty('--reader-font-family', font);
      if (size) root.style.setProperty('--reader-font-size', size);
      if (width) root.style.setProperty('--reader-max-width', width);
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] transition-colors duration-200 overflow-x-hidden">
    
    <!-- CABEÇALHO MOBILE SEMPRE VISÍVEL (FIXO NO TOPO) -->
    <header class="lg:hidden fixed top-0 left-0 right-0 z-30 h-14 flex items-center justify-between px-4 border-b border-[var(--border-subtle)] bg-[var(--bg-page)]/95 backdrop-blur-md shadow-xs w-full min-w-0">
      <div class="flex items-center gap-3 min-w-0">
        <button
          id="mobile-sidebar-toggle"
          type="button"
          aria-label="Abrir Menu de Navegação"
          class="sans-ui p-1.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] shrink-0 cursor-pointer shadow-xs"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
        </button>
        <span class="font-serif text-sm font-bold truncate text-[var(--text-primary)]">
          Configurações
        </span>
      </div>
      <button
        type="button"
        class="close-settings-action sans-ui inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-semibold cursor-pointer shadow-xs transition-colors shrink-0"
        aria-label="Fechar Configurações e Voltar"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Fechar</span>
      </button>
    </header>

    <!-- Espaçador para compensar cabeçalho fixo no mobile -->
    <div class="h-14 lg:hidden w-full shrink-0" aria-hidden="true"></div>

    <div class="flex w-full min-w-0">
      
      <!-- Menu Lateral Esquerdo -->
      <aside
        id="settings-sidebar"
        class="fixed inset-y-0 left-0 z-40 w-80 max-w-[85vw] -translate-x-full lg:translate-x-0 transition-transform duration-200 border-r border-[var(--border-subtle)] bg-[var(--bg-surface)] flex flex-col justify-between overflow-y-auto p-6 space-y-6"
      >
        <div class="space-y-6">
          <div class="space-y-3 pb-5 border-b border-[var(--border-subtle)]">
            <div class="flex items-center justify-between gap-2">
              <button
                type="button"
                class="close-settings-action sans-ui inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Voltar à Leitura</span>
              </button>
              <HeaderActions />
            </div>

            <div class="pt-1">
              <span class="sans-ui text-[11px] font-mono uppercase tracking-widest text-[var(--accent)] block font-semibold">
                Painel do Estudante
              </span>
              <h2 class="font-serif text-lg font-bold text-[var(--text-primary)] leading-snug mt-1">
                Configurações
              </h2>
            </div>
          </div>

          <!-- Atalhos para Matérias -->
          <div class="space-y-3">
            <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
              Ir para Disciplina
            </div>
            <nav class="space-y-1 text-sm sans-ui">
              {MATERIAS.filter((m) => m.status === 'active').map((m) => (
                <a
                  href={`/${m.slug}`}
                  class="block px-2.5 py-1.5 rounded hover:bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
                >
                  {m.name} ({m.code})
                </a>
              ))}
            </nav>
          </div>
        </div>

        <div class="p-4 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-muted)] sans-ui">
          Preferências persistidas localmente
        </div>
      </aside>

      <!-- Overlay para Mobile quando o Menu estiver aberto -->
      <div
        id="settings-sidebar-backdrop"
        class="fixed inset-0 z-30 bg-black/50 lg:hidden hidden"
      ></div>

      <!-- Conteúdo Principal -->
      <main class="flex-1 lg:pl-80 w-full min-w-0">
        <div class="max-w-3xl mx-auto px-4 sm:px-8 lg:px-12 py-10 sm:py-16 space-y-10 w-full min-w-0">
          
          <!-- Cabeçalho -->
          <header class="pb-6 border-b border-[var(--border-strong)] space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div class="sans-ui text-xs font-mono uppercase tracking-wider text-[var(--accent)] font-semibold">
                  Personalização da Leitura
                </div>
                <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[var(--text-primary)]">
                  Configurações de Exibição
                </h1>
              </div>
              <button
                type="button"
                class="close-settings-action sans-ui inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] hover:bg-[var(--bg-subtle)] text-[var(--text-primary)] text-xs font-bold transition-all shadow-xs cursor-pointer self-start sm:self-auto shrink-0"
              >
                <svg class="w-4 h-4 text-[var(--text-secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>Fechar</span>
              </button>
            </div>
            <p class="font-serif text-base text-[var(--text-secondary)] italic">
              Ajuste a tipografia, proporções e largura de leitura. Veja a demonstração em tempo real e clique em <strong>Salvar Alterações</strong> para aplicar a todo o site.
            </p>
          </header>

          <!-- Banner de Status de Alterações (Salvas / Não Salvas) -->
          <div id="status-banner" class="sans-ui p-4 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] flex items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2">
              <span id="status-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
              <span id="status-message" class="text-[var(--text-secondary)] font-medium">
                As configurações exibidas abaixo estão sincronizadas com o site.
              </span>
            </div>
            <button
              type="button"
              id="top-save-btn"
              class="px-4 py-1.5 rounded border border-[var(--accent)] bg-[var(--accent)] hover:opacity-90 text-white dark:text-black font-semibold cursor-pointer transition-opacity shadow-xs shrink-0"
            >
              Salvar Alterações
            </button>
          </div>

          <!-- Formulário de Configurações -->
          <div class="space-y-8 sans-ui text-sm">
            
            <!-- 1. Família da Fonte -->
            <div class="p-6 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <label class="font-bold text-[var(--text-primary)] text-base block">1. Família Tipográfica</label>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Selecione o estilo de letra para os resumos e fórmulas:
                  </p>
                </div>
                <span id="active-font-badge" class="font-mono text-xs text-[var(--accent)] font-semibold bg-[var(--bg-subtle)] px-2.5 py-1 rounded border border-[var(--border-subtle)]">
                  Garamond (Salvo)
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                
                <!-- Opção Garamond / Newsreader -->
                <button
                  type="button"
                  data-font="garamond"
                  class="font-opt-btn relative p-3.5 rounded-lg border text-left transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <div class="flex items-center justify-between mb-1">
                    <span style="font-family: 'Newsreader', 'EB Garamond', Georgia, serif;" class="text-base font-bold">
                      Garamond / Newsreader
                    </span>
                    <span class="font-status-tag text-[10px] font-mono px-1.5 py-0.5 rounded uppercase font-bold text-[var(--accent)] border border-[var(--accent)] hidden">
                      Salvo
                    </span>
                  </div>
                  <div class="text-xs text-[var(--text-muted)] leading-relaxed">
                    Serif clássica de livro didático universitário e LaTeX (Padrão).
                  </div>
                </button>

                <!-- Opção Lora / Charter -->
                <button
                  type="button"
                  data-font="lora"
                  class="font-opt-btn relative p-3.5 rounded-lg border text-left transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <div class="flex items-center justify-between mb-1">
                    <span style="font-family: 'Lora', Charter, Georgia, serif;" class="text-base font-bold">
                      Lora / Charter
                    </span>
                    <span class="font-status-tag text-[10px] font-mono px-1.5 py-0.5 rounded uppercase font-bold text-[var(--accent)] border border-[var(--accent)] hidden">
                      Salvo
                    </span>
                  </div>
                  <div class="text-xs text-[var(--text-muted)] leading-relaxed">
                    Serif moderna editorial com contraste suave e leitura fluida.
                  </div>
                </button>

                <!-- Opção Inter / Sans-Serif -->
                <button
                  type="button"
                  data-font="sans"
                  class="font-opt-btn relative p-3.5 rounded-lg border text-left transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <div class="flex items-center justify-between mb-1">
                    <span style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;" class="text-base font-bold">
                      Inter / Sans-Serif
                    </span>
                    <span class="font-status-tag text-[10px] font-mono px-1.5 py-0.5 rounded uppercase font-bold text-[var(--accent)] border border-[var(--accent)] hidden">
                      Salvo
                    </span>
                  </div>
                  <div class="text-xs text-[var(--text-muted)] leading-relaxed">
                    Sans-serif contemporânea de alta legibilidade em monitores.
                  </div>
                </button>

                <!-- Opção JetBrains Mono -->
                <button
                  type="button"
                  data-font="mono"
                  class="font-opt-btn relative p-3.5 rounded-lg border text-left transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <div class="flex items-center justify-between mb-1">
                    <span style="font-family: 'JetBrains Mono', monospace;" class="text-base font-bold">
                      JetBrains Mono
                    </span>
                    <span class="font-status-tag text-[10px] font-mono px-1.5 py-0.5 rounded uppercase font-bold text-[var(--accent)] border border-[var(--accent)] hidden">
                      Salvo
                    </span>
                  </div>
                  <div class="text-xs text-[var(--text-muted)] leading-relaxed">
                    Monoespaçada técnica com alinhamento rigoroso caractere a caractere.
                  </div>
                </button>

              </div>
            </div>

            <!-- 2. Tamanho da Fonte -->
            <div class="p-6 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <label class="font-bold text-[var(--text-primary)] text-base block">2. Tamanho da Fonte</label>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Escolha um tamanho pré-definido ou digite o número em pixels que preferir:
                  </p>
                </div>
                <span id="active-size-badge" class="font-mono text-xs text-[var(--accent)] font-semibold bg-[var(--bg-subtle)] px-2.5 py-1 rounded border border-[var(--border-subtle)]">
                  18px (Salvo)
                </span>
              </div>

              <!-- Botões Pré-definidos de Tamanho -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <button
                  type="button"
                  data-size="16px"
                  class="size-opt-btn relative p-3 rounded-lg border text-center transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <span class="font-bold block text-sm">Pequeno</span>
                  <span class="text-xs text-[var(--text-muted)] font-mono">16px</span>
                  <span class="size-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                </button>

                <button
                  type="button"
                  data-size="18px"
                  class="size-opt-btn relative p-3 rounded-lg border text-center transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <span class="font-bold block text-sm">Padrão</span>
                  <span class="text-xs text-[var(--text-muted)] font-mono">18px</span>
                  <span class="size-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                </button>

                <button
                  type="button"
                  data-size="20px"
                  class="size-opt-btn relative p-3 rounded-lg border text-center transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <span class="font-bold block text-sm">Grande</span>
                  <span class="text-xs text-[var(--text-muted)] font-mono">20px</span>
                  <span class="size-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                </button>

                <button
                  type="button"
                  data-size="22px"
                  class="size-opt-btn relative p-3 rounded-lg border text-center transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <span class="font-bold block text-sm">Muito Grande</span>
                  <span class="text-xs text-[var(--text-muted)] font-mono">22px</span>
                  <span class="size-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                </button>
              </div>

              <!-- Campo Numérico Personalizado para Tamanho -->
              <div class="pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs">
                <span class="text-[var(--text-secondary)] font-medium">
                  Ou digite qualquer valor numérico:
                </span>
                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    id="custom-size-input"
                    min="12"
                    max="36"
                    step="1"
                    value="18"
                    class="w-24 px-3 py-1.5 rounded border border-[var(--border-strong)] bg-[var(--bg-page)] text-[var(--text-primary)] font-mono font-bold text-center focus:outline-none focus:border-[var(--accent)]"
                  />
                  <span class="font-mono text-[var(--text-muted)]">pixels (px)</span>
                  <button
                    type="button"
                    id="apply-custom-size-btn"
                    class="px-3 py-1.5 rounded border border-[var(--border-subtle)] bg-[var(--bg-subtle)] hover:border-[var(--accent)] font-semibold transition-colors cursor-pointer"
                  >
                    Testar
                  </button>
                </div>
              </div>
            </div>

            <!-- 3. Largura Máxima da Tela de Exibição -->
            <div class="p-6 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <label class="font-bold text-[var(--text-primary)] text-base block">3. Largura Máxima do Texto</label>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Largura da coluna central de leitura para conforto visual:
                  </p>
                </div>
                <span id="active-width-badge" class="font-mono text-xs text-[var(--accent)] font-semibold bg-[var(--bg-subtle)] px-2.5 py-1 rounded border border-[var(--border-subtle)]">
                  768px (Salvo)
                </span>
              </div>

              <!-- Botões Pré-definidos de Largura -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <button
                  type="button"
                  data-width="672px"
                  class="width-opt-btn relative p-3 rounded-lg border text-center transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <span class="font-bold block text-sm">Estreita</span>
                  <span class="text-xs text-[var(--text-muted)] font-mono">672px</span>
                  <span class="width-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                </button>

                <button
                  type="button"
                  data-width="768px"
                  class="width-opt-btn relative p-3 rounded-lg border text-center transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <span class="font-bold block text-sm">Padrão Livro</span>
                  <span class="text-xs text-[var(--text-muted)] font-mono">768px</span>
                  <span class="width-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                </button>

                <button
                  type="button"
                  data-width="896px"
                  class="width-opt-btn relative p-3 rounded-lg border text-center transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <span class="font-bold block text-sm">Ampla</span>
                  <span class="text-xs text-[var(--text-muted)] font-mono">896px</span>
                  <span class="width-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                </button>

                <button
                  type="button"
                  data-width="1088px"
                  class="width-opt-btn relative p-3 rounded-lg border text-center transition-all cursor-pointer bg-[var(--bg-page)]"
                >
                  <span class="font-bold block text-sm">Máxima</span>
                  <span class="text-xs text-[var(--text-muted)] font-mono">1088px</span>
                  <span class="width-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                </button>
              </div>

              <!-- Campo Numérico Personalizado para Largura -->
              <div class="pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs">
                <span class="text-[var(--text-secondary)] font-medium">
                  Ou digite a largura exata em pixels:
                </span>
                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    id="custom-width-input"
                    min="450"
                    max="2200"
                    step="10"
                    value="768"
                    class="w-28 px-3 py-1.5 rounded border border-[var(--border-strong)] bg-[var(--bg-page)] text-[var(--text-primary)] font-mono font-bold text-center focus:outline-none focus:border-[var(--accent)]"
                  />
                  <span class="font-mono text-[var(--text-muted)]">pixels (px)</span>
                  <button
                    type="button"
                    id="apply-custom-width-btn"
                    class="px-3 py-1.5 rounded border border-[var(--border-subtle)] bg-[var(--bg-subtle)] hover:border-[var(--accent)] font-semibold transition-colors cursor-pointer"
                  >
                    Testar
                  </button>
                </div>
              </div>
            </div>

            <!-- 4. Exibição de Código (Tema e Fonte Monoespaçada) -->
            <div class="p-6 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] space-y-6">
              <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4">
                <div>
                  <label class="font-bold text-[var(--text-primary)] text-base block">
                    4. Exibição de Blocos de Código
                  </label>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Personalize o tema visual, a fonte monoespaçada e o tamanho das fontes dos algoritmos:
                  </p>
                </div>
                <span id="active-code-badge" class="font-mono text-xs text-[var(--accent)] font-semibold bg-[var(--bg-subtle)] px-2.5 py-1 rounded border border-[var(--border-subtle)]">
                  JetBrains • 13px (Salvo)
                </span>
              </div>

              <!-- 4.1 Tema do Código -->
              <div class="space-y-2.5">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] block">
                  Tema de Cores do Código
                </span>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                  <button
                    type="button"
                    data-code-theme-opt="dark"
                    class="code-theme-opt-btn relative p-3 rounded-lg border text-left transition-all cursor-pointer bg-[var(--bg-page)]"
                  >
                    <div class="flex items-center gap-2 mb-1">
                      <span class="w-3 h-3 rounded-full bg-[#1e2227] border border-[#3d4450]"></span>
                      <span class="font-bold text-xs">Escuro</span>
                    </div>
                    <span class="text-[11px] text-[var(--text-muted)] block leading-tight">GitHub Dark</span>
                    <span class="code-theme-status-tag text-[9px] font-mono block mt-1 font-bold text-[var(--accent)] hidden">✓ Salvo</span>
                  </button>

                  <button
                    type="button"
                    data-code-theme-opt="paper"
                    class="code-theme-opt-btn relative p-3 rounded-lg border text-left transition-all cursor-pointer bg-[var(--bg-page)]"
                  >
                    <div class="flex items-center gap-2 mb-1">
                      <span class="w-3 h-3 rounded-full bg-[#f4ebd9] border border-[#c2b3a0]"></span>
                      <span class="font-bold text-xs">Papel</span>
                    </div>
