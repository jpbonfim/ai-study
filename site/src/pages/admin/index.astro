---
import '../../styles/global.css';
import HeaderActions from '../../components/HeaderActions.astro';
import { getAllUsers } from '../../lib/auth';
import { getAllPermissions } from '../../lib/permissions';
import { loadUserMaterias } from '../../data/materias';
import { queryLogs } from '../../lib/log';

const user = Astro.locals.user!;
if (user.role !== 'admin') {
  return Astro.redirect('/?error=forbidden');
}

const initialUsers = getAllUsers();
const initialPermissions = getAllPermissions();
const initialLogs = queryLogs({ limit: 30 });

// Pré-carrega as matérias de cada usuário para renderização inicial
const usersWithMaterias = initialUsers.map((u) => ({
  ...u,
  materias: loadUserMaterias(u.id).map((m) => ({
    slug: m.slug,
    name: m.name,
    code: m.code,
  })),
}));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Painel de Administração | Biblioteca Acadêmica</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const savedTheme = localStorage.getItem('study_theme') || 'paper';
      const root = document.documentElement;
      root.classList.remove('theme-paper', 'theme-dark', 'theme-oled', 'dark');
      if (savedTheme === 'oled') {
        root.classList.add('dark', 'theme-oled');
      } else if (savedTheme === 'dark') {
        root.classList.add('dark', 'theme-dark');
      } else {
        root.classList.add('theme-paper');
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] transition-colors duration-200 py-8 px-4 sm:px-8">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Cabeçalho -->
      <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--border-subtle)]">
        <div class="space-y-1">
          <div class="sans-ui flex items-center gap-2 text-xs">
            <a href="/" class="text-[var(--accent)] hover:underline flex items-center gap-1 font-semibold">
              &larr; Voltar à Biblioteca
            </a>
            <span class="text-[var(--text-muted)]">•</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[var(--accent)]/15 text-[var(--accent)]">
              ADMINISTRADOR
            </span>
          </div>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[var(--text-primary)]">
            Painel de Administração
          </h1>
          <p class="font-serif text-sm text-[var(--text-secondary)] italic">
            Gerencie usuários, permissões de compartilhamento de disciplinas e monitore logs do sistema.
          </p>
        </div>
        <HeaderActions />
      </header>

      <!-- Mensagens de Alerta Global -->
      <div id="admin-alert" class="hidden p-4 rounded-xl text-xs sans-ui" role="alert"></div>

      <!-- NAVEGAÇÃO DE ABAS -->
      <div class="flex border-b border-[var(--border-subtle)] sans-ui text-sm font-semibold gap-2 overflow-x-auto">
        <button
          type="button"
          data-tab-target="users"
          class="tab-btn px-5 py-3 border-b-2 border-[var(--accent)] text-[var(--accent)] cursor-pointer flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Usuários ({initialUsers.length})</span>
        </button>

        <button
          type="button"
          data-tab-target="permissions"
          class="tab-btn px-5 py-3 border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span>Permissões ({initialPermissions.length})</span>
        </button>

        <button
          type="button"
          data-tab-target="logs"
          class="tab-btn px-5 py-3 border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Logs de Atividade</span>
        </button>
      </div>

      <!-- ============================================================ -->
      <!-- ABA 1: GERENCIAMENTO DE USUÁRIOS                             -->
      <!-- ============================================================ -->
      <section id="tab-users" class="tab-pane space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)]">Usuários Cadastrados</h2>
            <p class="font-serif text-xs text-[var(--text-secondary)] italic">
              Cada usuário possui um repositório isolado de estudos sob <code>data/archives/&lt;user_id&gt;</code>.
            </p>
          </div>
          <button
            type="button"
            id="open-create-user-modal"
            class="sans-ui px-4 py-2 text-xs font-semibold rounded-lg border border-[var(--accent)] bg-[var(--accent)] text-white dark:text-black hover:opacity-90 transition-opacity cursor-pointer shadow-xs flex items-center gap-1.5"
          >
            <span>+ Adicionar Usuário</span>
          </button>
        </div>

        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] overflow-x-auto shadow-2xs">
          <table class="w-full text-left text-xs sans-ui">
            <thead class="bg-[var(--bg-page)] border-b border-[var(--border-subtle)] text-[var(--text-muted)] font-mono uppercase tracking-wider">
              <tr>
                <th class="p-3.5">ID</th>
                <th class="p-3.5">Usuário</th>
                <th class="p-3.5">Nome de Exibição</th>
                <th class="p-3.5">Perfil</th>
                <th class="p-3.5">Criado em</th>
                <th class="p-3.5 text-right">Ações</th>
              </tr>
            </thead>
            <tbody id="users-table-body" class="divide-y divide-[var(--border-subtle)]">
              {initialUsers.map((u) => (
                <tr class="hover:bg-[var(--bg-page)]/50 transition-colors">
                  <td class="p-3.5 font-mono text-[var(--text-muted)]">{u.id}</td>
                  <td class="p-3.5 font-bold font-mono text-[var(--text-primary)]">{u.username}</td>
                  <td class="p-3.5 text-[var(--text-secondary)]">{u.displayName}</td>
                  <td class="p-3.5">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-mono font-bold ${
                      u.role === 'admin'
                        ? 'bg-[var(--accent)]/15 text-[var(--accent)]'
                        : 'bg-[var(--bg-page)] text-[var(--text-muted)] border border-[var(--border-subtle)]'
                    }`}>
                      {u.role.toUpperCase()}
                    </span>
                  </td>
                  <td class="p-3.5 text-[var(--text-muted)] font-mono">
                    {new Date(u.createdAt).toLocaleDateString('pt-BR')}
                  </td>
                  <td class="p-3.5 text-right space-x-2">
                    <button
                      type="button"
                      onclick={`window.openEditUserModal(${u.id}, '${u.displayName}', '${u.role}')`}
                      class="text-[var(--accent)] hover:underline cursor-pointer"
                    >
                      Editar
                    </button>
                    <button
                      type="button"
                      onclick={`window.openChangePasswordModal(${u.id}, '${u.username}')`}
                      class="text-[var(--text-secondary)] hover:underline cursor-pointer"
                    >
                      Senha
                    </button>
                    {u.id !== user.id && (
                      <button
                        type="button"
                        onclick={`window.handleDeleteUser(${u.id}, '${u.username}')`}
                        class="text-red-500 hover:underline cursor-pointer"
                      >
                        Excluir
                      </button>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- ABA 2: PERMISSÕES DE MATÉRIAS                                -->
      <!-- ============================================================ -->
      <section id="tab-permissions" class="tab-pane hidden space-y-8">
        <div>
          <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)]">Permissões de Compartilhamento</h2>
          <p class="font-serif text-xs text-[var(--text-secondary)] italic">
            Conceda acesso a uma disciplina de um usuário para outro. Se o código da disciplina coincidir, o usuário verá o toggle de tags cruzadas.
          </p>
        </div>

        <!-- Formulário de Concessão de Permissão -->
        <div class="p-6 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] space-y-4 shadow-2xs">
          <span class="sans-ui text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
            Conceder Novo Acesso
          </span>

          <form id="grant-permission-form" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="space-y-1">
              <label class="block sans-ui text-xs font-semibold text-[var(--text-secondary)]">
                1. Usuário de Origem (Dono):
              </label>
              <select
                id="perm-owner-select"
                required
                class="sans-ui w-full px-3 py-2 text-xs rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
              >
                <option value="">Selecione o dono...</option>
                {usersWithMaterias.map((u) => (
                  <option value={u.id} data-materias={JSON.stringify(u.materias)}>
                    {u.displayName} (@{u.username}) — {u.materias.length} matéria(s)
                  </option>
                ))}
              </select>
            </div>

            <div class="space-y-1">
              <label class="block sans-ui text-xs font-semibold text-[var(--text-secondary)]">
                2. Matéria a Compartilhar:
              </label>
              <select
                id="perm-materia-select"
                required
                disabled
                class="sans-ui w-full px-3 py-2 text-xs rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)] disabled:opacity-50"
              >
                <option value="">Selecione primeiro o dono...</option>
              </select>
            </div>

            <div class="space-y-1">
              <label class="block sans-ui text-xs font-semibold text-[var(--text-secondary)]">
                3. Usuário Beneficiado:
              </label>
              <select
                id="perm-granted-select"
                required
                class="sans-ui w-full px-3 py-2 text-xs rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
              >
                <option value="">Selecione quem receberá acesso...</option>
                {initialUsers.map((u) => (
                  <option value={u.id}>{u.displayName} (@{u.username})</option>
                ))}
              </select>
            </div>

            <div class="sm:col-span-3 pt-2">
              <button
                type="submit"
                id="submit-perm-btn"
                class="sans-ui py-2.5 px-5 text-xs font-semibold rounded-lg border border-[var(--accent)] bg-[var(--accent)] text-white dark:text-black hover:opacity-90 transition-opacity cursor-pointer shadow-xs"
              >
                Conceder Permissão de Acesso
              </button>
            </div>
          </form>
        </div>

        <!-- Tabela de Permissões Existentes -->
        <div class="space-y-3">
          <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
            Permissões Ativas no Sistema
          </div>

          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] overflow-x-auto shadow-2xs">
            <table class="w-full text-left text-xs sans-ui">
              <thead class="bg-[var(--bg-page)] border-b border-[var(--border-subtle)] text-[var(--text-muted)] font-mono uppercase tracking-wider">
                <tr>
                  <th class="p-3.5">Código da Disciplina</th>
                  <th class="p-3.5">Slug</th>
                  <th class="p-3.5">Dono Original</th>
                  <th class="p-3.5">Acesso Concedido Para</th>
                  <th class="p-3.5">Concedido em</th>
                  <th class="p-3.5 text-right">Ação</th>
                </tr>
              </thead>
              <tbody id="permissions-table-body" class="divide-y divide-[var(--border-subtle)]">
                {initialPermissions.map((p) => (
                  <tr class="hover:bg-[var(--bg-page)]/50 transition-colors">
                    <td class="p-3.5 font-mono font-bold text-[var(--accent)]">{p.subject_code}</td>
                    <td class="p-3.5 font-mono text-[var(--text-muted)]">{p.materia_slug}</td>
                    <td class="p-3.5 text-[var(--text-primary)]">
                      {p.owner_display_name} <span class="text-[var(--text-muted)] font-mono">(@{p.owner_username})</span>
                    </td>
                    <td class="p-3.5 text-[var(--text-primary)]">
                      {p.granted_display_name} <span class="text-[var(--text-muted)] font-mono">(@{p.granted_username})</span>
                    </td>
                    <td class="p-3.5 text-[var(--text-muted)] font-mono">
                      {new Date(p.granted_at).toLocaleDateString('pt-BR')}
                    </td>
                    <td class="p-3.5 text-right">
                      <button
                        type="button"
                        onclick={`window.handleRevokePermission(${p.id})`}
                        class="text-red-500 hover:underline cursor-pointer"
                      >
                        Revogar
                      </button>
                    </td>
                  </tr>
                ))}
                {initialPermissions.length === 0 && (
                  <tr>
                    <td colspan="6" class="p-6 text-center text-[var(--text-muted)] italic">
                      Nenhuma permissão cruzada cadastrada até o momento.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- ABA 3: LOGS DE ATIVIDADE                                     -->
      <!-- ============================================================ -->
      <section id="tab-logs" class="tab-pane hidden space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)]">Logs de Auditoria e Atividade</h2>
            <p class="font-serif text-xs text-[var(--text-secondary)] italic">
              Registros detalhados de logins, acessos a cadernos, uploads e ações administrativas com retenção automática de 90 dias.
            </p>
          </div>
          <div class="sans-ui text-xs text-[var(--text-muted)] font-mono" id="logs-total-indicator">
            Total: {initialLogs.total} eventos
          </div>
        </div>

        <!-- Barra de Filtros -->
        <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] space-y-3 shadow-2xs">
          <form id="logs-filter-form" class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs sans-ui">
            <div>
              <label class="block font-semibold text-[var(--text-muted)] mb-1">Usuário:</label>
              <select
                id="filter-log-user"
                class="w-full px-2.5 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
              >
                <option value="">Todos os usuários</option>
                {initialUsers.map((u) => (
                  <option value={u.id}>{u.displayName} (@{u.username})</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block font-semibold text-[var(--text-muted)] mb-1">Ação:</label>
              <select
                id="filter-log-action"
                class="w-full px-2.5 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
              >
                <option value="">Todas as ações</option>
                <option value="login">Login com Sucesso</option>
                <option value="login_failed">Tentativa de Login Falha</option>
                <option value="logout">Logout</option>
                <option value="page_view">Acesso a Página</option>
                <option value="upload_archive">Upload de Archive</option>
                <option value="upload_materia">Upload de Matéria</option>
                <option value="download_archive">Download de Archive</option>
                <option value="download_materia">Download de Matéria</option>
                <option value="admin_create_user">Admin: Criar Usuário</option>
                <option value="admin_grant_permission">Admin: Conceder Permissão</option>
                <option value="admin_revoke_permission">Admin: Revogar Permissão</option>
              </select>
            </div>

            <div>
              <label class="block font-semibold text-[var(--text-muted)] mb-1">Buscar Detalhes / IP:</label>
              <input
                type="text"
                id="filter-log-search"
                placeholder="ex: pds, IP, etc..."
                class="w-full px-2.5 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
              />
            </div>

            <div class="flex items-end gap-2">
              <button
                type="submit"
                class="flex-1 py-1.5 px-3 rounded-lg border border-[var(--accent)] bg-[var(--accent)] text-white dark:text-black font-semibold hover:opacity-90 cursor-pointer"
              >
                Filtrar
              </button>
              <button
                type="button"
                id="reset-logs-filter"
                class="py-1.5 px-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
              >
                Limpar
              </button>
            </div>
          </form>
        </div>

        <!-- Tabela de Logs -->
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] overflow-x-auto shadow-2xs">
          <table class="w-full text-left text-xs sans-ui">
            <thead class="bg-[var(--bg-page)] border-b border-[var(--border-subtle)] text-[var(--text-muted)] font-mono uppercase tracking-wider">
              <tr>
                <th class="p-3">Data / Hora</th>
                <th class="p-3">Usuário</th>
                <th class="p-3">Ação</th>
                <th class="p-3">Detalhes</th>
                <th class="p-3">IP / Origem</th>
              </tr>
            </thead>
            <tbody id="logs-table-body" class="divide-y divide-[var(--border-subtle)] font-mono text-[11px]">
              {initialLogs.logs.map((log: any) => (
                <tr class="hover:bg-[var(--bg-page)]/50 transition-colors">
                  <td class="p-3 text-[var(--text-muted)] whitespace-nowrap">
                    {new Date(log.created_at).toLocaleString('pt-BR')}
                  </td>
                  <td class="p-3 font-bold text-[var(--text-primary)] whitespace-nowrap">
                    {log.username ? `@${log.username}` : 'Anônimo / Sistema'}
                  </td>
                  <td class="p-3 whitespace-nowrap">
                    <span class="px-2 py-0.5 rounded text-[10px] bg-[var(--bg-page)] border border-[var(--border-subtle)] text-[var(--text-secondary)]">
                      {log.action}
                    </span>
                  </td>
                  <td class="p-3 font-sans text-xs text-[var(--text-secondary)] max-w-xs truncate" title={log.details || ''}>
                    {log.details || '—'}
                  </td>
                  <td class="p-3 text-[var(--text-muted)] whitespace-nowrap">
                    {log.ip_address || '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Paginação de Logs -->
        <div class="flex items-center justify-between text-xs sans-ui text-[var(--text-muted)] pt-2">
          <button
            type="button"
            id="logs-prev-btn"
            disabled
            class="px-3 py-1.5 rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:text-[var(--text-primary)] cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
          >
            &larr; Página Anterior
          </button>
          <span id="logs-page-indicator">Página 1</span>
          <button
            type="button"
            id="logs-next-btn"
            class="px-3 py-1.5 rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:text-[var(--text-primary)] cursor-pointer"
          >
            Próxima Página &rarr;
          </button>
        </div>
      </section>

    </div>

    <!-- ============================================================ -->
    <!-- MODAL: NOVO USUÁRIO                                          -->
    <!-- ============================================================ -->
    <div id="modal-create-user" class="fixed inset-0 z-50 bg-black/60 hidden flex items-center justify-center p-4">
      <div class="max-w-md w-full p-6 sm:p-8 rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-surface)] space-y-6 shadow-xl">
        <div class="space-y-1">
          <h3 class="font-serif text-xl font-bold text-[var(--text-primary)]">Criar Novo Usuário</h3>
          <p class="font-serif text-xs text-[var(--text-secondary)] italic">
            O novo usuário terá sua própria pasta de cadernos isolada no servidor.
          </p>
        </div>

        <form id="form-create-user" class="space-y-4 text-xs sans-ui">
          <div class="space-y-1">
            <label class="block font-semibold text-[var(--text-secondary)]">Nome de Usuário (login):</label>
            <input
              type="text"
              name="username"
              required
              placeholder="ex: joao.silva"
              pattern="^[a-zA-Z0-9._-]+$"
              class="w-full px-3 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)] font-mono"
            />
          </div>

          <div class="space-y-1">
            <label class="block font-semibold text-[var(--text-secondary)]">Nome de Exibição:</label>
            <input
              type="text"
              name="displayName"
              required
              placeholder="ex: João Silva"
              class="w-full px-3 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
            />
          </div>

          <div class="space-y-1">
            <label class="block font-semibold text-[var(--text-secondary)]">Senha Inicial:</label>
            <input
              type="password"
              name="password"
              required
              minlength="6"
              placeholder="mínimo 6 caracteres"
              class="w-full px-3 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
            />
          </div>

          <div class="space-y-1">
            <label class="block font-semibold text-[var(--text-secondary)]">Perfil de Acesso:</label>
            <select
              name="role"
              class="w-full px-3 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
            >
              <option value="normal">Normal (Estudante)</option>
              <option value="admin">Administrador do Sistema</option>
            </select>
          </div>

          <div class="flex items-center justify-end gap-2 pt-3">
            <button
              type="button"
              id="close-create-user-modal"
              class="px-4 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] hover:text-[var(--text-primary)] cursor-pointer"
            >
              Cancelar
            </button>
            <button
              type="submit"
              class="px-4 py-2 rounded-lg border border-[var(--accent)] bg-[var(--accent)] text-white dark:text-black font-semibold hover:opacity-90 cursor-pointer"
            >
              Salvar Usuário
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- MODAL: ALTERAR SENHA                                         -->
    <!-- ============================================================ -->
    <div id="modal-change-password" class="fixed inset-0 z-50 bg-black/60 hidden flex items-center justify-center p-4">
      <div class="max-w-md w-full p-6 sm:p-8 rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-surface)] space-y-6 shadow-xl">
        <div class="space-y-1">
          <h3 class="font-serif text-xl font-bold text-[var(--text-primary)]">Redefinir Senha</h3>
          <p id="password-modal-subtitle" class="font-serif text-xs text-[var(--text-secondary)] italic"></p>
        </div>

        <form id="form-change-password" class="space-y-4 text-xs sans-ui">
          <input type="hidden" id="password-user-id" />
          <div class="space-y-1">
            <label class="block font-semibold text-[var(--text-secondary)]">Nova Senha:</label>
            <input
              type="password"
              id="new-password-input"
              required
              minlength="6"
              placeholder="mínimo 6 caracteres"
              class="w-full px-3 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
            />
          </div>

          <div class="flex items-center justify-end gap-2 pt-3">
            <button
              type="button"
              id="close-password-modal"
              class="px-4 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] hover:text-[var(--text-primary)] cursor-pointer"
            >
              Cancelar
            </button>
            <button
              type="submit"
              class="px-4 py-2 rounded-lg border border-[var(--accent)] bg-[var(--accent)] text-white dark:text-black font-semibold hover:opacity-90 cursor-pointer"
            >
              Atualizar Senha
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Script de Gestão de Abas, Modais e Requisições -->
    <script is:inline>
      // 1. Gestão de Abas
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabPanes = document.querySelectorAll('.tab-pane');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab-target');
          tabBtns.forEach((b) => {
            b.classList.remove('border-[var(--accent)]', 'text-[var(--accent)]');
            b.classList.add('border-transparent', 'text-[var(--text-muted)]');
          });
          btn.classList.remove('border-transparent', 'text-[var(--text-muted)]');
          btn.classList.add('border-[var(--accent)]', 'text-[var(--accent)]');

          tabPanes.forEach((pane) => {
            if (pane.id === `tab-${target}`) {
              pane.classList.remove('hidden');
            } else {
              pane.classList.add('hidden');
            }
          });
        });
      });

      function showAlert(type, msg) {
        const el = document.getElementById('admin-alert');
        if (!el) return;
        el.className = `p-4 rounded-xl text-xs sans-ui border ${
          type === 'error'
            ? 'bg-red-500/10 text-red-600 border-red-500/30'
            : 'bg-emerald-500/10 text-emerald-600 border-emerald-500/30'
        }`;
        el.textContent = msg;
        el.classList.remove('hidden');
        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        setTimeout(() => el.classList.add('hidden'), 5000);
      }

      // 2. Modais de Usuário
      const createModal = document.getElementById('modal-create-user');
      const openCreateBtn = document.getElementById('open-create-user-modal');
      const closeCreateBtn = document.getElementById('close-create-user-modal');
      const formCreate = document.getElementById('form-create-user');

      openCreateBtn?.addEventListener('click', () => createModal?.classList.remove('hidden'));
      closeCreateBtn?.addEventListener('click', () => createModal?.classList.add('hidden'));

      formCreate?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(formCreate);
        const payload = Object.fromEntries(fd.entries());

        try {
          const res = await fetch('/admin/api/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showAlert('success', `Usuário "${data.user.username}" criado com sucesso!`);
            createModal?.classList.add('hidden');
            formCreate.reset();
            setTimeout(() => window.location.reload(), 800);
          } else {
            alert(data.error || 'Erro ao criar usuário.');
          }
        } catch {
          alert('Erro de conexão ao criar usuário.');
        }
      });

      // 3. Modal de Senha
      const passModal = document.getElementById('modal-change-password');
      const passSubtitle = document.getElementById('password-modal-subtitle');
      const passUserId = document.getElementById('password-user-id');
      const passInput = document.getElementById('new-password-input');
      const closePassBtn = document.getElementById('close-password-modal');
      const formPass = document.getElementById('form-change-password');

      window.openChangePasswordModal = (id, username) => {
        if (passUserId) passUserId.value = String(id);
        if (passSubtitle) passSubtitle.textContent = `Defina a nova senha para o usuário @${username}`;
        passModal?.classList.remove('hidden');
      };

      closePassBtn?.addEventListener('click', () => passModal?.classList.add('hidden'));

      formPass?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = passUserId?.value;
        const newPassword = passInput?.value;

        try {
          const res = await fetch('/admin/api/users', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, newPassword }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showAlert('success', 'Senha atualizada com sucesso!');
            passModal?.classList.add('hidden');
            if (passInput) passInput.value = '';
          } else {
            alert(data.error || 'Erro ao alterar senha.');
          }
        } catch {
          alert('Erro de conexão ao alterar senha.');
        }
      });

      // 4. Excluir Usuário
      window.handleDeleteUser = async (id, username) => {
        if (!confirm(`Tem certeza que deseja EXCLUIR permanentemente o usuário @${username} e todos os seus cadernos? Esta ação não pode ser desfeita.`)) {
          return;
        }

        try {
          const res = await fetch(`/admin/api/users?id=${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            showAlert('success', `Usuário @${username} excluído com sucesso.`);
            setTimeout(() => window.location.reload(), 800);
          } else {
            alert(data.error || 'Erro ao excluir usuário.');
          }
        } catch {
          alert('Erro de conexão ao excluir usuário.');
        }
      };

      // 5. Permissões - Dono Selecionado atualiza Matérias
      const ownerSelect = document.getElementById('perm-owner-select');
      const materiaSelect = document.getElementById('perm-materia-select');

      ownerSelect?.addEventListener('change', () => {
        const selectedOpt = ownerSelect.options[ownerSelect.selectedIndex];
        const rawMaterias = selectedOpt.getAttribute('data-materias');
        if (!rawMaterias) {
          if (materiaSelect) {
            materiaSelect.innerHTML = '<option value="">Selecione primeiro o dono...</option>';
            materiaSelect.disabled = true;
          }
          return;
        }

        try {
          const mats = JSON.parse(rawMaterias);
          if (mats.length === 0) {
            materiaSelect.innerHTML = '<option value="">Este usuário não tem matérias cadastradas</option>';
            materiaSelect.disabled = true;
          } else {
            materiaSelect.innerHTML = '<option value="">Selecione a matéria...</option>' +
              mats.map((m) => `<option value="${m.slug}" data-code="${m.code}">${m.name} (${m.code})</option>`).join('');
            materiaSelect.disabled = false;
          }
        } catch {
          materiaSelect.disabled = true;
        }
      });

      // Conceder Permissão
      const formGrant = document.getElementById('grant-permission-form');
      formGrant?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const ownerUserId = ownerSelect?.value;
        const grantedUserId = document.getElementById('perm-granted-select')?.value;
        const selectedMatOpt = materiaSelect?.options[materiaSelect.selectedIndex];
        const materiaSlug = selectedMatOpt?.value;
        const subjectCode = selectedMatOpt?.getAttribute('data-code');

        if (!ownerUserId || !grantedUserId || !materiaSlug || !subjectCode) {
          alert('Preencha todos os campos da permissão.');
          return;
        }

        if (ownerUserId === grantedUserId) {
          alert('O dono e o beneficiado não podem ser a mesma pessoa.');
          return;
        }

        try {
          const res = await fetch('/admin/api/permissions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ownerUserId, grantedUserId, subjectCode, materiaSlug }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showAlert('success', 'Permissão concedida com sucesso!');
            setTimeout(() => window.location.reload(), 800);
          } else {
            alert(data.error || 'Erro ao conceder permissão.');
          }
        } catch {
          alert('Erro de conexão ao conceder permissão.');
        }
      });

      // Revogar Permissão
      window.handleRevokePermission = async (id) => {
        if (!confirm('Deseja realmente revogar esta permissão de acesso?')) return;

        try {
          const res = await fetch(`/admin/api/permissions?id=${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            showAlert('success', 'Permissão revogada com sucesso.');
            setTimeout(() => window.location.reload(), 800);
          } else {
            alert(data.error || 'Erro ao revogar permissão.');
          }
        } catch {
          alert('Erro de conexão ao revogar permissão.');
        }
      };

      // 6. Logs de Atividade - Filtros e Paginação
      let currentLogPage = 1;
      const logsFilterForm = document.getElementById('logs-filter-form');
      const logsTableBody = document.getElementById('logs-table-body');
      const prevLogBtn = document.getElementById('logs-prev-btn');
      const nextLogBtn = document.getElementById('logs-next-btn');
      const pageIndicator = document.getElementById('logs-page-indicator');
      const totalIndicator = document.getElementById('logs-total-indicator');

      async function fetchLogs(page = 1) {
        const userId = document.getElementById('filter-log-user')?.value || '';
        const action = document.getElementById('filter-log-action')?.value || '';
        const search = document.getElementById('filter-log-search')?.value || '';

        const params = new URLSearchParams({
          page: String(page),
          limit: '30',
        });
        if (userId) params.set('user_id', userId);
        if (action) params.set('action', action);
        if (search) params.set('search', search);

        try {
          const res = await fetch(`/admin/api/logs?${params.toString()}`);
          const data = await res.json();

          if (res.ok && data.success) {
            currentLogPage = page;
            renderLogsTable(data.logs);
            if (pageIndicator) pageIndicator.textContent = `Página ${page} de ${Math.ceil(data.total / 30) || 1}`;
            if (totalIndicator) totalIndicator.textContent = `Total: ${data.total} eventos`;

            if (prevLogBtn) prevLogBtn.disabled = page <= 1;
            if (nextLogBtn) nextLogBtn.disabled = page * 30 >= data.total;
          }
        } catch (e) {
          console.error('Erro ao carregar logs:', e);
        }
      }

      function renderLogsTable(logs) {
        if (!logsTableBody) return;
        if (logs.length === 0) {
          logsTableBody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-[var(--text-muted)] italic font-sans">Nenhum evento registrado com os filtros atuais.</td></tr>';
          return;
        }

        logsTableBody.innerHTML = logs.map((log) => `
          <tr class="hover:bg-[var(--bg-page)]/50 transition-colors">
            <td class="p-3 text-[var(--text-muted)] whitespace-nowrap">
              ${new Date(log.created_at).toLocaleString('pt-BR')}
            </td>
            <td class="p-3 font-bold text-[var(--text-primary)] whitespace-nowrap">
              ${log.username ? '@' + log.username : 'Anônimo / Sistema'}
            </td>
            <td class="p-3 whitespace-nowrap">
              <span class="px-2 py-0.5 rounded text-[10px] bg-[var(--bg-page)] border border-[var(--border-subtle)] text-[var(--text-secondary)]">
                ${log.action}
              </span>
            </td>
            <td class="p-3 font-sans text-xs text-[var(--text-secondary)] max-w-xs truncate" title="${log.details || ''}">
              ${log.details || '—'}
            </td>
            <td class="p-3 text-[var(--text-muted)] whitespace-nowrap">
              ${log.ip_address || '—'}
            </td>
          </tr>
        `).join('');
      }

      logsFilterForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        fetchLogs(1);
      });

      document.getElementById('reset-logs-filter')?.addEventListener('click', () => {
        logsFilterForm?.reset();
        fetchLogs(1);
      });

      prevLogBtn?.addEventListener('click', () => {
        if (currentLogPage > 1) fetchLogs(currentLogPage - 1);
      });

      nextLogBtn?.addEventListener('click', () => {
        fetchLogs(currentLogPage + 1);
      });
    </script>
  </body>
</html>
