---
export const prerender = false;

import AcademicLayout, { type TagOption } from '../../../layouts/AcademicLayout.astro';
import QuestionToggle from '../../../components/QuestionToggle.astro';
import Theory from '../../../components/Theory.astro';
import Resolution from '../../../components/Resolution.astro';
import { getMateria, formatTag, loadAllAccessibleMaterias } from '../../../data/materias';
import { loadUserChapters, loadUserQuestions, type ChapterItem, type QuestionItem } from '../../../lib/mdx-runtime';
import { hasPermissionToSubject } from '../../../lib/permissions';

const user = Astro.locals.user!;
const { materia: materiaSlug, slug } = Astro.params;
const ownerParam = Astro.url.searchParams.get('owner');

if (!materiaSlug || !slug) {
  return Astro.redirect('/');
}

const { own, shared } = loadAllAccessibleMaterias(user.id);
let primaryOwnerId = user.id;
let materia = own.find((m) => m.slug === materiaSlug);

if (ownerParam) {
  const parsedOwner = parseInt(ownerParam, 10);
  const foundShared = shared.find((m) => m.slug === materiaSlug && m.ownerUserId === parsedOwner);
  if (foundShared || user.role === 'admin' || hasPermissionToSubject(user.id, parsedOwner, materiaSlug)) {
    primaryOwnerId = parsedOwner;
    materia = foundShared || getMateria(materiaSlug, parsedOwner);
  }
} else if (!materia) {
  const foundShared = shared.find((m) => m.slug === materiaSlug);
  if (foundShared) {
    primaryOwnerId = foundShared.ownerUserId!;
    materia = foundShared;
  }
}

if (!materia) {
  return Astro.redirect('/?error=materia_nao_encontrada');
}

// Carrega capítulos e questões do dono principal
const primaryChapters = loadUserChapters(primaryOwnerId, materiaSlug);
const primaryQuestoes = loadUserQuestions(primaryOwnerId, materiaSlug);

// Busca outras fontes acessíveis com o mesmo código acadêmico
const canonicalCode = (materia.code || '').trim().toUpperCase();

interface OtherSource {
  ownerUserId: number;
  ownerDisplayName: string;
  ownerUsername: string;
  materiaSlug: string;
  chapters: ChapterItem[];
  questions: QuestionItem[];
}

const otherSources: OtherSource[] = [];

if (canonicalCode) {
  if (user.id !== primaryOwnerId) {
    const ownMatch = own.find((m) => (m.code || '').trim().toUpperCase() === canonicalCode);
    if (ownMatch) {
      otherSources.push({
        ownerUserId: user.id,
        ownerDisplayName: user.displayName,
        ownerUsername: user.username,
        materiaSlug: ownMatch.slug,
        chapters: loadUserChapters(user.id, ownMatch.slug),
        questions: loadUserQuestions(user.id, ownMatch.slug),
      });
    }
  }

  for (const s of shared) {
    if (s.ownerUserId && s.ownerUserId !== primaryOwnerId && (s.code || '').trim().toUpperCase() === canonicalCode) {
      otherSources.push({
        ownerUserId: s.ownerUserId,
        ownerDisplayName: s.ownerDisplayName || s.ownerUsername || `Usuário ${s.ownerUserId}`,
        ownerUsername: s.ownerUsername || '',
        materiaSlug: s.slug,
        chapters: loadUserChapters(s.ownerUserId, s.slug),
        questions: loadUserQuestions(s.ownerUserId, s.slug),
      });
    }
  }
}

const hasOtherUsersTags = otherSources.length > 0;

// Localiza a questão: primeiro tenta no dono principal, depois nas outras fontes
let questao: QuestionItem | undefined = primaryQuestoes.find((q) => q.id === slug);
let questionIsFromOther = false;
let questionOwnerDisplayName = '';

if (!questao) {
  for (const src of otherSources) {
    const found = src.questions.find((q) => q.id === slug);
    if (found) {
      questao = found;
      questionIsFromOther = true;
      questionOwnerDisplayName = src.ownerDisplayName;
      break;
    }
  }
}

if (!questao) {
  return Astro.redirect(`/${materiaSlug}/questoes?error=questao_nao_encontrada`);
}

// Coleta todas as tags únicas
const ownRawTags = [
  ...new Set([
    ...primaryChapters.flatMap((c) => c.tags || []),
    ...primaryQuestoes.flatMap((q) => q.tags || []),
  ]),
];

const availableTags: TagOption[] = ownRawTags.map((tagId) => ({
  id: tagId,
  label: formatTag(tagId),
  chaptersCount: primaryChapters.filter((c) => (c.tags || []).includes(tagId)).length,
  questionsCount: primaryQuestoes.filter((q) => (q.tags || []).includes(tagId)).length,
  isFromOtherUser: false,
}));

for (const src of otherSources) {
  const srcTags = [
    ...new Set([
      ...src.chapters.flatMap((c) => c.tags || []),
      ...src.questions.flatMap((q) => q.tags || []),
    ]),
  ];

  for (const t of srcTags) {
    const uniqueKey = `user_${src.ownerUserId}::${t}`;
    availableTags.push({
      id: uniqueKey,
      label: formatTag(t),
      chaptersCount: src.chapters.filter((c) => (c.tags || []).includes(t)).length,
      questionsCount: src.questions.filter((q) => (q.tags || []).includes(t)).length,
      isFromOtherUser: true,
      ownerUserId: src.ownerUserId,
      ownerDisplayName: src.ownerDisplayName,
      ownerUsername: src.ownerUsername,
    });
  }
}

const primaryRawTag = questao.tags?.[0] || 'teste-1';
const activeTagKey = questionIsFromOther ? `user_${questao.ownerUserId}::${primaryRawTag}` : primaryRawTag;

// Capítulos e Sumário
const chaptersToRender = [
  ...primaryChapters.map((c) => ({
    ...c,
    isFromOther: false,
    matchTags: [...(c.tags || []), ...((c.tags || []).map((t) => `user_${primaryOwnerId}::${t}`))],
  })),
  ...otherSources.flatMap((src) =>
    src.chapters.map((c) => ({
      ...c,
      isFromOther: true,
      ownerDisplayName: src.ownerDisplayName,
      matchTags: (c.tags || []).map((t) => `user_${src.ownerUserId}::${t}`),
    }))
  ),
];

const toc = chaptersToRender.map((resumo) => {
  const isMateria = resumo.type === 'materia';
  const prefix = resumo.isFromOther ? `other-${resumo.ownerUserId}-` : '';
  const chapId = isMateria ? `${prefix}cap-materia-${resumo.chapter}` : `${prefix}cap-${resumo.chapter}`;
  return {
    id: chapId,
    title: `Capítulo ${resumo.chapter}: ${resumo.topic}${resumo.isFromOther ? ` (${resumo.ownerDisplayName})` : ''}`,
    subsections: resumo.sections || [],
    tags: resumo.matchTags,
    type: (resumo.type || 'questoes') as 'materia' | 'questoes',
    isFromOther: resumo.isFromOther,
  };
});

// Todas as questões renderizáveis
interface RenderableQuestion extends QuestionItem {
  isFromOther: boolean;
  ownerDisplayName?: string;
  matchTags: string[];
}

const allQuestionsToRender: RenderableQuestion[] = [
  ...primaryQuestoes.map((q) => ({
    ...q,
    isFromOther: false,
    matchTags: [...(q.tags || []), ...((q.tags || []).map((t) => `user_${primaryOwnerId}::${t}`))],
  })),
  ...otherSources.flatMap((src) =>
    src.questions.map((q) => ({
      ...q,
      isFromOther: true,
      ownerDisplayName: src.ownerDisplayName,
      matchTags: (q.tags || []).map((t) => `user_${src.ownerUserId}::${t}`),
    }))
  ),
];

const questionsLinks = allQuestionsToRender.map((q) => ({
  id: q.id,
  title: q.title,
  exam: q.exam,
  year: q.year,
  tags: q.matchTags,
  ownerUserId: q.ownerUserId,
  ownerDisplayName: q.ownerDisplayName,
}));

// Navegação anterior e próxima dentro do escopo relevante (do mesmo dono da questão)
const scopeQuestoes = questionIsFromOther
  ? (otherSources.find(s => s.ownerUserId === questao!.ownerUserId)?.questions || [questao])
  : primaryQuestoes;

const currentIndex = scopeQuestoes.findIndex((q) => q.id === questao.id);
const prevQ = currentIndex > 0 ? scopeQuestoes[currentIndex - 1] : null;
const nextQ = currentIndex < scopeQuestoes.length - 1 ? scopeQuestoes[currentIndex + 1] : null;

const formattedImages = questao.images || [];
---

<AcademicLayout
  title={`${questao.title} | ${materia.name}`}
  materia={materia}
  availableTags={availableTags}
  hasOtherUsersTags={hasOtherUsersTags}
  activeTag={activeTagKey}
  currentQuestionId={questao.id}
  toc={toc}
  questions={questionsLinks}
  wide={true}
>
  <div class="space-y-6">
    
    <!-- Navegação Superior Estilo Artigo -->
    <div class="sans-ui flex flex-wrap items-center justify-between gap-3 text-xs pb-4 border-b border-[var(--border-subtle)] text-[var(--text-muted)]">
      <div class="flex items-center gap-2">
        <a href={`/${materia.slug}/questoes?tag=${encodeURIComponent(activeTagKey)}`} class="hover:text-[var(--accent)] transition-colors">
          &larr; Banco de Questões
        </a>
        <span>•</span>
        <a href={`/${materia.slug}?tag=${encodeURIComponent(activeTagKey)}#${questao.topicSlug}`} class="hover:text-[var(--accent)] transition-colors">
          Ir para a Teoria do Capítulo &rarr;
        </a>
      </div>
      <div class="flex items-center gap-2 font-mono">
        {questionIsFromOther && (
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
            De: {questionOwnerDisplayName}
          </span>
        )}
        <span class="font-bold text-[var(--accent)]">
          {questao.exam} • {questao.year}
        </span>
      </div>
    </div>

    <!-- Enunciado e Resolução em Duas Colunas -->
    <QuestionToggle
      type={questao.type}
      correctOption={questao.correctOption}
      expectedAnswer={questao.expectedAnswer}
      options={questao.options}
    >
      <!-- Slot do Enunciado e Figuras (Coluna Esquerda no Desktop) -->
      <div slot="statement" class="space-y-6">
        <!-- Cabeçalho do Exercício -->
        <div class="space-y-2 border-b border-[var(--border-subtle)] pb-4">
          <div class="sans-ui flex flex-wrap items-center justify-between gap-2 text-xs font-mono uppercase tracking-widest text-[var(--accent)]">
            <span>{questao.exam} ({questao.year}) • {questao.topic}</span>
            <span class="rounded px-2 py-0.5 bg-[var(--bg-subtle)] border border-[var(--border-subtle)] text-[11px] font-sans font-medium">
              {questao.type === 'discursiva' ? 'Questão Dissertativa' : 'Múltipla Escolha'}
            </span>
          </div>
          <h1 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
            {questao.title}
          </h1>
          <div class="sans-ui text-xs text-[var(--text-muted)] italic">
            Dificuldade estimada: {questao.difficulty}
          </div>
        </div>

        <!-- Enunciado -->
        {questao.statement && (
          <div class="space-y-2">
            <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
              Enunciado da Questão
            </div>
            <div
              class="font-serif text-base sm:text-lg text-[var(--text-primary)] leading-relaxed"
              set:html={questao.renderedStatement}
            />
          </div>
        )}

        <!-- Imagens / Diagramas -->
        {formattedImages.length > 0 && (
          <div class={`my-6 grid gap-4 items-start ${formattedImages.length === 1 ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2'}`}>
            {formattedImages.map((img, idx) => (
              <figure class="flex flex-col items-center justify-center text-center">
                <img
                  src={img.src}
                  alt={img.caption || `Figura ${idx + 1}`}
                  data-zoomable-image="true"
                  data-image-title={img.caption || `Figura ${idx + 1}`}
                  class="zoomable-question-image max-h-72 w-auto object-contain cursor-zoom-in rounded border border-[var(--border-subtle)] bg-[var(--bg-subtle)] transition-transform duration-200 hover:scale-[1.01]"
                  loading="lazy"
                  title="Clique para visualizar com zoom e navegação"
                />
                {img.caption && (
                  <figcaption class="sans-ui text-xs text-[var(--text-muted)] italic mt-2 max-w-md">
                    {img.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )}
      </div>

      <!-- Slot Padrão: Explicação Teórica e Resolução Passo a Passo -->
      <div class="space-y-4">
        {questao.theoryHtml && (
          <Theory title="Fundamentação Teórica Necessária">
            <div set:html={questao.theoryHtml} />
          </Theory>
        )}

        {questao.resolutionHtml && (
          <Resolution title="Resolução Passo a Passo">
            <div set:html={questao.resolutionHtml} />
          </Resolution>
        )}

        {questao.bodyHtml && (
          <div class="academic-prose leading-relaxed text-[var(--text-primary)]" set:html={questao.bodyHtml} />
        )}
      </div>
    </QuestionToggle>

    <!-- Navegação Inferior Entre Questões -->
    <nav class="flex items-center justify-between pt-6 border-t border-[var(--border-subtle)] sans-ui text-xs">
      {prevQ ? (
        <a
          href={`/${materia.slug}/questoes/${prevQ.id}${questionIsFromOther && prevQ.ownerUserId ? `?owner=${prevQ.ownerUserId}` : ''}`}
          class="flex items-center gap-1.5 p-2 rounded hover:bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
        >
          <span>&larr;</span>
          <span class="font-mono">Anterior: {prevQ.title}</span>
        </a>
      ) : <div />}

      {nextQ ? (
        <a
          href={`/${materia.slug}/questoes/${nextQ.id}${questionIsFromOther && nextQ.ownerUserId ? `?owner=${nextQ.ownerUserId}` : ''}`}
          class="flex items-center gap-1.5 p-2 rounded hover:bg-[var(--bg-subtle)] text-[var(--accent)] font-semibold transition-colors"
        >
          <span class="font-mono">Próxima: {nextQ.title}</span>
          <span>&rarr;</span>
        </a>
      ) : <div />}
    </nav>

  </div>
</AcademicLayout>
