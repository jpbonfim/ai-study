---
import { getCollection, render } from 'astro:content';
import AcademicLayout from '../../../layouts/AcademicLayout.astro';
import QuestionToggle from '../../../components/QuestionToggle.astro';
import Theory from '../../../components/Theory.astro';
import Resolution from '../../../components/Resolution.astro';
import BlockDiagram from '../../../components/BlockDiagram.astro';
import { renderMath } from '../../../utils/katex';
import { MATERIAS, getMateria, formatTag } from '../../../data/materias';

export async function getStaticPaths() {
  const allQuestoes = await getCollection('questoes');
  return allQuestoes.map((questao) => {
    const materiaObj = getMateria(questao.data.materia) || MATERIAS[0];
    return {
      params: {
        materia: questao.data.materia,
        slug: questao.id,
      },
      props: {
        questao,
        materia: materiaObj,
      },
    };
  });
}

const { questao, materia } = Astro.props;
const { Content } = await render(questao);

// Busca dados para o menu lateral
const allResumos = await getCollection('resumos', (entry) => entry.data.materia === materia.slug);
const sortedResumos = allResumos.sort((a, b) => a.data.order - b.data.order);

const allQuestoes = await getCollection('questoes', (entry) => entry.data.materia === materia.slug);

// Coleta todas as tags únicas
const rawTags = [
  ...new Set([
    ...sortedResumos.flatMap((r) => r.data.tags || []),
    ...allQuestoes.flatMap((q) => q.data.tags || []),
  ]),
];
const tagList = rawTags.length > 0 ? rawTags : ['teste-1'];

const availableTags = tagList.map((tagId) => {
  const chaptersCount = sortedResumos.filter((r) => (r.data.tags || []).includes(tagId)).length;
  const questionsCount = allQuestoes.filter((q) => (q.data.tags || []).includes(tagId)).length;
  return {
    id: tagId,
    label: formatTag(tagId),
    chaptersCount,
    questionsCount,
  };
});

const primaryTag = questao.data.tags?.[0] || 'teste-1';

const toc = sortedResumos.map((resumo) => ({
  id: `cap-${resumo.data.chapter}`,
  title: `Capítulo ${resumo.data.chapter}: ${resumo.data.topic}`,
  subsections: resumo.data.sections || [],
  tags: resumo.data.tags,
}));

const questionsLinks = allQuestoes.map((q) => ({
  id: q.id,
  title: q.data.title,
  exam: q.data.exam,
  year: q.data.year,
  tags: q.data.tags,
}));

// Navegação anterior e próxima
const currentIndex = allQuestoes.findIndex((q) => q.id === questao.id);
const prevQ = currentIndex > 0 ? allQuestoes[currentIndex - 1] : null;
const nextQ = currentIndex < allQuestoes.length - 1 ? allQuestoes[currentIndex + 1] : null;

// Tratamento unificado de imagens (suporte a imagem única ou lista de múltiplas imagens com legendas)
const rawImages = questao.data.images || (questao.data.image ? [questao.data.image] : []);
const formattedImages = rawImages.map((img: any, idx: number) => {
  if (typeof img === 'string') {
    return {
      src: img,
      caption: rawImages.length === 1 ? 'Diagrama esquemático oficial da questão' : `Figura ${idx + 1}`,
    };
  }
  const src = typeof img.src === 'string' ? img.src : (img.src?.src || img);
  return {
    src,
    caption: img.caption || (rawImages.length === 1 ? 'Diagrama esquemático oficial da questão' : `Figura ${idx + 1}`),
  };
});
---

<AcademicLayout
  title={`${questao.data.title} | ${materia.name}`}
  materia={materia}
  availableTags={availableTags}
  activeTag={primaryTag}
  toc={toc}
  questions={questionsLinks}
  wide={true}
>
  <div class="space-y-6">
    
    <!-- Navegação Superior Estilo Artigo -->
    <div class="sans-ui flex flex-wrap items-center justify-between gap-3 text-xs pb-4 border-b border-[var(--border-subtle)] text-[var(--text-muted)]">
      <div class="flex items-center gap-2">
        <a href={`/${materia.slug}/questoes?tag=${primaryTag}`} class="hover:text-[var(--accent)] transition-colors">
          &larr; Banco de Testes
        </a>
        <span>•</span>
        <a href={`/${materia.slug}?tag=${primaryTag}#${questao.data.topicSlug}`} class="hover:text-[var(--accent)] transition-colors">
          Ir para a Teoria do Capítulo &rarr;
        </a>
      </div>
      <span class="font-mono font-bold text-[var(--accent)]">
        {questao.data.exam} • {questao.data.year}
      </span>
    </div>

    <!-- Enunciado e Resolução em Duas Colunas (quando houver largura lateral suficiente) -->
    <QuestionToggle
      type={questao.data.type || (questao.data.options && questao.data.options.length > 0 ? 'multipla_escolha' : 'discursiva')}
      correctOption={questao.data.correctOption}
      expectedAnswer={questao.data.expectedAnswer}
      options={questao.data.options}
    >
      <!-- Slot do Enunciado e Figuras (Coluna Esquerda no Desktop) -->
      <div slot="statement" class="space-y-6">
        <!-- Cabeçalho do Exercício -->
        <div class="space-y-2 border-b border-[var(--border-subtle)] pb-4">
          <div class="sans-ui flex flex-wrap items-center justify-between gap-2 text-xs font-mono uppercase tracking-widest text-[var(--accent)]">
            <span>{questao.data.exam} ({questao.data.year}) • {questao.data.topic}</span>
            <span class="rounded px-2 py-0.5 bg-[var(--bg-subtle)] border border-[var(--border-subtle)] text-[11px] font-sans font-medium">
              {questao.data.type === 'discursiva' ? 'Questão Dissertativa' : 'Múltipla Escolha'}
            </span>
          </div>
          <h1 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
            {questao.data.title}
          </h1>
          <div class="sans-ui text-xs text-[var(--text-muted)] italic">
            Dificuldade estimada: {questao.data.difficulty}
          </div>
        </div>

        <!-- Enunciado -->
        {questao.data.statement && (
          <div class="space-y-2">
            <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
              Enunciado da Questão
            </div>
            <div
              class="font-serif text-base sm:text-lg text-[var(--text-primary)] leading-relaxed"
              set:html={renderMath(questao.data.statement)}
            />
          </div>
        )}

        <!-- Imagens / Diagramas -->
        {formattedImages.length > 0 && (
          <div class={`my-6 grid gap-4 items-start ${formattedImages.length === 1 ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2'}`}>
            {formattedImages.map((img, idx) => (
              <figure class="flex flex-col items-center justify-center text-center">
                <img
                  src={img.src}
                  alt={img.caption || `Figura ${idx + 1}`}
                  data-zoomable-image="true"
                  data-image-title={img.caption || `Figura ${idx + 1}`}
                  class="zoomable-question-image max-h-72 w-auto object-contain cursor-zoom-in rounded border border-[var(--border-subtle)] bg-[var(--bg-subtle)] transition-transform duration-200 hover:scale-[1.01]"
                  loading="lazy"
                  title="Clique para visualizar com zoom e navegação"
                />
                {img.caption && (
                  <figcaption class="sans-ui text-xs text-[var(--text-muted)] italic mt-2 max-w-md">
                    {img.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )}
      </div>

      <!-- Slot Padrão: Explicação Teórica e Resolução Passo a Passo (Coluna Direita no Desktop) -->
      <Content components={{
        BlockDiagram,
        Theory,
        Resolution,
        QuestionTheory: Theory,
        QuestionResolution: Resolution,
      }} />
    </QuestionToggle>

    <!-- Navegação Anterior / Próxima -->
    <div class="sans-ui grid grid-cols-2 gap-4 text-xs pt-4">
      {prevQ ? (
        <a
          href={`/${materia.slug}/questoes/${prevQ.id}`}
          class="p-3 rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent)] transition-colors"
        >
          <span class="text-[var(--text-muted)] block">&larr; Questão Anterior</span>
          <span class="font-bold text-[var(--text-primary)] font-serif text-sm line-clamp-1 mt-0.5">
            {prevQ.data.title}
          </span>
        </a>
      ) : <div />}

      {nextQ ? (
        <a
          href={`/${materia.slug}/questoes/${nextQ.id}`}
          class="p-3 rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent)] transition-colors text-right ml-auto w-full"
        >
          <span class="text-[var(--text-muted)] block">Próxima Questão &rarr;</span>
          <span class="font-bold text-[var(--text-primary)] font-serif text-sm line-clamp-1 mt-0.5">
            {nextQ.data.title}
          </span>
        </a>
      ) : <div />}
    </div>

  </div>
</AcademicLayout>

<script>
  import { openImageModal } from '../../../scripts/diagramManager';

  function setupQuestionImages() {
    document.querySelectorAll<HTMLImageElement>('img[data-zoomable-image]').forEach((img) => {
      if (img.dataset.zoomBound === 'true') return;
      img.dataset.zoomBound = 'true';
      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const src = img.src || img.getAttribute('src');
        const title = img.getAttribute('data-image-title') || img.alt || 'Imagem da Questão';
        if (src) {
          openImageModal(src, title);
        }
      });
    });
  }

  setupQuestionImages();
  document.addEventListener('astro:page-load', setupQuestionImages);
</script>
