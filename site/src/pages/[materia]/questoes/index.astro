---
export const prerender = false;

import AcademicLayout, { type TagOption } from '../../../layouts/AcademicLayout.astro';
import { getMateria, formatTag, loadAllAccessibleMaterias } from '../../../data/materias';
import { loadUserChapters, loadUserQuestions, type ChapterItem, type QuestionItem } from '../../../lib/mdx-runtime';
import QuestionCard from '../../../components/QuestionCard.astro';
import { hasPermissionToSubject } from '../../../lib/permissions';

const user = Astro.locals.user!;
const { materia: materiaSlug } = Astro.params;
const ownerParam = Astro.url.searchParams.get('owner');

if (!materiaSlug) {
  return Astro.redirect('/');
}

const { own, shared } = loadAllAccessibleMaterias(user.id);
let primaryOwnerId = user.id;
let materia = own.find((m) => m.slug === materiaSlug);

if (ownerParam) {
  const parsedOwner = parseInt(ownerParam, 10);
  const foundShared = shared.find((m) => m.slug === materiaSlug && m.ownerUserId === parsedOwner);
  if (foundShared || user.role === 'admin' || hasPermissionToSubject(user.id, parsedOwner, materiaSlug)) {
    primaryOwnerId = parsedOwner;
    materia = foundShared || getMateria(materiaSlug, parsedOwner);
  }
} else if (!materia) {
  const foundShared = shared.find((m) => m.slug === materiaSlug);
  if (foundShared) {
    primaryOwnerId = foundShared.ownerUserId!;
    materia = foundShared;
  }
}

if (!materia) {
  return Astro.redirect('/?error=materia_nao_encontrada');
}

// Carrega capítulos e questões do dono principal
const primaryChapters = loadUserChapters(primaryOwnerId, materiaSlug);
const primaryQuestions = loadUserQuestions(primaryOwnerId, materiaSlug);

// Busca outras fontes acessíveis com o mesmo código acadêmico
const canonicalCode = (materia.code || '').trim().toUpperCase();

interface OtherSource {
  ownerUserId: number;
  ownerDisplayName: string;
  ownerUsername: string;
  materiaSlug: string;
  chapters: ChapterItem[];
  questions: QuestionItem[];
}

const otherSources: OtherSource[] = [];

if (canonicalCode) {
  if (user.id !== primaryOwnerId) {
    const ownMatch = own.find((m) => (m.code || '').trim().toUpperCase() === canonicalCode);
    if (ownMatch) {
      otherSources.push({
        ownerUserId: user.id,
        ownerDisplayName: user.displayName,
        ownerUsername: user.username,
        materiaSlug: ownMatch.slug,
        chapters: loadUserChapters(user.id, ownMatch.slug),
        questions: loadUserQuestions(user.id, ownMatch.slug),
      });
    }
  }

  for (const s of shared) {
    if (s.ownerUserId && s.ownerUserId !== primaryOwnerId && (s.code || '').trim().toUpperCase() === canonicalCode) {
      otherSources.push({
        ownerUserId: s.ownerUserId,
        ownerDisplayName: s.ownerDisplayName || s.ownerUsername || `Usuário ${s.ownerUserId}`,
        ownerUsername: s.ownerUsername || '',
        materiaSlug: s.slug,
        chapters: loadUserChapters(s.ownerUserId, s.slug),
        questions: loadUserQuestions(s.ownerUserId, s.slug),
      });
    }
  }
}

const hasOtherUsersTags = otherSources.length > 0;

// Coleta todas as tags únicas do usuário principal
const ownRawTags = [
  ...new Set([
    ...primaryChapters.flatMap((c) => c.tags || []),
    ...primaryQuestions.flatMap((q) => q.tags || []),
  ]),
];

const availableTags: TagOption[] = ownRawTags.map((tagId) => ({
  id: tagId,
  label: formatTag(tagId),
  chaptersCount: primaryChapters.filter((c) => (c.tags || []).includes(tagId)).length,
  questionsCount: primaryQuestions.filter((q) => (q.tags || []).includes(tagId)).length,
  isFromOtherUser: false,
}));

// Adiciona tags de outras fontes (com ID unívoco para não colidir)
for (const src of otherSources) {
  const srcTags = [
    ...new Set([
      ...src.chapters.flatMap((c) => c.tags || []),
      ...src.questions.flatMap((q) => q.tags || []),
    ]),
  ];

  for (const t of srcTags) {
    const uniqueKey = `user_${src.ownerUserId}::${t}`;
    availableTags.push({
      id: uniqueKey,
      label: formatTag(t),
      chaptersCount: src.chapters.filter((c) => (c.tags || []).includes(t)).length,
      questionsCount: src.questions.filter((q) => (q.tags || []).includes(t)).length,
      isFromOtherUser: true,
      ownerUserId: src.ownerUserId,
      ownerDisplayName: src.ownerDisplayName,
      ownerUsername: src.ownerUsername,
    });
  }
}

// Capítulos e Sumário
const chaptersToRender = [
  ...primaryChapters.map((c) => ({
    ...c,
    isFromOther: false,
    matchTags: [...(c.tags || []), ...((c.tags || []).map((t) => `user_${primaryOwnerId}::${t}`))],
  })),
  ...otherSources.flatMap((src) =>
    src.chapters.map((c) => ({
      ...c,
      isFromOther: true,
      ownerDisplayName: src.ownerDisplayName,
      matchTags: (c.tags || []).map((t) => `user_${src.ownerUserId}::${t}`),
    }))
  ),
];

const toc = chaptersToRender.map((resumo) => {
  const isMateria = resumo.type === 'materia';
  const prefix = resumo.isFromOther ? `other-${resumo.ownerUserId}-` : '';
  const chapId = isMateria ? `${prefix}cap-materia-${resumo.chapter}` : `${prefix}cap-${resumo.chapter}`;
  return {
    id: chapId,
    title: `Capítulo ${resumo.chapter}: ${resumo.topic}${resumo.isFromOther ? ` (${resumo.ownerDisplayName})` : ''}`,
    subsections: resumo.sections || [],
    tags: resumo.matchTags,
    type: (resumo.type || 'questoes') as 'materia' | 'questoes',
    isFromOther: resumo.isFromOther,
  };
});

// Todas as questões renderizáveis
interface RenderableQuestion extends QuestionItem {
  isFromOther: boolean;
  ownerDisplayName?: string;
  matchTags: string[];
}

const allQuestionsToRender: RenderableQuestion[] = [
  ...primaryQuestions.map((q) => ({
    ...q,
    isFromOther: false,
    matchTags: [...(q.tags || []), ...((q.tags || []).map((t) => `user_${primaryOwnerId}::${t}`))],
  })),
  ...otherSources.flatMap((src) =>
    src.questions.map((q) => ({
      ...q,
      isFromOther: true,
      ownerDisplayName: src.ownerDisplayName,
      matchTags: (q.tags || []).map((t) => `user_${src.ownerUserId}::${t}`),
    }))
  ),
];

const questionsLinks = allQuestionsToRender.map((q) => ({
  id: q.id,
  title: q.title,
  exam: q.exam,
  year: q.year,
  tags: q.matchTags,
  ownerUserId: q.ownerUserId,
  ownerDisplayName: q.ownerDisplayName,
}));

const topics = [...new Set(allQuestionsToRender.map((q) => q.topic))].sort();
---

<AcademicLayout
  title={`Banco de Questões | ${materia.name}`}
  materia={materia}
  availableTags={availableTags}
  hasOtherUsersTags={hasOtherUsersTags}
  toc={toc}
  questions={questionsLinks}
>
  <div class="space-y-10">
    
    <!-- Cabeçalho Acadêmico -->
    <header class="pb-6 border-b border-[var(--border-strong)] space-y-2">
      <div class="sans-ui text-xs font-mono tracking-wider uppercase text-[var(--accent)]">
        Caderno de Exercícios & Provas Anteriores
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[var(--text-primary)]">
        Banco de Questões Resolvidas
      </h1>
      <p class="font-serif text-base text-[var(--text-secondary)] italic">
        Questões oficiais de {materia.name} com fundamentação teórica, resolução analítica passo a passo e gabarito.
      </p>
    </header>

    <!-- Barra de Filtros Acadêmica Otimizada -->
    <div class="sans-ui p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] space-y-3 text-xs shadow-2xs min-w-0">
      <div class="space-y-2.5 min-w-0">
        <!-- Campo de Busca Textual Amplo -->
        <div class="relative w-full min-w-0">
          <div class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)]">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            placeholder="Filtrar por enunciado, palavra-chave ou conceito..."
            class="w-full min-w-0 pl-9 pr-3 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)] text-xs shadow-2xs"
          />
        </div>

        <!-- Seletores Categóricos em Grade Equilibrada -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 min-w-0 w-full">
          <div class="min-w-0">
            <label for="tag-filter" class="sr-only">Filtrar por Avaliação / Tag</label>
            <select
              id="tag-filter"
              class="w-full min-w-0 px-3 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)] truncate cursor-pointer text-xs shadow-2xs"
            >
              <option value="">Todas as Avaliações / Tags</option>
              {availableTags.map((t) => (
                <option value={t.id} class={t.isFromOtherUser ? 'other-user-filter-tag' : ''}>
                  {t.label}{t.isFromOtherUser ? ` (${t.ownerDisplayName || t.ownerUsername})` : ''}
                </option>
              ))}
            </select>
          </div>

          <div class="min-w-0">
            <label for="topic-filter" class="sr-only">Filtrar por Tópico</label>
            <select
              id="topic-filter"
              class="w-full min-w-0 px-3 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)] truncate cursor-pointer text-xs shadow-2xs"
            >
              <option value="">Todos os Tópicos</option>
              {topics.map((t) => (
                <option value={t}>{t}</option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Rodapé do Filtro com Contagem e Ação de Limpeza -->
      <div id="results-count" class="text-[var(--text-muted)] text-[11px] flex items-center justify-between pt-1 border-t border-[var(--border-subtle)]">
        <span>{allQuestionsToRender.length} questões disponíveis no caderno.</span>
        <button
          type="button"
          id="clear-filters-btn"
          class="text-[var(--accent)] hover:underline hidden cursor-pointer font-medium"
        >
          Limpar filtros
        </button>
      </div>
    </div>

    <!-- Lista Acadêmica de Questões -->
    <div id="questions-list" class="space-y-4">
      {allQuestionsToRender.map((q) => (
        <div
          class="question-entry"
          data-topic={q.topic}
          data-tags={q.matchTags.join(',')}
          data-text={`${q.title} ${q.statement || ''} ${q.ownerDisplayName || ''}`.toLowerCase()}
          data-is-other={q.isFromOther ? 'true' : 'false'}
        >
          {q.isFromOther && (
            <div class="mb-1.5 flex items-center gap-1.5 sans-ui text-xs">
              <span class="px-2 py-0.5 rounded font-mono text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
                Compartilhada por: {q.ownerDisplayName}
              </span>
            </div>
          )}
          <QuestionCard item={q} />
        </div>
      ))}
    </div>

  </div>
</AcademicLayout>

<script is:inline>
  const search = document.getElementById('search-input');
  const tagFilter = document.getElementById('tag-filter');
  const topic = document.getElementById('topic-filter');
  const entries = document.querySelectorAll('.question-entry');
  const count = document.getElementById('results-count')?.querySelector('span');
  const clearBtn = document.getElementById('clear-filters-btn');

  function isShowingOtherTags() {
    try {
      return localStorage.getItem('study_show_other_tags') === 'true';
    } catch(e) {
      return false;
    }
  }

  function updateFilterTagOptions() {
    const showOther = isShowingOtherTags();
    document.querySelectorAll('.other-user-filter-tag').forEach((opt) => {
      if (showOther) {
        opt.removeAttribute('disabled');
        opt.classList.remove('hidden');
      } else {
        opt.classList.add('hidden');
      }
    });
  }

  function filter() {
    const sVal = (search?.value || '').toLowerCase().trim();
    const tVal = topic?.value || '';
    const tagVal = tagFilter?.value || '';
    const showOther = isShowingOtherTags();

    let visible = 0;
    entries.forEach((el) => {
      const elTopic = el.getAttribute('data-topic') || '';
      const elTags = (el.getAttribute('data-tags') || '').split(',').map(s => s.trim());
      const elText = el.getAttribute('data-text') || '';
      const isOther = el.getAttribute('data-is-other') === 'true';

      const matchSearch = !sVal || elText.includes(sVal);
      const matchTopic = !tVal || elTopic === tVal;

      let matchTag = false;
      if (tagVal) {
        matchTag = elTags.includes(tagVal);
      } else {
        matchTag = !isOther || showOther;
      }

      if (matchSearch && matchTopic && matchTag) {
        el.classList.remove('hidden');
        visible++;
      } else {
        el.classList.add('hidden');
      }
    });

    if (count) {
      count.textContent = `Exibindo ${visible} de ${entries.length} questões.`;
    }

    if (clearBtn) {
      if (sVal || tVal || tagVal) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    }
  }

  search?.addEventListener('input', filter);
  topic?.addEventListener('change', filter);

  tagFilter?.addEventListener('change', () => {
    const selected = tagFilter.value || null;
    if (typeof window.selectStudyTag === 'function') {
      window.selectStudyTag(selected);
    }
    filter();
  });

  clearBtn?.addEventListener('click', () => {
    if (search) search.value = '';
    if (topic) topic.value = '';
    if (tagFilter) tagFilter.value = '';
    if (typeof window.selectStudyTag === 'function') {
      window.selectStudyTag(null);
    }
    filter();
  });

  window.addEventListener('study-tag-changed', (e) => {
    const newTag = e.detail?.tag || '';
    if (tagFilter && tagFilter.value !== newTag) {
      tagFilter.value = newTag;
    }
    filter();
  });

  window.addEventListener('study-other-tags-toggled', () => {
    updateFilterTagOptions();
    filter();
  });

  // Inicialização
  updateFilterTagOptions();
  const urlParams = new URLSearchParams(window.location.search);
  const initialTag = urlParams.get('tag') || (typeof window.getCurrentStudyTag === 'function' ? window.getCurrentStudyTag() : null);
  if (initialTag && tagFilter) {
    tagFilter.value = initialTag;
  }
  filter();
</script>
