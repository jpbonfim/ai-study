---
import { getCollection } from 'astro:content';
import AcademicLayout from '../../../layouts/AcademicLayout.astro';
import { MATERIAS, getMateria, formatTag } from '../../../data/materias';
import { renderMath } from '../../../utils/katex';
import QuestionCard from '../../../components/QuestionCard.astro';

export async function getStaticPaths() {
  return MATERIAS.filter((m) => m.status === 'active').map((materia) => ({
    params: { materia: materia.slug },
    props: { materia },
  }));
}

const { materia } = Astro.props;

const allResumos = await getCollection('resumos', (entry) => entry.data.materia === materia.slug);
const sortedResumos = allResumos.sort((a, b) => a.data.order - b.data.order);

const allQuestoes = await getCollection('questoes', (entry) => entry.data.materia === materia.slug);

// Coleta todas as tags únicas
const rawTags = [
  ...new Set([
    ...sortedResumos.flatMap((r) => r.data.tags || []),
    ...allQuestoes.flatMap((q) => q.data.tags || []),
  ]),
];
const tagList = rawTags.length > 0 ? rawTags : ['teste-1'];

const availableTags = tagList.map((tagId) => {
  const chaptersCount = sortedResumos.filter((r) => (r.data.tags || []).includes(tagId)).length;
  const questionsCount = allQuestoes.filter((q) => (q.data.tags || []).includes(tagId)).length;
  return {
    id: tagId,
    label: formatTag(tagId),
    chaptersCount,
    questionsCount,
  };
});

const toc = sortedResumos.map((resumo) => {
  const isMateria = resumo.data.type === 'materia';
  const chapId = isMateria ? `cap-materia-${resumo.data.chapter}` : `cap-${resumo.data.chapter}`;
  return {
    id: chapId,
    title: `Capítulo ${resumo.data.chapter}: ${resumo.data.topic}`,
    subsections: resumo.data.sections || [],
    tags: resumo.data.tags,
    type: (resumo.data.type || 'questoes') as 'materia' | 'questoes',
  };
});

const questionsLinks = allQuestoes.map((q) => ({
  id: q.id,
  title: q.data.title,
  exam: q.data.exam,
  year: q.data.year,
  tags: q.data.tags,
}));

// Tópicos únicos para filtro
const topics = [...new Set(allQuestoes.map((q) => q.data.topic))].sort();
---

<AcademicLayout
  title={`Banco de Questões | ${materia.name}`}
  materia={materia}
  availableTags={availableTags}
  toc={toc}
  questions={questionsLinks}
>
  <div class="space-y-10">
    
    <!-- Cabeçalho Acadêmico -->
    <header class="pb-6 border-b border-[var(--border-strong)] space-y-2">
      <div class="sans-ui text-xs font-mono tracking-wider uppercase text-[var(--accent)]">
        Caderno de Exercícios & Provas Anteriores
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[var(--text-primary)]">
        Banco de Questões Resolvidas
      </h1>
      <p class="font-serif text-base text-[var(--text-secondary)] italic">
        Questões oficiais de {materia.name} com fundamentação teórica, resolução analítica passo a passo e gabarito.
      </p>
    </header>

    <!-- Barra de Filtros Minimalista -->
    <div class="sans-ui p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] space-y-3 text-xs shadow-2xs">
      <div class="flex flex-col sm:flex-row gap-3">
        <input
          type="text"
          id="search-input"
          placeholder="Filtrar por enunciado, palavra-chave ou conceito..."
          class="flex-1 px-3 py-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]"
        />

        <select
          id="tag-filter"
          class="px-3 py-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)] cursor-pointer"
        >
          <option value="">Todas as Avaliações / Tags</option>
          {availableTags.map((t) => (
            <option value={t.id}>{t.label}</option>
          ))}
        </select>

        <select
          id="topic-filter"
          class="px-3 py-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)] cursor-pointer"
        >
          <option value="">Todos os Tópicos</option>
          {topics.map((t) => (
            <option value={t}>{t}</option>
          ))}
        </select>
      </div>

      <div id="results-count" class="text-[var(--text-muted)] text-[11px] flex items-center justify-between">
        <span>{allQuestoes.length} questões disponíveis no caderno.</span>
        <button
          type="button"
          id="clear-filters-btn"
          class="text-[var(--accent)] hover:underline hidden cursor-pointer"
        >
          Limpar filtros
        </button>
      </div>
    </div>

    <!-- Lista Acadêmica de Questões -->
    <div id="questions-list" class="space-y-4">
      {allQuestoes.map((q) => (
        <div
          class="question-entry"
          data-topic={q.data.topic}
          data-tags={(q.data.tags || []).join(',')}
          data-text={`${q.data.title} ${q.data.statement || ''}`.toLowerCase()}
        >
          <QuestionCard id={q.id} />
        </div>
      ))}
    </div>

  </div>
</AcademicLayout>

<script is:inline>
  const search = document.getElementById('search-input');
  const tagFilter = document.getElementById('tag-filter');
  const topic = document.getElementById('topic-filter');
  const entries = document.querySelectorAll('.question-entry');
  const count = document.getElementById('results-count')?.querySelector('span');
  const clearBtn = document.getElementById('clear-filters-btn');

  function filter() {
    const sVal = (search?.value || '').toLowerCase().trim();
    const tVal = topic?.value || '';
    const tagVal = tagFilter?.value || '';

    let visible = 0;
    entries.forEach((el) => {
      const elTopic = el.getAttribute('data-topic') || '';
      const elTags = (el.getAttribute('data-tags') || '').split(',').map(s => s.trim());
      const elText = el.getAttribute('data-text') || '';

      const matchSearch = !sVal || elText.includes(sVal);
      const matchTopic = !tVal || elTopic === tVal;
      const matchTag = !tagVal || elTags.includes(tagVal);

      if (matchSearch && matchTopic && matchTag) {
        el.classList.remove('hidden');
        visible++;
      } else {
        el.classList.add('hidden');
      }
    });

    if (count) {
      count.textContent = `Exibindo ${visible} de ${entries.length} questões.`;
    }

    if (clearBtn) {
      if (sVal || tVal || tagVal) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    }
  }

  search?.addEventListener('input', filter);
  topic?.addEventListener('change', filter);
  tagFilter?.addEventListener('change', () => {
    filter();
    // Opcionalmente atualiza a tag global
    if (tagFilter && typeof window.selectStudyTag === 'function') {
      window.selectStudyTag(tagFilter.value || null, true);
    }
  });

  clearBtn?.addEventListener('click', () => {
    if (search) search.value = '';
    if (topic) topic.value = '';
    if (tagFilter) tagFilter.value = '';
    if (typeof window.selectStudyTag === 'function') {
      window.selectStudyTag(null, true);
    }
    filter();
  });

  // Reage à mudança de tag vinda do menu lateral
  window.addEventListener('study-tag-changed', (e) => {
    const newTag = e.detail?.tag || '';
    if (tagFilter && tagFilter.value !== newTag) {
      tagFilter.value = newTag;
      filter();
    }
  });

  // Inicialização com tag atual
  document.addEventListener('DOMContentLoaded', () => {
    const curTag = (typeof window.getCurrentStudyTag === 'function') ? window.getCurrentStudyTag() : null;
    if (curTag && tagFilter) {
      tagFilter.value = curTag;
    }
    filter();
  });
</script>
