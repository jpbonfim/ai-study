---
export const prerender = false;

import AcademicLayout, { type TagOption } from '../../layouts/AcademicLayout.astro';
import { getMateria, formatTag, loadAllAccessibleMaterias, type Subject } from '../../data/materias';
import {
  loadUserChaptersMetadata,
  loadUserQuestionsMetadata,
  loadChapterById,
  loadUserChaptersByTag,
  type ChapterMetadata,
  type QuestionMetadata,
  type ChapterItem,
} from '../../lib/mdx-runtime';
import { hasPermissionToSubject } from '../../lib/permissions';

const user = Astro.locals.user!;
const { materia: materiaSlug } = Astro.params;
const ownerParam = Astro.url.searchParams.get('owner');
const tagParam = Astro.url.searchParams.get('tag')?.trim() || null;

const clientCacheTtlMinutes = parseInt(process.env.CLIENT_CACHE_TTL_MINUTES || '1440', 10);
const clientCacheMaxEntries = parseInt(process.env.CLIENT_CACHE_MAX_ENTRIES || '50', 10);

if (!materiaSlug) {
  return Astro.redirect('/');
}

// 1. Carrega todas as matérias acessíveis
const { own, shared } = loadAllAccessibleMaterias(user.id);

let primaryOwnerId = user.id;
let materia: Subject | undefined = own.find((m) => m.slug === materiaSlug);

if (ownerParam) {
  const parsedOwner = parseInt(ownerParam, 10);
  const foundShared = shared.find((m) => m.slug === materiaSlug && m.ownerUserId === parsedOwner);
  if (foundShared || user.role === 'admin' || hasPermissionToSubject(user.id, parsedOwner, materiaSlug)) {
    primaryOwnerId = parsedOwner;
    materia = foundShared || getMateria(materiaSlug, parsedOwner);
  }
} else if (!materia) {
  // Procura entre as matérias compartilhadas com este usuário
  const foundShared = shared.find((m) => m.slug === materiaSlug);
  if (foundShared) {
    primaryOwnerId = foundShared.ownerUserId!;
    materia = foundShared;
  }
}

if (!materia) {
  return Astro.redirect('/?error=materia_nao_encontrada');
}

// 2. Carrega apenas metadados rápidos do dono principal (sem compilação pesada de Markdown/KaTeX)
const primaryChapters = loadUserChaptersMetadata(primaryOwnerId, materiaSlug);
const primaryQuestions = loadUserQuestionsMetadata(primaryOwnerId, materiaSlug);

const isOwnSubject = user.id === primaryOwnerId;

// 3. Busca outras fontes acessíveis com o mesmo "code" para tags cruzadas (APENAS ao acessar a matéria própria)
const canonicalCode = (materia.code || '').trim().toUpperCase();

interface OtherSource {
  ownerUserId: number;
  ownerDisplayName: string;
  ownerUsername: string;
  materiaSlug: string;
  chapters: ChapterMetadata[];
  questions: QuestionMetadata[];
}

const otherSources: OtherSource[] = [];

if (canonicalCode && isOwnSubject) {
  // Verifica outras matérias compartilhadas que compartilham o mesmo código
  for (const s of shared) {
    if (s.ownerUserId && s.ownerUserId !== primaryOwnerId && (s.code || '').trim().toUpperCase() === canonicalCode) {
      otherSources.push({
        ownerUserId: s.ownerUserId,
        ownerDisplayName: s.ownerDisplayName || s.ownerUsername || `Usuário ${s.ownerUserId}`,
        ownerUsername: s.ownerUsername || '',
        materiaSlug: s.slug,
        chapters: loadUserChaptersMetadata(s.ownerUserId, s.slug),
        questions: loadUserQuestionsMetadata(s.ownerUserId, s.slug),
      });
    }
  }
}

const hasOtherUsersTags = otherSources.length > 0;

// 4. Monta lista de tags próprias a partir de metadados
const ownRawTags = [
  ...new Set([
    ...primaryChapters.flatMap((c) => c.tags || []),
    ...primaryQuestions.flatMap((q) => q.tags || []),
  ]),
];

const availableTags: TagOption[] = ownRawTags.map((tagId) => ({
  id: tagId,
  label: formatTag(tagId),
  chaptersCount: primaryChapters.filter((c) => (c.tags || []).includes(tagId)).length,
  questionsCount: primaryQuestions.filter((q) => (q.tags || []).includes(tagId)).length,
  isFromOtherUser: false,
}));

// 5. Adiciona tags das outras fontes (com ID unívoco para não conflitar)
for (const src of otherSources) {
  const srcTags = [
    ...new Set([
      ...src.chapters.flatMap((c) => c.tags || []),
      ...src.questions.flatMap((q) => q.tags || []),
    ]),
  ];

  for (const t of srcTags) {
    const uniqueKey = `user_${src.ownerUserId}::${t}`;
    availableTags.push({
      id: uniqueKey,
      label: formatTag(t),
      chaptersCount: src.chapters.filter((c) => (c.tags || []).includes(t)).length,
      questionsCount: src.questions.filter((q) => (q.tags || []).includes(t)).length,
      isFromOtherUser: true,
      ownerUserId: src.ownerUserId,
      ownerDisplayName: src.ownerDisplayName,
      ownerUsername: src.ownerUsername,
    });
  }
}

// 6. Prepara os capítulos a renderizar (APENAS se uma tag for solicitada via URL)
interface RenderableChapter {
  id: string;
  filePath: string;
  materia: string;
  title: string;
  topic: string;
  chapter: number;
  order: number;
  description: string;
  type: 'materia' | 'questoes';
  tags: string[];
  sections: any[];
  relatedQuestions: any[];
  htmlContent?: string;
  ownerUserId: number;
  isFromOther: boolean;
  ownerDisplayName?: string;
  matchTags: string[];
}

let chaptersToRender: RenderableChapter[] = [];

if (tagParam) {
  const isOtherUserTag = tagParam.startsWith('user_') && tagParam.includes('::');
  if (isOtherUserTag) {
    const [userPart, raw] = tagParam.split('::');
    const filterOwnerId = parseInt(userPart.replace('user_', ''), 10);
    const foundSrc = otherSources.find((s) => s.ownerUserId === filterOwnerId);
    if (foundSrc) {
      const matchingMeta = foundSrc.chapters
        .filter((c) => (c.tags || []).includes(raw))
        .sort((a, b) => a.order - b.order || a.chapter - b.chapter);

      if (matchingMeta.length > 0) {
        // Compila APENAS o 1º capítulo no SSR; os demais são carregados sob demanda
        const firstChap = loadChapterById(matchingMeta[0].id, filterOwnerId, foundSrc.materiaSlug);
        chaptersToRender = [
          firstChap
            ? { ...firstChap, isFromOther: true, ownerDisplayName: foundSrc.ownerDisplayName, matchTags: [tagParam] }
            : { ...matchingMeta[0], htmlContent: '', isFromOther: true, ownerDisplayName: foundSrc.ownerDisplayName, matchTags: [tagParam] },
          ...matchingMeta.slice(1).map((m) => ({
            ...m,
            htmlContent: undefined,
            isFromOther: true,
            ownerDisplayName: foundSrc.ownerDisplayName,
            matchTags: [tagParam],
          })),
        ];
      }
    }
  } else {
    const matchingMeta = primaryChapters
      .filter((c) => (c.tags || []).includes(tagParam))
      .sort((a, b) => a.order - b.order || a.chapter - b.chapter);

    if (matchingMeta.length > 0) {
      // Compila APENAS o 1º capítulo no SSR; os demais são carregados sob demanda
      const firstChap = loadChapterById(matchingMeta[0].id, primaryOwnerId, materiaSlug);
      const primaryMatchTags = [tagParam, `user_${primaryOwnerId}::${tagParam}`];
      chaptersToRender = [
        firstChap
          ? { ...firstChap, isFromOther: false, matchTags: primaryMatchTags }
          : { ...matchingMeta[0], htmlContent: '', isFromOther: false, matchTags: primaryMatchTags },
        ...matchingMeta.slice(1).map((m) => ({
          ...m,
          htmlContent: undefined,
          isFromOther: false,
          matchTags: primaryMatchTags,
        })),
      ];
    }
  }
}

// Prepara questões para a sidebar a partir de metadados
interface RenderableQuestionLink {
  id: string;
  title: string;
  exam: string;
  year: number;
  tags: string[];
  ownerUserId?: number;
  ownerDisplayName?: string;
}

const questionsLinks: RenderableQuestionLink[] = [
  ...primaryQuestions.map((q) => ({
    id: q.id,
    title: q.title,
    exam: q.exam,
    year: q.year,
    tags: [...(q.tags || []), ...((q.tags || []).map((t) => `user_${primaryOwnerId}::${t}`))],
    ownerUserId: primaryOwnerId,
    ownerDisplayName: undefined,
  })),
  ...otherSources.flatMap((src) =>
    src.questions.map((q) => ({
      id: q.id,
      title: q.title,
      exam: q.exam,
      year: q.year,
      tags: (q.tags || []).map((t) => `user_${src.ownerUserId}::${t}`),
      ownerUserId: src.ownerUserId,
      ownerDisplayName: src.ownerDisplayName,
    }))
  ),
];

// Sumário (TOC) construído a partir de todos os metadados de capítulos
const allChaptersMeta = [
  ...primaryChapters.map((c) => ({
    ...c,
    isFromOther: false,
    matchTags: [...(c.tags || []), ...((c.tags || []).map((t) => `user_${primaryOwnerId}::${t}`))],
  })),
  ...otherSources.flatMap((src) =>
    src.chapters.map((c) => ({
      ...c,
      isFromOther: true,
      ownerDisplayName: src.ownerDisplayName,
      matchTags: (c.tags || []).map((t) => `user_${src.ownerUserId}::${t}`),
    }))
  ),
];

const toc = allChaptersMeta.map((resumo) => {
  const isMateria = resumo.type === 'materia';
  const prefix = resumo.isFromOther ? `other-${resumo.ownerUserId}-` : '';
  const chapId = isMateria ? `${prefix}cap-materia-${resumo.chapter}` : `${prefix}cap-${resumo.chapter}`;
  return {
    id: chapId,
    title: `Capítulo ${resumo.chapter}: ${resumo.topic}${resumo.isFromOther ? ` (${resumo.ownerDisplayName})` : ''}`,
    subsections: resumo.sections || [],
    tags: resumo.matchTags,
    type: (resumo.type || 'questoes') as 'materia' | 'questoes',
    isFromOther: resumo.isFromOther,
  };
});

const hasMateriaType = allChaptersMeta.some((r) => r.type === 'materia');
const hasQuestoesType = allChaptersMeta.some((r) => r.type !== 'materia');
const hasBothTypes = hasMateriaType && hasQuestoesType;
---

<AcademicLayout
  title={`${materia.name} (${materia.code})`}
  materia={materia}
  availableTags={availableTags}
  activeTag={tagParam}
  toc={toc}
  questions={questionsLinks}
  hasOtherUsersTags={hasOtherUsersTags}
>
  <!-- ESTADO 1: Prompt Inicial quando NENHUMA tag estiver selecionada -->
  <div id="tag-select-prompt" class={`space-y-8 py-6 max-w-3xl mx-auto w-full ${tagParam ? 'hidden' : ''}`}>
    <div class="p-8 sm:p-12 rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-surface)] shadow-sm text-center space-y-6">
      
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent)]/30 mx-auto">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
      </div>

      <div class="space-y-3">
        <div class="sans-ui text-xs font-mono font-bold uppercase tracking-widest text-[var(--accent)]">
          {materia.institution} • {materia.code}
          {materia.isShared && (
            <span class="ml-2 px-2 py-0.5 rounded text-[10px] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              De: {materia.ownerDisplayName || materia.ownerUsername}
            </span>
          )}
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[var(--text-primary)] leading-tight">
          {materia.name}
        </h1>
        <p class="font-serif text-base sm:text-lg text-[var(--text-secondary)] italic max-w-xl mx-auto">
          Para visualizar o caderno de estudos, selecione uma avaliação ou tag no menu lateral esquerdo.
        </p>
      </div>

      <div class="pt-6 border-t border-[var(--border-subtle)] space-y-4">
        <div class="sans-ui text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
          Avaliações Disponíveis para Estudo
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
          {availableTags.map((tag) => (
            <button
              type="button"
              onclick={`window.selectStudyTag && window.selectStudyTag('${tag.id}')`}
              class="p-5 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-page)] hover:bg-[var(--bg-surface-hover)] hover:border-[var(--accent)] transition-all cursor-pointer group shadow-2xs space-y-2 text-left w-full"
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 truncate">
                  <span class="font-mono text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
                    {tag.label}
                  </span>
                  {tag.isFromOtherUser && (
                    <span class="text-[10px] font-mono font-semibold text-emerald-600 dark:text-emerald-400 px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">
                      {tag.ownerDisplayName || tag.ownerUsername}
                    </span>
                  )}
                </div>
                <span class="sans-ui text-xs font-semibold text-[var(--accent)] flex items-center gap-1 shrink-0">
                  <span>Estudar</span>
                  <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
                </span>
              </div>
              <div class="sans-ui flex items-center gap-3 text-xs text-[var(--text-secondary)]">
                <span>{tag.chaptersCount} {tag.chaptersCount === 1 ? 'Capítulo' : 'Capítulos'}</span>
                <span>•</span>
                <span>{tag.questionsCount} {tag.questionsCount === 1 ? 'Questão' : 'Questões'}</span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <div class="sans-ui text-xs text-[var(--text-muted)] pt-2">
        Dica: Você também pode alternar entre avaliações a qualquer momento pelo menu lateral.
      </div>
    </div>
  </div>

  <!-- ESTADO 2: Caderno Completo da Tag Selecionada -->
  <article id="notebook-content" class={`space-y-14 w-full min-w-0 ${tagParam ? '' : 'hidden'}`}>
    
    <!-- Barra Informativa da Tag Ativa -->
    <div class="sans-ui flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-xs shadow-2xs">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)]"></span>
        <span class="text-[var(--text-secondary)]">Avaliação Selecionada:</span>
        <strong id="active-tag-display-name" class="text-[var(--accent)] font-bold font-mono text-sm">
          {tagParam ? formatTag(tagParam.includes('::') ? tagParam.split('::')[1] : tagParam) : ''}
        </strong>
      </div>
      <button
        type="button"
        id="btn-switch-tag"
        class="text-[var(--accent)] hover:underline font-semibold cursor-pointer flex items-center gap-1"
      >
        <span>Trocar Avaliação / Ver Todas</span>
        <span>&rarr;</span>
      </button>
    </div>

    <!-- Cabeçalho Acadêmico do Caderno Completo -->
    <header class="text-center pb-12 border-b border-[var(--border-strong)] space-y-4">
      <div class="sans-ui text-xs font-mono tracking-widest uppercase text-[var(--text-muted)]">
        {materia.institution} • {materia.code}
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[var(--text-primary)] leading-tight">
        {materia.name}
      </h1>
      <p class="font-serif text-lg sm:text-xl text-[var(--text-secondary)] italic max-w-2xl mx-auto">
        {materia.period} — Caderno Integral de Estudos Teóricos e Questões Resolvidas
      </p>

      <div class="sans-ui flex items-center justify-center gap-4 pt-3 text-xs text-[var(--text-muted)]">
        <span id="header-chapters-count">{chaptersToRender.length} {chaptersToRender.length === 1 ? 'Capítulo' : 'Capítulos'} em Fluxo Contínuo</span>
        <span>•</span>
        <span id="header-questions-count">{questionsLinks.length} Questões Disponíveis</span>
      </div>
    </header>

    <!-- Alerta quando a tag selecionada não tiver capítulos -->
    <div id="no-chapters-for-tag" class={`${chaptersToRender.length === 0 && tagParam ? '' : 'hidden'} p-8 rounded-xl border border-dashed border-[var(--border-strong)] text-center text-sm text-[var(--text-secondary)] space-y-2`}>
      <p class="font-serif text-base font-bold text-[var(--text-primary)]">Nenhum capítulo teórico cadastrado para esta tag.</p>
      <p>Você pode acessar as questões diretamente pelo menu lateral ou escolher outra tag.</p>
    </div>

    <!-- Fluxo Contínuo de Leitura dos Capítulos -->
    <div class="space-y-20 w-full min-w-0" id="chapters-container" data-rendered-tag={tagParam || ''}>
      {chaptersToRender.map((resumo, idx) => {
        const isMateria = resumo.type === 'materia';
        const prefix = resumo.isFromOther ? `other-${resumo.ownerUserId}-` : '';
        const chapId = isMateria ? `${prefix}cap-materia-${resumo.chapter}` : `${prefix}cap-${resumo.chapter}`;

        return (
          <div class="space-y-12">
            <section
              id={chapId}
              data-chapter-id={resumo.id}
              data-chapter-owner={resumo.ownerUserId}
              data-chapter-tags={resumo.matchTags.join(',')}
              data-chapter-type={resumo.type || 'questoes'}
              class="chapter-section scroll-mt-20 space-y-8 w-full min-w-0"
            >
              <!-- Título do Capítulo -->
              <div class="space-y-2 border-b border-[var(--border-subtle)] pb-4">
                <div class="sans-ui flex flex-wrap items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-[var(--accent)]">
                  <span>Capítulo {resumo.chapter}</span>
                  {hasBothTypes && (
                    <>
                      <span>•</span>
                      <span class="text-[var(--text-muted)] font-normal">
                        {isMateria ? 'Resumo da Matéria' : 'Estudo Guiado por Questões'}
                      </span>
                    </>
                  )}
                  {resumo.isFromOther && (
                    <>
                      <span>•</span>
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                        De: {resumo.ownerDisplayName}
                      </span>
                    </>
                  )}
                </div>
                <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
                  {resumo.title}
                </h2>
                {resumo.description && (
                  <p class="font-serif text-base text-[var(--text-secondary)] italic">
                    {resumo.description}
                  </p>
                )}
              </div>

              <!-- Corpo do Capítulo: Compilado ou Lazy Placeholder sob demanda -->
              {resumo.htmlContent ? (
                <div
                  class="academic-prose leading-relaxed text-[var(--text-primary)] space-y-6 w-full min-w-0"
                  data-chapter-body={resumo.id}
                  data-loaded="true"
                  set:html={resumo.htmlContent}
                />
              ) : (
                <div
                  class="chapter-lazy-content"
                  data-chapter-body={resumo.id}
                  data-chapter-id={resumo.id}
                  data-chapter-owner={resumo.ownerUserId}
                  data-chapter-materia={resumo.materia}
                  data-chapter-title={resumo.title}
                  data-loaded="false"
                >
                  <div class="py-12 px-6 rounded-xl border border-dashed border-[var(--border-subtle)] bg-[var(--bg-surface)] text-center space-y-3 my-4">
                    <div class="inline-block w-5 h-5 border-2 border-[var(--accent)] border-t-transparent rounded-full animate-spin"></div>
                    <p class="font-serif text-sm text-[var(--text-secondary)] italic">
                      Avançando no material... Carregando Capítulo {resumo.chapter}: {resumo.title}
                    </p>
                  </div>
                </div>
              )}

              <!-- Divisor Clássico entre Capítulos -->
              {idx < chaptersToRender.length - 1 && (
                <div class="text-center py-8 text-[var(--text-muted)] font-serif select-none">
                  * * *
                </div>
              )}
            </section>
          </div>
        );
      })}
    </div>

    <!-- Final do Documento -->
    <div class="text-center pt-12 border-t border-[var(--border-strong)] sans-ui text-xs text-[var(--text-muted)] space-y-2">
      <p>Fim do Caderno Teórico de {materia.name}.</p>
      <p>
        Para praticar com mais exercícios, consulte o{' '}
        <a id="footer-banco-link" href={`/${materia.slug}/questoes${tagParam ? `?tag=${encodeURIComponent(tagParam)}` : ''}`} class="text-[var(--accent)] font-semibold hover:underline">
          Banco Completo de Questões Resolvidas
        </a>.
      </p>
    </div>

  </article>
</AcademicLayout>

<script is:inline define:vars={{
  materiaSlug: materia.slug,
  primaryOwnerId,
  clientCacheTtlMinutes,
  clientCacheMaxEntries,
}}>
  (function() {
    const promptEl = document.getElementById('tag-select-prompt');
    const notebookEl = document.getElementById('notebook-content');
    const activeLabelEl = document.getElementById('active-tag-display-name');
    const chaptersCountEl = document.getElementById('header-chapters-count');
    const btnSwitch = document.getElementById('btn-switch-tag');
    const noChaptersEl = document.getElementById('no-chapters-for-tag');
    const footerBancoLink = document.getElementById('footer-banco-link');
    const chaptersContainer = document.getElementById('chapters-container');

    // Inicializa parâmetros de retenção no cache persistente do cliente
    if (window.clientStudyCache && typeof window.clientStudyCache.setConfig === 'function') {
      window.clientStudyCache.setConfig({
        ttlMinutes: clientCacheTtlMinutes,
        maxEntries: clientCacheMaxEntries,
      });
    }

    function formatTagName(t) {
      if (!t) return '';
      if (t.includes('::')) {
        return t.split('::')[1];
      }
      return t;
    }

    // 1. Armazena no cache persistente os capítulos que já vieram renderizados pelo SSR (ex: Capítulo 1)
    function cacheRenderedChapters() {
      if (!window.clientStudyCache) return;
      const renderedBodies = document.querySelectorAll('[data-chapter-body][data-loaded="true"]');
      renderedBodies.forEach((el) => {
        const chId = el.getAttribute('data-chapter-body');
        const section = el.closest('section');
        const chOwner = parseInt(section?.dataset.chapterOwner || String(primaryOwnerId), 10);
        const chTitle = section?.querySelector('h2')?.textContent?.trim() || '';
        if (chId && el.innerHTML.trim()) {
          window.clientStudyCache.setChapter(materiaSlug, chOwner, chId, el.innerHTML, chTitle);
        }
      });
    }

    // 2. Carrega um capítulo individual sob demanda (via cache persistente ou API)
    let lazyObserver = null;

    async function loadSingleChapter(placeholderEl) {
      if (!placeholderEl || placeholderEl.getAttribute('data-loaded') === 'true') return;
      if (placeholderEl.getAttribute('data-loading') === 'true') return;
      placeholderEl.setAttribute('data-loading', 'true');

      const chId = placeholderEl.dataset.chapterId;
      const chOwner = parseInt(placeholderEl.dataset.chapterOwner || String(primaryOwnerId), 10);
      const chMateria = placeholderEl.dataset.chapterMateria || materiaSlug;
      const chTitle = placeholderEl.dataset.chapterTitle || '';

      // Passo A: Verifica se o capítulo já está no cache persistente do cliente (0ms)
      const cached = window.clientStudyCache?.getChapter(chMateria, chOwner, chId);
      if (cached) {
        placeholderEl.innerHTML = cached;
        placeholderEl.className = 'academic-prose leading-relaxed text-[var(--text-primary)] space-y-6 w-full min-w-0';
        placeholderEl.setAttribute('data-loaded', 'true');
        placeholderEl.removeAttribute('data-loading');
        window.dispatchEvent(new CustomEvent('study-content-updated'));
        return;
      }

      // Passo B: Compila apenas este capítulo sob demanda no servidor
      try {
        const res = await fetch(`/api/chapters?materia=${encodeURIComponent(chMateria)}&chapter_id=${encodeURIComponent(chId)}&owner=${encodeURIComponent(chOwner)}`);
        if (!res.ok) throw new Error('Falha ao carregar capítulo');
        const data = await res.json();
        const html = data.chapter?.htmlContent || '<p class="text-sm text-[var(--text-muted)] italic">Conteúdo indisponível.</p>';

        placeholderEl.innerHTML = html;
        placeholderEl.className = 'academic-prose leading-relaxed text-[var(--text-primary)] space-y-6 w-full min-w-0';
        placeholderEl.setAttribute('data-loaded', 'true');
        placeholderEl.removeAttribute('data-loading');

        // Salva no cache persistente do navegador (localStorage com TTL e LRU)
        window.clientStudyCache?.setChapter(chMateria, chOwner, chId, html, chTitle);

        window.dispatchEvent(new CustomEvent('study-content-updated'));
      } catch (err) {
        console.error('Erro ao carregar capítulo sob demanda:', err);
        placeholderEl.removeAttribute('data-loading');
        placeholderEl.innerHTML = `
          <div class="py-8 px-6 rounded-xl border border-dashed border-[var(--border-strong)] text-center space-y-3 my-4">
            <p class="font-serif text-sm text-[var(--text-muted)]">Ocorreu uma falha ao carregar este capítulo.</p>
            <button type="button" class="btn-retry-chapter px-3 py-1.5 rounded-lg bg-[var(--accent)] text-white text-xs font-semibold cursor-pointer">
              Tentar Novamente
            </button>
          </div>
        `;
        const retryBtn = placeholderEl.querySelector('.btn-retry-chapter');
        retryBtn?.addEventListener('click', () => loadSingleChapter(placeholderEl));
      }
    }

    window.loadSingleChapter = loadSingleChapter;

    // 3. Inicializa o IntersectionObserver para detecção antecipada (600px antes do scroll)
    function setupLazyChapters() {
      if (lazyObserver) {
        lazyObserver.disconnect();
      }

      const placeholders = document.querySelectorAll('.chapter-lazy-content[data-loaded="false"]');
      if (placeholders.length === 0) return;

      if ('IntersectionObserver' in window) {
        lazyObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const target = entry.target;
              lazyObserver.unobserve(target);
              loadSingleChapter(target);
            }
          });
        }, {
          rootMargin: '600px 0px',
          threshold: 0.01,
        });

        placeholders.forEach((el) => lazyObserver.observe(el));
      } else {
        // Fallback para navegadores sem IntersectionObserver
        placeholders.forEach((el) => loadSingleChapter(el));
      }
    }

    // 4. Se a URL contiver âncora (#...), navega e carrega o capítulo alvo
    function handleInitialHash() {
      if (window.location.hash) {
        const hash = window.location.hash.slice(1);
        if (typeof window.navigateToStudySection === 'function') {
          window.navigateToStudySection(hash, false);
        }
      }
    }

    // 6. Aplica a tag selecionada (sob demanda, no modo progressivo)
    async function applyActiveTag(tag) {
      if (!tag) {
        promptEl?.classList.remove('hidden');
        notebookEl?.classList.add('hidden');
        if (chaptersContainer) {
          chaptersContainer.setAttribute('data-rendered-tag', '');
        }
        return;
      }

      promptEl?.classList.add('hidden');
      notebookEl?.classList.remove('hidden');

      if (activeLabelEl) {
        activeLabelEl.textContent = formatTagName(tag);
      }

      if (footerBancoLink) {
        footerBancoLink.href = `/${materiaSlug}/questoes?tag=${encodeURIComponent(tag)}`;
      }

      const currentRenderedTag = chaptersContainer?.getAttribute('data-rendered-tag');
      if (currentRenderedTag === tag) {
        return;
      }

      if (chaptersContainer) {
        chaptersContainer.innerHTML = `
          <div class="py-16 text-center space-y-3">
            <div class="inline-block w-7 h-7 border-2 border-[var(--accent)] border-t-transparent rounded-full animate-spin"></div>
            <p class="font-serif text-sm text-[var(--text-secondary)] italic">Carregando avaliação...</p>
          </div>
        `;
      }

      try {
        const isOtherUser = tag.startsWith('user_') && tag.includes('::');
        let fetchOwner = primaryOwnerId;
        let fetchTag = tag;
        if (isOtherUser) {
          const parts = tag.split('::');
          fetchOwner = parseInt(parts[0].replace('user_', ''), 10);
          fetchTag = parts[1];
        }

        const res = await fetch(`/api/chapters?mode=progressive&materia=${encodeURIComponent(materiaSlug)}&tag=${encodeURIComponent(fetchTag)}&owner=${fetchOwner}`);
        if (!res.ok) throw new Error('Falha ao carregar capítulos');
        const data = await res.json();
        const chaps = data.chapters || [];

        if (chaptersContainer) {
          if (chaps.length === 0) {
            chaptersContainer.innerHTML = '';
            noChaptersEl?.classList.remove('hidden');
            if (chaptersCountEl) chaptersCountEl.textContent = '0 Capítulos';
          } else {
            noChaptersEl?.classList.add('hidden');
            let html = '';
            chaps.forEach((resumo, idx) => {
              const isMateria = resumo.type === 'materia';
              const prefix = isOtherUser ? `other-${resumo.ownerUserId}-` : '';
              const chapId = isMateria ? `${prefix}cap-materia-${resumo.chapter}` : `${prefix}cap-${resumo.chapter}`;

              // Checa se o capítulo já está salvo no cache persistente do cliente!
              const cachedHtml = window.clientStudyCache?.getChapter(materiaSlug, resumo.ownerUserId || fetchOwner, resumo.id);
              const isLoaded = Boolean(cachedHtml) || Boolean(resumo.htmlContent);
              const chapterContent = cachedHtml || resumo.htmlContent || '';

              html += `
                <div class="space-y-12">
                  <section
                    id="${chapId}"
                    data-chapter-id="${resumo.id}"
                    data-chapter-owner="${resumo.ownerUserId || fetchOwner}"
                    data-chapter-tags="${tag}"
                    data-chapter-type="${resumo.type || 'questoes'}"
                    class="chapter-section scroll-mt-20 space-y-8 w-full min-w-0"
                  >
                    <div class="space-y-2 border-b border-[var(--border-subtle)] pb-4">
                      <div class="sans-ui flex flex-wrap items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-[var(--accent)]">
                        <span>Capítulo ${resumo.chapter}</span>
                        ${isMateria ? '<span class="text-[var(--text-muted)] font-normal">• Resumo da Matéria</span>' : '<span class="text-[var(--text-muted)] font-normal">• Estudo Guiado por Questões</span>'}
                      </div>
                      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
                        ${resumo.title}
                      </h2>
                      ${resumo.description ? `<p class="font-serif text-base text-[var(--text-secondary)] italic">${resumo.description}</p>` : ''}
                    </div>

                    ${isLoaded ? `
                      <div
                        class="academic-prose leading-relaxed text-[var(--text-primary)] space-y-6 w-full min-w-0"
                        data-chapter-body="${resumo.id}"
                        data-loaded="true"
                      >
                        ${chapterContent}
                      </div>
                    ` : `
                      <div
                        class="chapter-lazy-content"
                        data-chapter-body="${resumo.id}"
                        data-chapter-id="${resumo.id}"
                        data-chapter-owner="${resumo.ownerUserId || fetchOwner}"
                        data-chapter-materia="${materiaSlug}"
                        data-chapter-title="${resumo.title}"
                        data-loaded="false"
                      >
                        <div class="py-12 px-6 rounded-xl border border-dashed border-[var(--border-subtle)] bg-[var(--bg-surface)] text-center space-y-3 my-4">
                          <div class="inline-block w-5 h-5 border-2 border-[var(--accent)] border-t-transparent rounded-full animate-spin"></div>
                          <p class="font-serif text-sm text-[var(--text-secondary)] italic">
                            Avançando no material... Carregando Capítulo ${resumo.chapter}: ${resumo.title}
                          </p>
                        </div>
                      </div>
                    `}

                    ${idx < chaps.length - 1 ? '<div class="text-center py-8 text-[var(--text-muted)] font-serif select-none">* * *</div>' : ''}
                  </section>
                </div>
              `;
            });

            chaptersContainer.innerHTML = html;
            chaptersContainer.setAttribute('data-rendered-tag', tag);

            if (chaptersCountEl) {
              chaptersCountEl.textContent = `${chaps.length} ${chaps.length === 1 ? 'Capítulo' : 'Capítulos'} em Fluxo Contínuo`;
            }

            cacheRenderedChapters();
            setupLazyChapters();
            handleInitialHash();
          }
          window.dispatchEvent(new CustomEvent('study-content-updated'));
        }
      } catch (err) {
        console.error('Erro ao buscar capítulos da tag:', err);
        if (chaptersContainer) {
          chaptersContainer.innerHTML = `
            <div class="p-6 rounded-xl border border-dashed border-[var(--border-strong)] text-center text-sm text-[var(--text-muted)] space-y-3">
              <p>Ocorreu um erro ao carregar os capítulos desta avaliação.</p>
              <button type="button" onclick="location.reload()" class="px-4 py-2 rounded-lg bg-[var(--accent)] text-white text-xs font-semibold cursor-pointer">
                Tentar Novamente
              </button>
            </div>
          `;
        }
      }
    }

    btnSwitch?.addEventListener('click', () => {
      if (typeof window.selectStudyTag === 'function') {
        window.selectStudyTag(null);
      }
    });

    window.addEventListener('study-tag-changed', (e) => {
      applyActiveTag(e.detail?.tag || null);
    });

    function initPageTag() {
      cacheRenderedChapters();
      setupLazyChapters();
      handleInitialHash();

      const cur = (typeof window.getCurrentStudyTag === 'function') ? window.getCurrentStudyTag() : null;
      if (cur) {
        applyActiveTag(cur);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPageTag);
    } else {
      initPageTag();
    }
  })();
</script>
