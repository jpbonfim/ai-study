---
---

<div class="relative theme-selector-root sans-ui">
  <!-- Botão Discreto de Ícone -->
  <button
    type="button"
    class="theme-dropdown-trigger flex items-center gap-1.5 p-1.5 px-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors text-xs font-medium cursor-pointer"
    aria-label="Selecionar modo de leitura"
    title="Ajustar tema de leitura (Papel, Escuro, OLED)"
  >
    <!-- Ícone de Paleta / Livro -->
    <svg class="w-4 h-4 text-[var(--accent)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
    </svg>
    <span class="current-theme-label text-[11px] font-mono capitalize">Papel</span>
    <svg class="w-3 h-3 text-[var(--text-muted)] transition-transform dropdown-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Popover Elegante -->
  <div
    class="theme-dropdown-menu hidden absolute right-0 sm:left-0 sm:right-auto mt-1.5 w-44 z-50 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] p-1 shadow-lg shadow-black/10 text-xs space-y-0.5"
  >
    <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border-subtle)] mb-1">
      Modo de Leitura
    </div>

    <button
      type="button"
      data-theme-val="paper"
      class="theme-opt-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded text-left text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
    >
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#e8decb] border border-[#b8ab96]"></span>
        <span>Papel / Sépia</span>
      </div>
      <span class="theme-check text-[var(--accent)] font-bold hidden">✓</span>
    </button>

    <button
      type="button"
      data-theme-val="dark"
      class="theme-opt-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded text-left text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
    >
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#2a2d36] border border-[#484e5c]"></span>
        <span>Escuro</span>
      </div>
      <span class="theme-check text-[var(--accent)] font-bold hidden">✓</span>
    </button>

    <button
      type="button"
      data-theme-val="oled"
      class="theme-opt-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded text-left text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors cursor-pointer"
    >
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#000000] border border-[#444444]"></span>
        <span>Preto OLED</span>
      </div>
      <span class="theme-check text-[var(--accent)] font-bold hidden">✓</span>
    </button>
  </div>
</div>

<script is:inline>
  function setupThemeSelectors() {
    function getThemeName() {
      return localStorage.getItem('study_theme') || 'paper';
    }

    function applyThemeGlobal(themeName) {
      const root = document.documentElement;
      root.classList.remove('theme-paper', 'theme-dark', 'theme-oled', 'dark');

      if (themeName === 'oled') {
        root.classList.add('dark', 'theme-oled');
      } else if (themeName === 'dark') {
        root.classList.add('dark', 'theme-dark');
      } else {
        root.classList.add('theme-paper');
      }

      localStorage.setItem('study_theme', themeName);
      updateAllThemeUI(themeName);
    }

    function updateAllThemeUI(themeName) {
      const labels = {
        paper: 'Papel',
        dark: 'Escuro',
        oled: 'OLED'
      };

      document.querySelectorAll('.current-theme-label').forEach((el) => {
        el.textContent = labels[themeName] || 'Papel';
      });

      document.querySelectorAll('.theme-opt-btn').forEach((btn) => {
        const val = btn.getAttribute('data-theme-val');
        const check = btn.querySelector('.theme-check');
        if (val === themeName) {
          btn.classList.add('font-semibold', 'text-[var(--text-primary)]', 'bg-[var(--bg-subtle)]');
          check?.classList.remove('hidden');
        } else {
          btn.classList.remove('font-semibold', 'text-[var(--text-primary)]', 'bg-[var(--bg-subtle)]');
          check?.classList.add('hidden');
        }
      });
    }

    // Inicialização
    const current = getThemeName();
    updateAllThemeUI(current);

    // Gerencia abertura/fechamento dos menus
    document.querySelectorAll('.theme-selector-root').forEach((root) => {
      const trigger = root.querySelector('.theme-dropdown-trigger');
      const menu = root.querySelector('.theme-dropdown-menu');
      const chevron = root.querySelector('.dropdown-chevron');

      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !menu?.classList.contains('hidden');
        // Fecha todos os outros primeiro
        document.querySelectorAll('.theme-dropdown-menu').forEach((m) => m.classList.add('hidden'));
        document.querySelectorAll('.dropdown-chevron').forEach((c) => c.classList.remove('rotate-180'));

        if (!isOpen) {
          menu?.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
        }
      });

      // Opções
      root.querySelectorAll('.theme-opt-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const val = btn.getAttribute('data-theme-val');
          if (val) {
            applyThemeGlobal(val);
          }
          menu?.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        });
      });
    });

    // Clique fora fecha o menu
    document.addEventListener('click', () => {
      document.querySelectorAll('.theme-dropdown-menu').forEach((m) => m.classList.add('hidden'));
      document.querySelectorAll('.dropdown-chevron').forEach((c) => c.classList.remove('rotate-180'));
    });
  }

  // Executa no carregamento
  setupThemeSelectors();
</script>
