---
interface Props {
  title?: string;
}

const {
  title = "Resolução Passo a Passo",
} = Astro.props;
---

<div class="question-resolution-card my-4 rounded border border-[var(--border-strong)] bg-[var(--bg-surface)] overflow-hidden transition-all duration-200" data-section="resolution">
  <button
    type="button"
    class="resolution-card-header w-full px-4 py-2.5 sm:px-5 sm:py-3 flex items-center justify-between text-left hover:bg-[var(--bg-surface-hover)] transition-colors cursor-pointer select-none"
    aria-expanded="false"
  >
    <div class="flex items-center gap-2.5">
      <span class="sans-ui font-mono font-bold text-xs px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-subtle)] text-[var(--accent)] shrink-0">
        &para;
      </span>
      <span class="sans-ui text-xs sm:text-sm font-semibold text-[var(--text-primary)] tracking-tight">
        {title}
      </span>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <span class="resolution-card-status sans-ui text-xs text-[var(--text-muted)] font-medium">Exibir Resolução</span>
      <span class="resolution-card-chevron text-xs text-[var(--text-muted)] transition-transform duration-150">&darr;</span>
    </div>
  </button>

  <div class="resolution-card-panel hidden border-t border-[var(--border-subtle)] p-5 sm:p-7 bg-[var(--bg-subtle)] academic-prose leading-relaxed text-[var(--text-primary)] space-y-6 w-full min-w-0">
    <slot />
  </div>
</div>
