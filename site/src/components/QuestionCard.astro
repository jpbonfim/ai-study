---
import { getEntry } from 'astro:content';
import { renderMath } from '../utils/katex';
import type { QuestionItem } from '../lib/mdx-runtime';

interface Props {
  id?: string;
  item?: QuestionItem;
}

const { id, item } = Astro.props;
let questao: any = item || null;

if (!questao && id) {
  try {
    questao = await getEntry('questoes', id);
  } catch (e) {
    // Fallback
  }
}

const isDirectItem = !!item;
const data = isDirectItem ? item : questao?.data;
const questionId = isDirectItem ? item.id : questao?.id;
const materiaSlug = data?.materia || 'pds';

const currentSubjectOwner = Astro.url.searchParams.get('owner');
const params = new URLSearchParams();
if (isDirectItem && (item as any)?.isFromOther && item.ownerUserId) {
  params.set('q_owner', String(item.ownerUserId));
}
if (currentSubjectOwner) {
  params.set('owner', currentSubjectOwner);
}
const queryString = params.toString() ? `?${params.toString()}` : '';
---

{data ? (
  <div class="question-card-preview my-2.5 sm:my-3 p-3 sm:p-3.5 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-subtle)] hover:border-[var(--accent)] not-prose shadow-2xs transition-all">
    <div class="sans-ui flex items-center justify-between gap-2 pb-1.5 mb-1.5 border-b border-[var(--border-subtle)] text-[10px] sm:text-[11px]">
      <div class="flex items-center gap-1.5 flex-wrap min-w-0">
        <span class="font-bold text-[var(--accent)] uppercase tracking-wider shrink-0">
          Exercício • {data.exam} ({data.year})
        </span>
        <span class="text-[var(--text-muted)] shrink-0">•</span>
        <span class="text-[var(--text-secondary)] font-medium truncate">
          {data.topic}
        </span>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="rounded px-1.5 py-0.5 bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[9.5px] sm:text-[10px] uppercase font-semibold text-[var(--text-muted)]">
          {data.type === 'discursiva' ? 'Dissertativa' : 'Múltipla Escolha'}
        </span>
        <span class="text-[var(--text-muted)] italic text-[9.5px] sm:text-[10px]">
          {data.difficulty}
        </span>
      </div>
    </div>

    <h4 class="font-serif text-sm sm:text-base font-bold text-[var(--text-primary)] mb-1 leading-snug">
      <a href={`/${materiaSlug}/questoes/${questionId}${queryString}`} class="hover:text-[var(--accent)] transition-colors">
        {data.title}
      </a>
    </h4>

    {data.statement && (
      <div
        class="academic-prose font-serif text-xs sm:text-[13px] text-[var(--text-secondary)] line-clamp-2 mb-2 leading-relaxed"
        set:html={data.renderedStatement || renderMath(data.statement)}
      />
    )}

    <div class="sans-ui flex items-center justify-between pt-1.5 border-t border-[var(--border-subtle)] text-[11px] sm:text-xs">
      <span class="font-mono text-[10px] text-[var(--text-muted)] truncate max-w-[150px]">{questionId}</span>
      <a
        href={`/${materiaSlug}/questoes/${questionId}${queryString}`}
        class="font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1 text-[11px] sm:text-xs shrink-0"
      >
        <span>Ver Resolução</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
) : (
  <div class="my-2 p-2.5 rounded border border-dashed border-[var(--border-strong)] text-xs text-[var(--text-muted)] not-prose">
    [Questão {id || ''} não encontrada no banco]
  </div>
)}
