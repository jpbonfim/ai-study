---
import { getEntry } from 'astro:content';
import { renderMath } from '../utils/katex';

interface Props {
  id: string;
}

const { id } = Astro.props;
let questao = null;
try {
  questao = await getEntry('questoes', id);
} catch (e) {
  // Ignora se não existir
}
---

{questao ? (
  <div class="my-8 p-6 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-subtle)] not-prose">
    <div class="sans-ui flex items-center justify-between gap-2 pb-3 mb-3 border-b border-[var(--border-subtle)] text-xs">
      <div class="flex items-center gap-2">
        <span class="font-bold text-[var(--accent)] uppercase tracking-wider">
          Exercício de Prova • {questao.data.exam} ({questao.data.year})
        </span>
        <span class="text-[var(--text-muted)]">•</span>
        <span class="text-[var(--text-secondary)]">
          {questao.data.topic}
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span class="rounded px-1.5 py-0.5 bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[10px] uppercase font-semibold text-[var(--text-muted)]">
          {questao.data.type === 'discursiva' ? 'Dissertativa' : 'Múltipla Escolha'}
        </span>
        <span class="text-[var(--text-muted)] italic">
          {questao.data.difficulty}
        </span>
      </div>
    </div>

    <h4 class="font-serif text-lg font-bold text-[var(--text-primary)] mb-2">
      {questao.data.title}
    </h4>

    {questao.data.statement && (
      <div
        class="font-serif text-base text-[var(--text-secondary)] mb-4 leading-relaxed"
        set:html={renderMath(questao.data.statement)}
      />
    )}

    <div class="sans-ui flex items-center justify-between pt-3 border-t border-[var(--border-subtle)] text-xs">
      <span class="text-[var(--text-muted)] italic">
        Gabarito oficial comentado
      </span>
      <a
        href={`/${questao.data.materia || 'pds'}/questoes/${questao.id}`}
        class="font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1"
      >
        <span>Consultar Resolução Passo a Passo</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
) : (
  <div class="my-4 p-3 rounded border border-dashed border-[var(--border-strong)] text-xs text-[var(--text-muted)] not-prose">
    [Questão {id} não encontrada no banco]
  </div>
)}
