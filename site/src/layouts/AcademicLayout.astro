---
import '../styles/global.css';
import HeaderActions from '../components/HeaderActions.astro';
import type { Subject } from '../data/materias';

interface TocItem {
  id: string;
  title: string;
  subsections?: { id: string; title: string }[];
  tags?: string[];
  type?: 'materia' | 'questoes';
}

interface QuestionLink {
  id: string;
  title: string;
  exam: string;
  year: number;
  tags?: string[];
}

export interface TagOption {
  id: string;
  label: string;
  chaptersCount?: number;
  questionsCount?: number;
}

interface Props {
  title: string;
  materia?: Subject;
  availableTags?: TagOption[];
  activeTag?: string | null;
  currentQuestionId?: string;
  toc?: TocItem[];
  questions?: QuestionLink[];
  activeSectionId?: string;
  wide?: boolean;
}

const {
  title,
  materia,
  availableTags = [],
  activeTag = null,
  currentQuestionId,
  toc = [],
  questions = [],
  activeSectionId,
  wide = false,
} = Astro.props;

const materiaToc = toc.filter((item) => item.type === 'materia');
const questoesToc = toc.filter((item) => item.type !== 'materia');
const hasBothTocTypes = materiaToc.length > 0 && questoesToc.length > 0;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Caderno de Estudos</title>

    <!-- Fontes Acadêmicas Clássicas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;500&family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <!-- Script inline para inicialização imediata do tema e preferências de leitura sem flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem('study_theme') || 'paper';
      const root = document.documentElement;
      root.classList.remove('theme-paper', 'theme-dark', 'theme-oled', 'dark');
      if (savedTheme === 'oled') {
        root.classList.add('dark', 'theme-oled');
      } else if (savedTheme === 'dark') {
        root.classList.add('dark', 'theme-dark');
      } else {
        root.classList.add('theme-paper');
      }

      if (localStorage.getItem('study_sidebar_collapsed') === 'true') {
        root.classList.add('sidebar-collapsed');
      }

      // Evita animação indesejada de scroll ao navegar para âncoras/seções
      if (window.location.hash) {
        root.style.scrollBehavior = 'auto';
      }

      // Aplica preferências personalizadas salvas
      const font = localStorage.getItem('study_font_family');
      const size = localStorage.getItem('study_font_size');
      const width = localStorage.getItem('study_max_width');
      if (font) root.style.setProperty('--reader-font-family', font);
      if (size) root.style.setProperty('--reader-font-size', size);
      if (width) root.style.setProperty('--reader-max-width', width);

      // Preferências de código (tema e fonte monoespaçada reduzida)
      const codeTheme = localStorage.getItem('study_code_theme') || 'mocha';
      const codeFont = localStorage.getItem('study_code_font') || "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace";
      const codeSize = localStorage.getItem('study_code_size') || '13px';
      root.setAttribute('data-code-theme', codeTheme);
      root.style.setProperty('--code-font-family', codeFont);
      root.style.setProperty('--code-font-size', codeSize);

      // Preferências de fórmulas matemáticas (LaTeX/KaTeX)
      const mathScriptScale = localStorage.getItem('study_math_script_scale') || '0.64';
      const mathMinSize = localStorage.getItem('study_math_min_size') || '10.5px';
      root.style.setProperty('--katex-script-scale', mathScriptScale);
      root.style.setProperty('--katex-min-font-size', mathMinSize);
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] transition-colors duration-200">
    
    <!-- Barra Superior Mobile (Sempre Visível e Fixada no Topo) -->
    <header class="lg:hidden fixed top-0 left-0 right-0 z-30 h-14 flex items-center px-4 border-b border-[var(--border-subtle)] bg-[var(--bg-page)]/95 backdrop-blur-md shadow-xs">
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <button
          id="mobile-sidebar-toggle"
          type="button"
          aria-label="Abrir Índice e Sumário"
          class="sans-ui p-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] shrink-0 cursor-pointer shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
        </button>
        <div class="min-w-0 flex-1 flex items-center">
          <span id="mobile-current-section" class="font-serif text-sm font-bold truncate text-[var(--text-primary)] leading-normal">
            {toc && toc.length > 0 ? toc[0].title : title}
          </span>
        </div>
      </div>
    </header>

    <!-- Espaçador para compensar o cabeçalho fixo no mobile -->
    <div class="h-14 lg:hidden w-full shrink-0" aria-hidden="true"></div>

    <div class="flex w-full min-w-0">
      
      <!-- MENU LATERAL ESQUERDO (Fixo no Desktop, Gaveta no Mobile) -->
      <aside
        id="academic-sidebar"
        class="fixed inset-y-0 left-0 z-40 w-80 max-w-[85vw] -translate-x-full lg:translate-x-0 transition-transform duration-200 border-r border-[var(--border-subtle)] bg-[var(--bg-surface)] flex flex-col justify-between overflow-y-auto"
      >
        <div class="p-6 space-y-6">
          
          <!-- Cabeçalho do Menu Lateral -->
          <div class="space-y-3 pb-5 border-b border-[var(--border-subtle)]">
            <div class="flex items-center justify-between gap-2">
              <a
                href="/"
                class="sans-ui inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Todas as Matérias</span>
              </a>

              <!-- Dois Botões Redondos (Tema + Configurações) -->
              <HeaderActions />
            </div>

            {materia && (
              <div class="pt-1">
                <span class="sans-ui text-[11px] font-mono uppercase tracking-widest text-[var(--accent)] block font-semibold">
                  {materia.code} • {materia.institution}
                </span>
                <div class="flex items-center justify-between gap-2 mt-1">
                  <h2 class="font-serif text-lg font-bold text-[var(--text-primary)] leading-snug">
                    <a href={`/${materia.slug}`} class="hover:text-[var(--accent)] transition-colors">
                      {materia.name}
                    </a>
                  </h2>
                  <a
                    href={`/downloads/${materia.slug}.html`}
                    download={`${materia.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.html`}
                    class="sans-ui inline-flex items-center justify-center p-1.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-all shrink-0 cursor-pointer shadow-xs group"
                    title={`Baixar todo o conteúdo de ${materia.name} em HTML offline standalone`}
                    aria-label={`Baixar ${materia.name} offline`}
                  >
                    <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                  </a>
                </div>
              </div>
            )}
          </div>

          <!-- Seletor Dropdown Customizado de Avaliações / Tags (Estilo Acadêmico Integrado) -->
          {availableTags && availableTags.length > 0 && (
            <div class="space-y-2 pb-4 border-b border-[var(--border-subtle)]" id="sidebar-tag-section">
              <div class="sans-ui flex items-center justify-between text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
                <button
                  type="button"
                  id="sidebar-tag-label-btn"
                  class="flex items-center gap-1.5 cursor-pointer hover:text-[var(--accent)] transition-colors text-left"
                  title="Clique para alternar opções de avaliação"
                >
                  <svg class="w-3.5 h-3.5 text-[var(--accent)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                  </svg>
                  <span>Avaliação / Tag</span>
                </button>
                <span class="text-[10px] font-mono lowercase tracking-tight text-[var(--text-muted)]" id="sidebar-active-tag-hint">
                  (selecione para ver)
                </span>
              </div>

              <!-- Select nativo oculto para compatibilidade com automações e scripts legados -->
              <select id="sidebar-tag-select" class="sr-only" tabindex="-1" aria-hidden="true">
                <option value="">-- Todas as Avaliações / Início --</option>
                {availableTags.map((tag) => (
                  <option value={tag.id}>
                    {tag.id} {tag.questionsCount !== undefined && tag.questionsCount > 0 ? `(${tag.questionsCount} questões)` : ''}
                  </option>
                ))}
              </select>

              <!-- Componente de Dropdown Customizado (Totalmente Estilizado via Variáveis do Tema) -->
              <div class="relative w-full" id="sidebar-tag-custom-dropdown">
                <button
                  type="button"
                  id="sidebar-tag-trigger"
                  class="sans-ui w-full flex items-center justify-between pl-3 pr-2.5 py-2 text-xs sm:text-[13px] font-medium rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-page)] text-[var(--text-secondary)] shadow-2xs hover:bg-[var(--bg-surface-hover)] hover:border-[var(--accent)] hover:text-[var(--accent)] focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20 focus:outline-none cursor-pointer transition-all duration-200 group text-left"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <div class="flex items-center gap-2 min-w-0 truncate">
                    <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                    </svg>
                    <span id="sidebar-tag-selected-label" class="truncate">
                      -- Todas as Avaliações / Início --
                    </span>
                  </div>

                  <svg
                    id="sidebar-tag-chevron"
                    class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-transform duration-200 shrink-0 ml-1.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>

                <!-- Menu Dropdown Popover Customizado com Cores Harmoniosas -->
                <div
                  id="sidebar-tag-menu"
                  class="hidden absolute left-0 right-0 top-full mt-1.5 z-50 rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] p-1 shadow-xl shadow-black/15 text-xs sm:text-[13px] space-y-0.5 max-h-60 overflow-y-auto"
                  role="listbox"
                  tabindex="-1"
                >
                  <button
                    type="button"
                    data-tag-value=""
                    data-tag-label="-- Todas as Avaliações / Início --"
                    class="tag-opt-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded-md text-left text-[var(--text-secondary)] hover:text-[var(--accent)] hover:bg-[var(--accent-subtle)] focus:text-[var(--accent)] focus:bg-[var(--accent-subtle)] focus:outline-none transition-colors duration-150 cursor-pointer group"
                    role="option"
                  >
                    <span class="truncate">-- Todas as Avaliações / Início --</span>
                    <span class="tag-opt-check text-[var(--accent)] font-bold shrink-0 ml-1.5 hidden">✓</span>
                  </button>

                  {availableTags.map((tag) => {
                    const displayLabel = `${tag.id}${tag.questionsCount !== undefined && tag.questionsCount > 0 ? ` (${tag.questionsCount} questões)` : ''}`;
                    return (
                      <button
                        type="button"
                        data-tag-value={tag.id}
                        data-tag-label={displayLabel}
                        class="tag-opt-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded-md text-left text-[var(--text-secondary)] hover:text-[var(--accent)] hover:bg-[var(--accent-subtle)] focus:text-[var(--accent)] focus:bg-[var(--accent-subtle)] focus:outline-none transition-colors duration-150 cursor-pointer group"
                        role="option"
                      >
                        <span class="truncate font-mono">{displayLabel}</span>
                        <span class="tag-opt-check text-[var(--accent)] font-bold shrink-0 ml-1.5 hidden">✓</span>
                      </button>
                    );
                  })}
                </div>
              </div>
            </div>
          )}

          <!-- Sumário do Documento (Capítulos e Seções) -->
          {toc.length > 0 && (
            <div class="space-y-3" id="sidebar-toc-container">
              <div class="sans-ui flex items-center justify-between text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
                <span>Conteúdo</span>
                <span class="text-[10px] lowercase font-normal opacity-80">(clique para ir)</span>
              </div>

              <!-- Estado Vazio quando nenhuma tag estiver selecionada -->
              <div id="sidebar-toc-empty" class="hidden p-3 rounded-lg border border-dashed border-[var(--border-subtle)] bg-[var(--bg-subtle)]/50 text-xs text-[var(--text-muted)] text-center italic">
                Selecione uma tag acima para visualizar o sumário.
              </div>

              <nav class="space-y-2 text-sm" id="sidebar-toc-nav">
                {hasBothTocTypes ? (
                  <div class="space-y-2.5" id="sidebar-toc-groups">
                    
                    <!-- Aba Colapsável: Resumo da Matéria -->
                    <div class="toc-collapsible-group space-y-1 border border-[var(--border-subtle)] rounded-lg p-2 bg-[var(--bg-surface)] shadow-2xs" data-group-type="materia">
                      <button
                        type="button"
                        class="toc-collapsible-btn sans-ui w-full flex items-center justify-between py-1 px-1.5 rounded-md text-xs font-bold text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors cursor-pointer select-none group"
                        aria-expanded="true"
                        data-target-group="materia"
                      >
                        <span class="flex items-center gap-1.5 truncate">
                          <svg class="w-3.5 h-3.5 text-[var(--accent)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                          </svg>
                          <span class="tracking-wide">Resumo da matéria</span>
                        </span>
                        <svg class="toc-collapsible-chevron w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </button>
                      <div class="toc-collapsible-content space-y-1 pt-1" data-group-content="materia">
                        {materiaToc.map((chap) => (
                          <div
                            class="space-y-0.5 sidebar-chapter-item"
                            data-chapter-tags={(chap.tags || []).join(',')}
                            data-chapter-type="materia"
                          >
                            <a
                              href={materia ? `/${materia.slug}#${chap.id}` : `#${chap.id}`}
                              data-toc-id={chap.id}
                              data-toc-title={chap.title}
                              class="toc-item toc-chapter-link block font-serif font-bold text-sm text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors py-1 px-2 rounded-md"
                            >
                              {chap.title}
                            </a>
                            {chap.subsections && chap.subsections.length > 0 && (
                              <div class="pl-2.5 border-l-2 border-[var(--border-subtle)] space-y-0.5 ml-2 mt-0.5">
                                {chap.subsections.map((sub) => (
                                  <a
                                    href={materia ? `/${materia.slug}#${sub.id}` : `#${sub.id}`}
                                    data-toc-id={sub.id}
                                    data-toc-title={sub.title}
                                    data-parent-id={chap.id}
                                    class="toc-item toc-sub-link sans-ui block text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] py-0.5 px-1.5 rounded transition-colors leading-snug"
                                  >
                                    {sub.title}
                                  </a>
                                ))}
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>

                    <!-- Aba Colapsável: Estudo Guiado por Questões -->
                    <div class="toc-collapsible-group space-y-1 border border-[var(--border-subtle)] rounded-lg p-2 bg-[var(--bg-surface)] shadow-2xs" data-group-type="questoes">
                      <button
                        type="button"
                        class="toc-collapsible-btn sans-ui w-full flex items-center justify-between py-1 px-1.5 rounded-md text-xs font-bold text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors cursor-pointer select-none group"
                        aria-expanded="true"
                        data-target-group="questoes"
                      >
                        <span class="flex items-center gap-1.5 truncate">
                          <svg class="w-3.5 h-3.5 text-[var(--accent)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                          </svg>
                          <span class="tracking-wide">Estudo guiado por questões</span>
                        </span>
                        <svg class="toc-collapsible-chevron w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </button>
                      <div class="toc-collapsible-content space-y-1 pt-1" data-group-content="questoes">
                        {questoesToc.map((chap) => (
                          <div
                            class="space-y-0.5 sidebar-chapter-item"
                            data-chapter-tags={(chap.tags || []).join(',')}
                            data-chapter-type="questoes"
                          >
                            <a
                              href={materia ? `/${materia.slug}#${chap.id}` : `#${chap.id}`}
                              data-toc-id={chap.id}
                              data-toc-title={chap.title}
                              class="toc-item toc-chapter-link block font-serif font-bold text-sm text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors py-1 px-2 rounded-md"
                            >
                              {chap.title}
                            </a>
                            {chap.subsections && chap.subsections.length > 0 && (
                              <div class="pl-2.5 border-l-2 border-[var(--border-subtle)] space-y-0.5 ml-2 mt-0.5">
                                {chap.subsections.map((sub) => (
                                  <a
                                    href={materia ? `/${materia.slug}#${sub.id}` : `#${sub.id}`}
                                    data-toc-id={sub.id}
                                    data-toc-title={sub.title}
                                    data-parent-id={chap.id}
                                    class="toc-item toc-sub-link sans-ui block text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] py-0.5 px-1.5 rounded transition-colors leading-snug"
                                  >
                                    {sub.title}
                                  </a>
                                ))}
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>

                  </div>
                ) : (
                  <div class="space-y-1.5" id="sidebar-toc-direct">
                    {toc.map((chap) => (
                      <div
                        class="space-y-0.5 sidebar-chapter-item"
                        data-chapter-tags={(chap.tags || []).join(',')}
                        data-chapter-type={chap.type || 'questoes'}
                      >
                        <a
                          href={materia ? `/${materia.slug}#${chap.id}` : `#${chap.id}`}
                          data-toc-id={chap.id}
                          data-toc-title={chap.title}
                          class="toc-item toc-chapter-link block font-serif font-bold text-sm text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors py-1.5 px-2.5 rounded-md"
                        >
                          {chap.title}
                        </a>
                        {chap.subsections && chap.subsections.length > 0 && (
                          <div class="pl-3 border-l-2 border-[var(--border-subtle)] space-y-0.5 ml-2 mt-0.5">
                            {chap.subsections.map((sub) => (
                              <a
                                href={materia ? `/${materia.slug}#${sub.id}` : `#${sub.id}`}
                                data-toc-id={sub.id}
                                data-toc-title={sub.title}
                                data-parent-id={chap.id}
                                class="toc-item toc-sub-link sans-ui block text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] py-1 px-2 rounded transition-colors leading-snug"
                              >
                                {sub.title}
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </nav>
            </div>
          )}

          <!-- Banco de Questões -->
          {questions.length > 0 && materia && (
            <div class="space-y-3 pt-4 border-t border-[var(--border-subtle)]" id="sidebar-questions-container">
              <div class="sans-ui flex items-center justify-between text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">
                <span>Questões Resolvidas</span>
                <a
                  id="sidebar-questions-bank-link"
                  href={`/${materia.slug}/questoes`}
                  class="text-[11px] font-normal text-[var(--accent)] hover:underline"
                >
                  Ver banco ({questions.length})
                </a>
              </div>

              <!-- Estado Vazio quando nenhuma tag estiver selecionada -->
              <div id="sidebar-questions-empty" class="hidden p-3 rounded-lg border border-dashed border-[var(--border-subtle)] bg-[var(--bg-subtle)]/50 text-xs text-[var(--text-muted)] text-center italic">
                Selecione uma tag acima para visualizar as questões.
              </div>

              <div class="space-y-1.5" id="sidebar-questions-list">
                {questions.map((q, idx) => (
                  <a
                    href={`/${materia.slug}/questoes/${q.id}`}
                    data-question-id={q.id}
                    data-question-order={idx}
                    data-question-tags={(q.tags || []).join(',')}
                    class:list={[
                      "sidebar-question-item sans-ui block text-xs p-2 rounded-md border transition-all",
                      currentQuestionId === q.id
                        ? "bg-[var(--accent-subtle)] border-[var(--accent)]/40 text-[var(--accent)] font-semibold"
                        : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] border-transparent hover:border-[var(--border-subtle)]"
                    ]}
                  >
                    <div class="font-medium truncate">
                      {q.exam} ({q.year}) — {q.title}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- Rodapé do Menu Lateral -->
        <div class="p-4 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-muted)] sans-ui">
          Caderno Acadêmico de Estudos
        </div>
      </aside>

      <!-- Overlay para Mobile quando o Menu estiver aberto -->
      <div
        id="sidebar-backdrop"
        class="fixed inset-0 z-30 bg-black/50 lg:hidden hidden"
      ></div>

      <!-- Botão Flutuante no Canto Superior Esquerdo para Reabrir Menu Lateral no Desktop (Clean e Transparente) -->
      <button
        id="desktop-sidebar-open-btn"
        type="button"
        class="desktop-sidebar-open-btn hidden fixed top-4 left-4 z-40 p-1 bg-transparent border-0 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-all cursor-pointer items-center justify-center focus:outline-none group"
        aria-label="Abrir menu lateral"
        title="Abrir menu lateral"
      >
        <svg class="w-6 h-6 sm:w-7 sm:h-7 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- ÁREA DE LEITURA PRINCIPAL (Largura configurável e contenção de layout) -->
      <main id="main-content-area" class:list={["flex-1 lg:pl-80 w-full min-w-0 transition-[padding] duration-200", wide ? "" : "overflow-x-clip"]}>
        <div class:list={[
          "mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-14 w-full min-w-0",
          wide ? "max-w-7xl 2xl:max-w-[94rem]" : "reader-column"
        ]}>
          <slot />
        </div>
      </main>

    </div>

    <!-- Script de rastreamento de matéria recente e última posição de estudo -->
    {materia && (
      <script is:inline define:vars={{
        curMat: {
          slug: materia.slug,
          name: materia.name,
          code: materia.code,
          institution: materia.institution,
          period: materia.period,
          chaptersCount: materia.chaptersCount,
          questionsCount: materia.questionsCount
        },
        pageTitle: title
      }}>
        try {
          if (typeof localStorage !== 'undefined') {
            function saveCurrentStudyPosition(extraSectionTitle, extraHash) {
              try {
                const now = new Date().toISOString();
                const currentPath = window.location.pathname;
                const currentSearch = window.location.search;
                const currentHash = extraHash !== undefined ? extraHash : window.location.hash;
                const fullUrl = currentPath + currentSearch + (currentHash || '');

                const isQuestionPage = currentPath.includes('/questoes/');
                const isQuestionsBank = currentPath.endsWith('/questoes') || currentPath.endsWith('/questoes/');

                let sectionDesc = extraSectionTitle || pageTitle;
                if (!extraSectionTitle) {
                  if (isQuestionPage) {
                    sectionDesc = pageTitle;
                  } else if (isQuestionsBank) {
                    sectionDesc = 'Banco de Questões Resolvidas';
                  } else if (currentHash) {
                    const hashEl = document.querySelector(`a[href*="${currentHash}"]`);
                    if (hashEl && hashEl.textContent) {
                      sectionDesc = hashEl.textContent.trim();
                    }
                  }
                }

                const data = {
                  ...curMat,
                  pageTitle: pageTitle,
                  lastSectionTitle: sectionDesc,
                  lastUrl: fullUrl,
                  url: fullUrl,
                  visitedAt: now
                };
                localStorage.setItem('last_visited_subject', JSON.stringify(data));

                // Histórico ordenado de matérias acessadas recentemente
                let recentList = [];
                try {
                  recentList = JSON.parse(localStorage.getItem('study_recent_materias') || '[]');
                } catch(e) {}
                if (!Array.isArray(recentList)) recentList = [];
                recentList = recentList.filter(item => item && item.slug !== curMat.slug);
                recentList.unshift({
                  slug: curMat.slug,
                  lastUrl: fullUrl,
                  lastSectionTitle: sectionDesc,
                  visitedAt: now
                });
                localStorage.setItem('study_recent_materias', JSON.stringify(recentList.slice(0, 30)));
              } catch(e) {}
            }

            window._saveCurrentStudyPosition = saveCurrentStudyPosition;
            saveCurrentStudyPosition();

            window.addEventListener('visibilitychange', () => {
              if (document.visibilityState === 'hidden') {
                saveCurrentStudyPosition();
              }
            });
          }
        } catch (e) {
          console.error(e);
        }
      </script>
    )}

    <!-- Script de Gestão e Filtragem de Tags / Avaliações -->
    {materia && (
      <script is:inline define:vars={{ materiaSlug: materia.slug, defaultInitialTag: activeTag, currentQuestionId: currentQuestionId || null }}>
        (function() {
          const storageKey = 'study_selected_tag_' + materiaSlug;
          const recentQuestionsStorageKey = 'study_recent_questions_' + materiaSlug;
          let currentActiveTag = null;

          function getRecentQuestions() {
            try {
              const raw = localStorage.getItem(recentQuestionsStorageKey);
              const parsed = JSON.parse(raw || '[]');
              return Array.isArray(parsed) ? parsed : [];
            } catch(e) {
              return [];
            }
          }

          function recordVisitedQuestion(qId) {
            if (!qId || qId === 'questoes' || qId === 'index') return;
            try {
              let recents = getRecentQuestions();
              recents = recents.filter(id => id && id !== qId);
              recents.unshift(qId);
              localStorage.setItem(recentQuestionsStorageKey, JSON.stringify(recents.slice(0, 50)));
            } catch(e) {}
          }

          // Se estivermos em uma página de questão, registra imediatamente o acesso
          const qPathMatch = window.location.pathname.match(new RegExp(`/${materiaSlug}/questoes/([^/?#]+)`));
          const detectedQuestionId = currentQuestionId || (qPathMatch && qPathMatch[1] && qPathMatch[1] !== 'questoes' ? qPathMatch[1] : null);
          if (detectedQuestionId) {
            recordVisitedQuestion(detectedQuestionId);
          }

          // Rastreia cliques em links de questões no site para atualizar o histórico imediatamente
          document.addEventListener('click', (e) => {
            const link = e.target.closest('a[href*="/questoes/"], a[data-question-id]');
            if (link) {
              const qId = link.getAttribute('data-question-id') || (function() {
                try {
                  const href = link.getAttribute('href') || '';
                  const m = href.match(/\/questoes\/([^/?#]+)/);
                  return m ? m[1] : null;
                } catch(err) { return null; }
              })();
              if (qId && qId !== 'questoes') {
                recordVisitedQuestion(qId);
              }
            }
          });

          function getParamTag() {
            try {
              const params = new URLSearchParams(window.location.search);
              return params.get('tag');
            } catch(e) {
              return null;
            }
          }

          function getSavedTag() {
            try {
              return localStorage.getItem(storageKey);
            } catch(e) {
              return null;
            }
          }

          function updateSidebarUI(tag) {
            const tagSelect = document.getElementById('sidebar-tag-select');
            const activeHint = document.getElementById('sidebar-active-tag-hint');
            const tocEmpty = document.getElementById('sidebar-toc-empty');
            const tocNav = document.getElementById('sidebar-toc-nav');
            const questionsEmpty = document.getElementById('sidebar-questions-empty');
            const questionsList = document.getElementById('sidebar-questions-list');
            const bankLink = document.getElementById('sidebar-questions-bank-link');
            const trigger = document.getElementById('sidebar-tag-trigger');
            const selectedLabelEl = document.getElementById('sidebar-tag-selected-label');

            if (tagSelect && tagSelect.value !== (tag || '')) {
              tagSelect.value = tag || '';
            }

            // Sincroniza o estado das opções customizadas e o texto do botão
            let activeLabel = '-- Todas as Avaliações / Início --';
            document.querySelectorAll('.tag-opt-btn').forEach((btn) => {
              const val = btn.getAttribute('data-tag-value') || '';
              const check = btn.querySelector('.tag-opt-check');
              const isMatch = (val === (tag || ''));
              if (isMatch) {
                activeLabel = btn.getAttribute('data-tag-label') || activeLabel;
                btn.classList.add('font-semibold', 'text-[var(--accent)]', 'bg-[var(--accent-subtle)]');
                btn.classList.remove('text-[var(--text-secondary)]');
                btn.setAttribute('aria-selected', 'true');
                check?.classList.remove('hidden');
              } else {
                btn.classList.remove('font-semibold', 'text-[var(--accent)]', 'bg-[var(--accent-subtle)]');
                btn.classList.add('text-[var(--text-secondary)]');
                btn.setAttribute('aria-selected', 'false');
                check?.classList.add('hidden');
              }
            });

            if (selectedLabelEl) {
              selectedLabelEl.textContent = activeLabel;
              if (tag) {
                selectedLabelEl.classList.add('font-mono');
              } else {
                selectedLabelEl.classList.remove('font-mono');
              }
            }

            if (trigger) {
              if (tag) {
                trigger.classList.add('border-[var(--accent)]', 'bg-[var(--accent-subtle)]/35', 'text-[var(--accent)]', 'font-semibold');
                trigger.classList.remove('border-[var(--border-subtle)]', 'bg-[var(--bg-page)]', 'text-[var(--text-secondary)]');
              } else {
                trigger.classList.remove('border-[var(--accent)]', 'bg-[var(--accent-subtle)]/35', 'text-[var(--accent)]', 'font-semibold');
                trigger.classList.add('border-[var(--border-subtle)]', 'bg-[var(--bg-page)]', 'text-[var(--text-secondary)]');
              }
            }

            // Filtra e organiza as questões do menu lateral
            const allQuestionItems = Array.from(document.querySelectorAll('.sidebar-question-item'));
            const recentIds = getRecentQuestions();

            const matchingItems = [];
            const nonMatchingItems = [];

            allQuestionItems.forEach((item) => {
              const itemTags = (item.getAttribute('data-question-tags') || '').split(',').map(s => s.trim());
              const matches = !tag || itemTags.includes(tag);
              if (matches) {
                matchingItems.push(item);
              } else {
                nonMatchingItems.push(item);
              }
            });

            // Oculta itens que não pertencem à tag ativa
            nonMatchingItems.forEach(item => item.classList.add('hidden'));

            // Atualiza o link "Ver banco (XX)" com a contagem total de questões no banco para esta tag
            if (bankLink) {
              bankLink.href = tag ? `/${materiaSlug}/questoes?tag=${tag}` : `/${materiaSlug}/questoes`;
              bankLink.textContent = `Ver banco (${matchingItems.length})`;
            }

            if (!tag) {
              if (activeHint) activeHint.textContent = '(nenhuma selecionada)';
              if (tocEmpty) tocEmpty.classList.remove('hidden');
              if (tocNav) tocNav.classList.add('hidden');
              if (questionsEmpty) questionsEmpty.classList.remove('hidden');
              if (questionsList) questionsList.classList.add('hidden');
              return;
            }

            if (activeHint) activeHint.textContent = `(ativo: ${tag})`;

            // Filtra os capítulos do sumário no menu lateral
            let visibleChapters = 0;
            let visibleMateria = 0;
            let visibleQuestoes = 0;

            document.querySelectorAll('.sidebar-chapter-item').forEach(item => {
              const itemTags = (item.getAttribute('data-chapter-tags') || '').split(',').map(s => s.trim());
              const itemType = item.getAttribute('data-chapter-type') || 'questoes';
              if (itemTags.includes(tag)) {
                item.classList.remove('hidden');
                visibleChapters++;
                if (itemType === 'materia') visibleMateria++;
                else visibleQuestoes++;
              } else {
                item.classList.add('hidden');
              }
            });

            // Atualiza visibilidade dos grupos colapsáveis caso existam
            const groupMateria = document.querySelector('.toc-collapsible-group[data-group-type="materia"]');
            const groupQuestoes = document.querySelector('.toc-collapsible-group[data-group-type="questoes"]');

            if (groupMateria) {
              if (visibleMateria > 0) groupMateria.classList.remove('hidden');
              else groupMateria.classList.add('hidden');
            }
            if (groupQuestoes) {
              if (visibleQuestoes > 0) groupQuestoes.classList.remove('hidden');
              else groupQuestoes.classList.add('hidden');
            }

            if (visibleChapters > 0) {
              tocEmpty?.classList.add('hidden');
              tocNav?.classList.remove('hidden');
            } else {
              tocEmpty?.classList.remove('hidden');
              tocNav?.classList.add('hidden');
            }

            // Ordena as questões correspondentes:
            // 1. As mais recentemente acessadas vêm no topo (da mais recente para a mais antiga)
            // 2. As demais mantêm a ordem padrão de cadastro
            matchingItems.sort((a, b) => {
              const idA = a.getAttribute('data-question-id') || '';
              const idB = b.getAttribute('data-question-id') || '';
              const posA = recentIds.indexOf(idA);
              const posB = recentIds.indexOf(idB);

              if (posA !== -1 && posB !== -1) {
                return posA - posB; // Mais recente (índice 0) primeiro
              }
              if (posA !== -1) return -1;
              if (posB !== -1) return 1;

              const orderA = parseInt(a.getAttribute('data-question-order') || '0', 10);
              const orderB = parseInt(b.getAttribute('data-question-order') || '0', 10);
              return orderA - orderB;
            });

            // Reanexa os itens ordenados ao container para refletir a ordem visual correta no DOM
            if (questionsList) {
              matchingItems.forEach(item => questionsList.appendChild(item));
            }

            // Exibe apenas as primeiras 5 questões
            const MAX_SIDEBAR_QUESTIONS = 5;
            let visibleQuestions = 0;

            matchingItems.forEach((item, index) => {
              if (index < MAX_SIDEBAR_QUESTIONS) {
                item.classList.remove('hidden');
                visibleQuestions++;
              } else {
                item.classList.add('hidden');
              }

              // Atualiza estilo se for a questão ativa na página
              const qId = item.getAttribute('data-question-id');
              const activeQId = currentQuestionId || detectedQuestionId;
              if (activeQId && qId === activeQId) {
                item.classList.add('bg-[var(--accent-subtle)]', 'border-[var(--accent)]/40', 'text-[var(--accent)]', 'font-semibold');
                item.classList.remove('text-[var(--text-secondary)]', 'border-transparent');
              } else {
                item.classList.remove('bg-[var(--accent-subtle)]', 'border-[var(--accent)]/40', 'text-[var(--accent)]', 'font-semibold');
                item.classList.add('text-[var(--text-secondary)]', 'border-transparent');
              }
            });

            if (visibleQuestions > 0) {
              questionsEmpty?.classList.add('hidden');
              questionsList?.classList.remove('hidden');
            } else {
              questionsEmpty?.classList.remove('hidden');
              questionsList?.classList.add('hidden');
            }
          }

          function selectStudyTag(tagSlug, updateUrl = true) {
            currentActiveTag = tagSlug;
            try {
              if (tagSlug) {
                localStorage.setItem(storageKey, tagSlug);
              } else {
                localStorage.removeItem(storageKey);
              }
            } catch(e) {}

            if (updateUrl && typeof window !== 'undefined') {
              const url = new URL(window.location.href);
              if (tagSlug) {
                url.searchParams.set('tag', tagSlug);
              } else {
                url.searchParams.delete('tag');
              }
              window.history.replaceState(null, '', url.toString());
            }

            updateSidebarUI(tagSlug);

            window.dispatchEvent(new CustomEvent('study-tag-changed', {
              detail: { tag: tagSlug, materia: materiaSlug }
            }));
          }

          window.selectStudyTag = selectStudyTag;
          window.getCurrentStudyTag = () => currentActiveTag;

          function initTags() {
            const trigger = document.getElementById('sidebar-tag-trigger');
            const menu = document.getElementById('sidebar-tag-menu');
            const chevron = document.getElementById('sidebar-tag-chevron');
            const labelBtn = document.getElementById('sidebar-tag-label-btn');

            function toggleMenu(show) {
              const willShow = show !== undefined ? show : menu?.classList.contains('hidden');
              if (willShow) {
                document.querySelectorAll('.theme-dropdown-menu').forEach((m) => m.classList.add('hidden'));
                menu?.classList.remove('hidden');
                trigger?.setAttribute('aria-expanded', 'true');
                chevron?.classList.add('rotate-180');
              } else {
                menu?.classList.add('hidden');
                trigger?.setAttribute('aria-expanded', 'false');
                chevron?.classList.remove('rotate-180');
              }
            }

            trigger?.addEventListener('click', (e) => {
              e.stopPropagation();
              toggleMenu();
            });

            labelBtn?.addEventListener('click', (e) => {
              e.stopPropagation();
              trigger?.focus();
              toggleMenu();
            });

            trigger?.addEventListener('keydown', (e) => {
              if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                toggleMenu(true);
                const activeOrFirst = (menu?.querySelector('.tag-opt-btn.font-semibold') || menu?.querySelector('.tag-opt-btn'));
                activeOrFirst?.focus();
              }
            });

            document.querySelectorAll('.tag-opt-btn').forEach((btn) => {
              btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const val = btn.getAttribute('data-tag-value') || '';
                toggleMenu(false);
                selectStudyTag(val || null);
              });

              btn.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowDown') {
                  e.preventDefault();
                  const next = btn.nextElementSibling;
                  if (next && next.classList.contains('tag-opt-btn')) next.focus();
                } else if (e.key === 'ArrowUp') {
                  e.preventDefault();
                  const prev = btn.previousElementSibling;
                  if (prev && prev.classList.contains('tag-opt-btn')) prev.focus();
                  else trigger?.focus();
                } else if (e.key === 'Escape') {
                  e.preventDefault();
                  toggleMenu(false);
                  trigger?.focus();
                }
              });
            });

            document.addEventListener('click', (e) => {
              const dropdownRoot = document.getElementById('sidebar-tag-custom-dropdown');
              if (dropdownRoot && !dropdownRoot.contains(e.target)) {
                toggleMenu(false);
              }
            });

            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape') {
                toggleMenu(false);
              }
            });

            const tagSelect = document.getElementById('sidebar-tag-select');
            tagSelect?.addEventListener('change', (e) => {
              const val = e.target.value;
              selectStudyTag(val || null);
            });

            function initCollapsibleTocGroups() {
              document.querySelectorAll('.toc-collapsible-btn').forEach((btn) => {
                btn.addEventListener('click', (e) => {
                  e.stopPropagation();
                  const targetGroup = btn.getAttribute('data-target-group');
                  const content = document.querySelector(`.toc-collapsible-content[data-group-content="${targetGroup}"]`);
                  const chevron = btn.querySelector('.toc-collapsible-chevron');
                  if (content) {
                    const isHidden = content.classList.contains('hidden');
                    if (isHidden) {
                      content.classList.remove('hidden');
                      chevron?.classList.remove('-rotate-90');
                      btn.setAttribute('aria-expanded', 'true');
                    } else {
                      content.classList.add('hidden');
                      chevron?.classList.add('-rotate-90');
                      btn.setAttribute('aria-expanded', 'false');
                    }
                  }
                });
              });
            }

            initCollapsibleTocGroups();

            const initialTag = getParamTag() || defaultInitialTag || getSavedTag() || null;
            selectStudyTag(initialTag, false);
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTags);
          } else {
            initTags();
          }
        })();
      </script>
    )}

    <!-- Script de Interação: Fechar/Abrir Menu Lateral (Desktop e Mobile), Drawer e Scrollspy -->
    <script is:inline>
      const sidebarToggle = document.getElementById('mobile-sidebar-toggle');
      const sidebar = document.getElementById('academic-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const mobileSectionEl = document.getElementById('mobile-current-section');
      const desktopOpenBtn = document.getElementById('desktop-sidebar-open-btn');
      const closeBtns = document.querySelectorAll('.sidebar-close-btn');

      function collapseDesktopSidebar() {
        document.documentElement.classList.add('sidebar-collapsed');
        localStorage.setItem('study_sidebar_collapsed', 'true');
      }

      function expandDesktopSidebar() {
        document.documentElement.classList.remove('sidebar-collapsed');
        localStorage.setItem('study_sidebar_collapsed', 'false');
      }

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        backdrop?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
      }

      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      }

      function handleCloseSidebar() {
        if (window.innerWidth >= 1024) {
          collapseDesktopSidebar();
        } else {
          closeSidebar();
        }
      }

      closeBtns.forEach((btn) => {
        btn.onclick = handleCloseSidebar;
      });

      if (desktopOpenBtn) {
        desktopOpenBtn.onclick = expandDesktopSidebar;
      }

      if (sidebarToggle) {
        sidebarToggle.onclick = openSidebar;
      }

      if (backdrop) {
        backdrop.onclick = closeSidebar;
      }

      sidebar?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 1024) closeSidebar();
        });
      });

      // Rolagem Adaptativa Inteligente para Âncoras do Documento e Sumário:
      // Se estiver na página principal, faz a rolagem adaptativa instantânea ou suave.
      // Se estiver em uma questão, permite que o navegador navegue diretamente para a seção correspondente no caderno de resumos.
      document.querySelectorAll('.toc-item, a[href*="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;

          const hashIdx = href.indexOf('#');
          if (hashIdx === -1) return;

          const targetId = href.slice(hashIdx + 1);
          if (!targetId) return;

          const targetEl = document.getElementById(targetId);
          // Se o elemento alvo NÃO existe na página atual (ex: estamos na página de uma questão e clicamos no capítulo de teoria):
          // NÃO chamamos preventDefault() para que o navegador navegue para o caderno de resumos com o hash!
          if (!targetEl) {
            const isMobile = window.innerWidth < 1024;
            if (isMobile) {
              closeSidebar();
            }
            return;
          }

          // Se o elemento existe na página atual:
          e.preventDefault();

          const isMobile = window.innerWidth < 1024;
          if (isMobile) {
            closeSidebar();
          }

          const headerOffset = isMobile ? 70 : 35;
          const currentScroll = window.scrollY;
          const targetPos = Math.max(0, targetEl.getBoundingClientRect().top + window.scrollY - headerOffset);
          const distance = Math.abs(targetPos - currentScroll);

          // Limite adaptativo de distância: mais de 2 telas inteiras de distância é considerado muito longe
          const isFar = distance > (window.innerHeight * 2);

          if (isFar) {
            // Salto instantâneo sem rolagem excessiva
            window.scrollTo({ top: targetPos, behavior: 'auto' });
          } else {
            // Para distâncias curtas, mantém rolagem suave agradável
            window.scrollTo({ top: targetPos, behavior: 'smooth' });
          }

          // Atualiza o hash na URL
          if (history.pushState) {
            history.pushState(null, '', `#${targetId}`);
          }

          // Atualiza a posição de estudo no localStorage
          if (window._saveCurrentStudyPosition) {
            window._saveCurrentStudyPosition(anchor.textContent?.trim(), `#${targetId}`);
          }
        });
      });

      // Se a página carregar com âncora na URL (ex: navegou de uma questão direto para uma seção da teoria):
      // Pousa instantaneamente sem animação de rolagem desde o topo
      if (window.location.hash) {
        document.documentElement.style.scrollBehavior = 'auto';
        const initialHashId = window.location.hash.slice(1);
        const scrollToTarget = () => {
          const initialHashEl = document.getElementById(initialHashId);
          if (initialHashEl) {
            const isMobile = window.innerWidth < 1024;
            const headerOffset = isMobile ? 70 : 35;
            const targetPos = Math.max(0, initialHashEl.getBoundingClientRect().top + window.scrollY - headerOffset);
            window.scrollTo({ top: targetPos, behavior: 'instant' });
          }
        };
        scrollToTarget();
        requestAnimationFrame(scrollToTarget);
      }

      // 1. Validação de Gestos Touch no Celular:
      // Impede abertura acidental durante rolagem vertical ou horizontal de tabelas, equações e blocos
      function isInsideScrollable(el) {
        if (!el || !(el instanceof Element)) return false;

        // Elementos acadêmicos conhecidos com scroll próprio (tabelas, fórmulas KaTeX, código, diagramas)
        if (el.closest('.academic-table-wrapper, table, .katex-display, .katex, pre, code, .diagram-viewport, .diagram-card, .diagram-modal, .code-block-card, [data-scrollable], .overflow-x-auto, .overflow-y-auto, [style*="overflow"]')) {
          return true;
        }

        // Verificação de qualquer container antecessor com overflow scroll ou auto
        let curr = el;
        while (curr && curr !== document.body && curr !== document.documentElement) {
          const style = window.getComputedStyle(curr);
          const ox = style.overflowX;
          const oy = style.overflowY;

          if (['auto', 'scroll'].includes(ox) && curr.scrollWidth > curr.clientWidth + 4) {
            return true;
          }
          if (['auto', 'scroll'].includes(oy) && curr.scrollHeight > curr.clientHeight + 4) {
            return true;
          }
          curr = curr.parentElement;
        }
        return false;
      }

      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartTime = 0;
      let touchStartInsideScrollable = false;

      window.addEventListener('touchstart', (e) => {
        if (window.innerWidth >= 1024) return;
        const t = e.touches[0];
        touchStartX = t.clientX;
        touchStartY = t.clientY;
        touchStartTime = Date.now();
        touchStartInsideScrollable = isInsideScrollable(e.target);
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        if (window.innerWidth >= 1024) return;
        const t = e.changedTouches[0];
        const deltaX = t.clientX - touchStartX;
        const deltaY = t.clientY - touchStartY;
        const elapsed = Date.now() - touchStartTime;

        // Regra 1: Se o toque começou em tabela, fórmula KaTeX ou elemento rolável, nunca abre o menu
        if (touchStartInsideScrollable) return;

        // Regra 2: Bloqueia se for rolagem vertical ou gesto impreciso/lento
        // O movimento deve ser predominantemente horizontal (> 2.2x vertical) com deltaY <= 30px
        if (Math.abs(deltaY) > 30 || Math.abs(deltaX) < Math.abs(deltaY) * 2.2 || elapsed > 450) {
          return;
        }

        const isClosed = sidebar?.classList.contains('-translate-x-full');

        // Regra 3: Para ABRIR, exige "Edge Swipe" estrito iniciado na margem esquerda da tela (até 28px)
        const isEdgeSwipe = touchStartX <= Math.min(28, window.innerWidth * 0.08);

        if (isClosed && deltaX > 45 && isEdgeSwipe) {
          openSidebar();
        }
        // Regra 4: Para FECHAR com o menu aberto, deslizar para a esquerda
        else if (!isClosed && deltaX < -45) {
          closeSidebar();
        }
      }, { passive: true });

      // 2. Scrollspy: Rastreia a seção atual na tela e atualiza o cabeçalho mobile e menu lateral
      const tocItems = Array.from(document.querySelectorAll('.toc-item'));
      if (tocItems.length > 0) {
        const sections = tocItems
          .map((item) => {
            const id = item.getAttribute('data-toc-id');
            const el = id ? document.getElementById(id) : null;
            return {
              id,
              el,
              title: item.getAttribute('data-toc-title') || '',
              parentId: item.getAttribute('data-parent-id'),
              itemEl: item,
            };
          })
          .filter((s) => Boolean(s.el));

        let currentActiveId = null;

        function updateActiveSection() {
          const scrollPos = window.scrollY + 140;
          let activeSection = sections[0];

          for (let i = 0; i < sections.length; i++) {
            const sec = sections[i];
            const rect = sec.el.getBoundingClientRect();
            const top = rect.top + window.scrollY;

            if (top <= scrollPos) {
              activeSection = sec;
            } else {
              break;
            }
          }

          if (activeSection && activeSection.id !== currentActiveId) {
            currentActiveId = activeSection.id;

            // Atualiza o título no cabeçalho sticky do celular
            if (mobileSectionEl && activeSection.title) {
              mobileSectionEl.textContent = activeSection.title;
            }

            // Atualiza indicação visual da seção ativa no menu lateral
            tocItems.forEach((item) => {
              const id = item.getAttribute('data-toc-id');
              if (id === activeSection.id) {
                item.classList.add('is-active');
              } else {
                item.classList.remove('is-active');
              }
            });

            // Se for subseção, destaca também o capítulo pai sutilmente
            document.querySelectorAll('.toc-chapter-link').forEach((chapLink) => {
              const chapId = chapLink.getAttribute('data-toc-id');
              if (chapId === activeSection.parentId) {
                chapLink.classList.add('is-parent-active');
              } else {
                chapLink.classList.remove('is-parent-active');
              }
            });

            // Atualiza a posição de estudo no localStorage em tempo real conforme a leitura avança
            if (window._saveCurrentStudyPosition) {
              window._saveCurrentStudyPosition(activeSection.title, '#' + activeSection.id);
            }
          }
        }

        let scrollThrottle = null;
        window.addEventListener('scroll', () => {
          if (!scrollThrottle) {
            scrollThrottle = requestAnimationFrame(() => {
              updateActiveSection();
              scrollThrottle = null;
            });
          }
        }, { passive: true });

        // Execução inicial
        updateActiveSection();
      }
    </script>

    <!-- Otimizadores Ergonômicos: Tabelas, Código, Diagramas e Sequências de Questões -->
    <script>
      import { initTableOptimizer } from '../scripts/tableOptimizer';
      import { initDiagrams } from '../scripts/diagramManager';
      import { initCodeBlocks } from '../scripts/codeBlocks';
      import { initQuestionSequences } from '../scripts/questionSequenceManager';

      function setupOptimizers() {
        initTableOptimizer();
        initCodeBlocks();
        initDiagrams();
        initQuestionSequences();
      }

      setupOptimizers();
      document.addEventListener('astro:page-load', setupOptimizers);

      // Atualiza blocos se houver mudança de tema dinâmico
      const themeObserver = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
            initDiagrams();
          }
        }
      });
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    </script>

    <style is:global>
      @media (min-width: 1024px) {
        html.sidebar-collapsed #academic-sidebar {
          transform: translateX(-100%) !important;
        }
        html.sidebar-collapsed #main-content-area {
          padding-left: 0 !important;
        }
        html.sidebar-collapsed #desktop-sidebar-open-btn {
          display: flex !important;
        }
      }
    </style>
  </body>
</html>
