# ============================================================
# Configuração do Administrador Inicial
# (Utilizado apenas na primeira inicialização para criar o usuário admin)
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Administrador

# ============================================================
# Configuração do Servidor e Rede
# ============================================================
HOST=0.0.0.0
PORT=3000
SITE_URL=https://localhost

# ============================================================
# Sessão e Segurança
# ============================================================
SESSION_SECRET=chave_secreta_aleatoria_gerar_para_producao
SESSION_MAX_AGE_DAYS=7

# ============================================================
# Limites de Upload (em Megabytes)
# ============================================================
MAX_UPLOAD_MB_NORMAL=50
MAX_UPLOAD_MB_ADMIN=100

# ============================================================
# Logs e Retenção
# ============================================================
LOG_RETENTION_DAYS=90

# ============================================================
# Rate Limiting (Proteção contra força bruta no login)
# ============================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ============================================================
# Diretório de Armazenamento de Dados (SQLite e Archives)
# ============================================================
# Caminhos relativos partem da raiz do repositório (no servidor, de APP_ROOT=/opt/study-site).
# Atenção: na versão Astro partiam de site/ (DATA_DIR=../data); agora o equivalente é ./data.
DATA_DIR=./data

# Opcional: o próprio servidor Node serve o SPA compilado (sem Caddy). Ex.: apps/web/dist
# WEB_DIST_DIR=apps/web/dist

# Archive local: fora de produção (NODE_ENV != production), o archive/ gerado pelas skills é
# exibido na conta do admin no lugar de data/archives/1 (upload/download/sync ficam bloqueados
# para ele). ENABLE_LOCAL_ARCHIVE=false desliga; =true liga mesmo em produção.
# ENABLE_LOCAL_ARCHIVE=false
# LOCAL_ARCHIVE_DIR=archive
# LOCAL_ARCHIVE_USER_ID=1

# ============================================================
# Sincronização do Archive (Cliente -> Servidor VPS)
# ============================================================
# URL base do servidor onde o site está publicado
SYNC_SITE_URL=https://meu-vps.com
# Credenciais do usuário cadastrado no site
SYNC_USERNAME=admin
SYNC_PASSWORD=minhasenhasecreta
# Ignorar verificação SSL se o servidor usar certificado autoassinado (true/false)
SYNC_INSECURE=false
# Diretório local do archive (opcional, padrão: archive/)
# SYNC_LOCAL_ARCHIVE_DIR=archive

# ============================================================
# Cache de Capítulos Renderizados (no navegador)
# ============================================================
# Tempo de vida (TTL) do cache persistente de capítulos no cliente (em minutos)
# Padrão: 1440 minutos (24 horas)
CLIENT_CACHE_TTL_MINUTES=1440

# Limite máximo de capítulos mantidos em cache no cliente (estratégia LRU)
# Padrão: 50 capítulos
CLIENT_CACHE_MAX_ENTRIES=50


# ============================================================
# Deploy (lido só pelo activate.sh no servidor)
# ============================================================
# Releases mantidos em releases/, contando o ativo (mínimo 1; com 1 não há rollback rápido)
DEPLOY_KEEP_RELEASES=5
# Backups do banco mantidos em backups/ (um por deploy; mínimo 1)
DEPLOY_KEEP_BACKUPS=10
