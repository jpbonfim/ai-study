# ============================================================
# Configuração do Administrador Inicial
# (Utilizado apenas na primeira inicialização para criar o usuário admin)
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Administrador

# ============================================================
# Configuração do Servidor e Rede
# ============================================================
HOST=0.0.0.0
PORT=3000
SITE_URL=https://localhost

# ============================================================
# Sessão e Segurança
# ============================================================
SESSION_SECRET=chave_secreta_aleatoria_gerar_para_producao
SESSION_MAX_AGE_DAYS=7

# ============================================================
# Limites de Upload (em Megabytes)
# ============================================================
MAX_UPLOAD_MB_NORMAL=50
MAX_UPLOAD_MB_ADMIN=100

# ============================================================
# Logs e Retenção
# ============================================================
LOG_RETENTION_DAYS=90

# ============================================================
# Rate Limiting (Proteção contra força bruta no login)
# ============================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ============================================================
# Diretório de Armazenamento de Dados (SQLite e Archives)
# ============================================================
DATA_DIR=../data

# ============================================================
# Sincronização do Archive (Cliente -> Servidor VPS)
# ============================================================
# URL base do servidor onde o site está publicado
SYNC_SITE_URL=https://meu-vps.com
# Credenciais do usuário cadastrado no site
SYNC_USERNAME=admin
SYNC_PASSWORD=minhasenhasecreta
# Ignorar verificação SSL se o servidor usar certificado autoassinado (true/false)
SYNC_INSECURE=false
# Diretório local do archive (opcional, padrão: archive/)
# SYNC_LOCAL_ARCHIVE_DIR=archive

