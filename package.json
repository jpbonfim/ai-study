{
  "name": "ai-study",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ai-study/server & npm run dev --workspace @ai-study/web",
    "build": "npm run build --workspace @ai-study/content && npm run build --workspace @ai-study/web && npm run build --workspace @ai-study/server",
    "start": "npm run start --workspace @ai-study/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:parity": "vitest run --config tests/parity/vitest.config.ts",
    "validate:archive": "tsx packages/content/scripts/validate-archive.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "13.0.3",
    "jsdom": "^30.1.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
