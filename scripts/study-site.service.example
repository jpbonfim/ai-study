[Unit]
Description=Biblioteca de Estudos Acadêmicos (Astro SSR Node.js)
After=network.target

[Service]
Type=simple
User=study
Group=study
WorkingDirectory=/opt/study-site/site
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=3s
EnvironmentFile=/opt/study-site/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1

# Restrições de Segurança do Processo
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
