# ============================================================
# Caddyfile de Exemplo para a Biblioteca de Estudos Acadêmicos
# ============================================================
#
# O Caddy serve o SPA compilado (arquivos estáticos do release ativo) e encaminha só a API para
# o processo Node.js — assim o Node não gasta CPU/memória com arquivos estáticos.
#
# Troque 203.0.113.10 abaixo pelo endereço de acesso:
#
# Modo 1: Acesso direto por IP (ex: "45.0.0.1") com HTTPS autoassinado (tls internal).
# O endereço precisa ser o IP explícito: com ":443" o Caddy não sabe para qual nome emitir o
# certificado (o navegador não manda SNI para IPs) e o handshake falha com ERR_SSL_PROTOCOL_ERROR.
# No primeiro acesso pelo navegador, aceite o aviso de segurança do certificado autoassinado.
#
# Modo 2: Acesso por Domínio
# Use o domínio (ex: "estudos.exemplo.com") e apague a linha "tls internal".
# O Caddy obterá certificado Let's Encrypt gratuito automaticamente.
# ============================================================

203.0.113.10 {
    # Habilita certificado TLS interno gerado pelo Caddy para acesso por IP
    tls internal

    encode zstd gzip

    # API: proxy reverso para o processo Node.js na porta 3000
    @api path /api/* /admin/api/*
    handle @api {
        reverse_proxy 127.0.0.1:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            # Sobrescreve (não acrescenta) para o cliente não forjar o próprio IP
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # SPA: arquivos do release ativo ("app" aponta para releases/<id>/)
    handle {
        root * /opt/study-site/app/web

        # Arquivos em /assets têm hash no nome: nunca mudam
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @pages not path /assets/*
        header @pages Cache-Control "no-cache"

        # Rotas do app (/pds, /conta, ...) caem no index.html
        try_files {path} /index.html
        file_server
    }

    # Cabeçalhos de Segurança HTTP
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Logs de Acesso
    log {
        output file /var/log/caddy/study_access.log {
            roll_size 20mb
            roll_keep 5
        }
    }
}

